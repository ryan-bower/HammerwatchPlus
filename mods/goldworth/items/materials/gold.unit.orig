<unit slot="item">
	<behavior class="Material::MaterialPickup">
		<string name="type">gold</string>
		<string name="pickup-trigger">pickup-gold</string>
		<array name="sets">
			<i>1</i><s>1g</s>
			<i>2</i><s>several</s>
			<i>10</i><s>10g</s>
			<i>50</i><s>50g</s>
			<i>250</i><s>250g</s>
		</array>
	</behavior>
	<scenes several="2g 3g 4g 5g" >
		<scene name="shared">
			<scene src="special/minimap.unit:gold"/>
			<collision static="true">
				<circle offset="-2 0" sensor="true" radius="18" />
			</collision>
		</scene>
		
		<scene name="1g" random-start="true">
			<scene src="shared"/>
			<effect pos="-1 0" ulayer="1" src="../gold_reflection.effect?a=0.5"/>
			<sprite origin="8 8" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
		</scene>
		<scene name="2g" random-start="true">
			<scene src="shared"/>
			<effect pos="0 -1" ulayer="1" src="../gold_reflection.effect?a=0.5"/>
			<sprite origin="8 8" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
			<sprite origin="5 5" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
		</scene>
		<scene name="3g" random-start="true">
			<scene src="shared"/>
			<effect pos="0 -1" ulayer="1" src="../gold_reflection.effect?a=0.5"/>
			<sprite origin="8 8" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
			<sprite origin="5 5" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>			
			<sprite origin="11 9" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
		</scene>
		<scene name="4g" random-start="true">
			<scene src="shared"/>
			<effect pos="0 -1" ulayer="1" src="../gold_reflection.effect?a=0.5"/>
			<sprite origin="8 8" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
			<sprite origin="5 5" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
			<sprite origin="11 7" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
			<sprite origin="7 4" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
		</scene>
		<scene name="5g" random-start="true">
			<scene src="shared"/>
			<effect pos="0 -1" ulayer="1" src="../gold_reflection.effect?a=0.5"/>
			<sprite origin="8 8" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
			<sprite origin="6 6" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
			<sprite origin="9 10" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
			<sprite origin="7 5" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>		
			<sprite origin="5 7" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">48 112 16 16</frame>
			</sprite>
		</scene>
		<scene name="10g" random-start="true">
			<scene src="shared"/>
			<effect pos="-1 0" ulayer="1" src="../gold_reflection.effect?a=0.75"/>
			<sprite origin="8 8" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">64 112 16 16</frame>
			</sprite>
		</scene>		
		<scene name="50g" random-start="true">
			<scene src="shared"/>
			<effect pos="-1 0" ulayer="1" src="../gold_reflection.effect?a=0.75"/>
			<sprite origin="8 8" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">96 112 16 16</frame>
			</sprite>
		</scene>
		<scene name="250g" random-start="true">
			<scene src="shared"/>
			<effect pos="5 0" ulayer="3" src="../gold_reflection.effect"/>
			<effect pos="-3 -4" ulayer="3" delay="1000" src="../gold_reflection.effect"/>
			<sprite origin="8 8" texture="../misc/base.png" material="items/items.mats:item_gold">
				<frame time="80">112 112 16 16</frame>
			</sprite>
		</scene>
	</scenes>
</unit>