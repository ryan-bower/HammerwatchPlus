<gui>
	<doc>
		<!-- under the region banner (announcestyles region_enter sits at offset 0 40); HWPObjectivesHUD
		     fills the lines and hides the group when the floor has no objective -->
		<group id="root" anchor="0.5 0" offset="0 72" width="320" height="30">
			<text id="hwp-objective" text="" color="#ffd27a" font="text" align="center" anchor="0.5 0" offset="0 0" width="320" />
			<text id="hwp-objective-vaults" text="" color="#c8d8ff" font="text" align="center" anchor="0.5 0" offset="0 14" width="320" />
		</group>
	</doc>
</gui>
