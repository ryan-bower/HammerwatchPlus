// Forsaken Tower campaign. The mission itself is data
// (tweak/hwp/missions/missions_hwp_forsaken_tower.sval, set hwp_campaign); this
// module spawns the town portal (doodads/hwp/forsaken_portal.unit) on the host
// in place of the chapel courtyard's campfire, self-checks the data and answers
// hwp campaign. The portal offers the HoH1 levels first (PortalShop.as), the Dark
// Citadel gets its second Dark Halls floor and the two Battlements floors
// (Citadel.as), every indoor floor gets HoH1 traps and a teleporter (Traps.as,
// Teleporters.as) and the eyes confuse again (Confusion.as).
namespace HWP
{
	namespace Campaign
	{
		const string MISSION_ID = "hwp_forsaken_tower";
		// optional: generated by tools/import_hoh1.py campaign from the player's HoH1 install
		const string HOH1_MISSION_ID = "hwp_forsaken_tower_hoh1";
		const string PORTAL_UNIT = "doodads/hwp/forsaken_portal.unit";
		const array<string> SCHEMES = { "bandits_1", "bandits_2", "bats_black_1", "bats_white_1", "beetles_black_1", "beetles_black_burrow", "cult_2", "cult_3", "goblins_2", "goblins_3", "tower_barracks_1", "tower_courts_1", "tower_crypt_1", "trolls_1", "trolls_2", "undead_court_1", "undead_court_2", "undead_guard_1", "undead_guard_2", "undead_horde_1" };
		// every third floor is a boss floor, in act order
		const array<string> BOSS_LEVELS = { "levels/boss_totem_cave.lvl", "levels/boss_arista.lvl", "levels/boss_harbingers.lvl", "levels/boss_wraith.lvl", "levels/boss_bone_serpent.lvl", "levels/boss_avatar.lvl" };
		const int FLOORS_PER_ACT = 3;
		const int FLOORS = 18;
		// HoH1's tower (its tweak/dungeons/base.sval): 14 generated floors in five acts, the act
		// bosses, the Battlements, the bridge and the dragon
		const int HOH1_FLOORS = 23;

		// The portal stands in the chapel courtyard on the unbuilt Pyre
		// (HWP::Town::ChapelPyreSpot). The campfire is a static in vanilla,
		// which no scene query returns, so our copy of pyre_tier_0.pfb places
		// it as a unit we can hide.
		const string CAMPFIRE_UNIT = "doodads/generic/campfire.unit";
		const float MATCH = 12.0f;
		// a built Pyre is a real building (shadow curses): the portal stands below it
		const vec2 BELOW_PYRE = vec2(0, 72);

		bool g_enabled = true;
		bool g_checked = false;
		HWP::Town::Placeable@ g_portal;
		UnitPtr g_campfire;  // hidden while the portal stands on it (local, every machine)

		void ShowCampfire()
		{
			if (g_campfire.IsValid() && !g_campfire.IsDestroyed())
				g_campfire.SetHidden(false);
			g_campfire = UnitPtr();
		}

		// HWP::Town::PlaceableLocate: the unbuilt Pyre's campfire (hidden while
		// the portal has no saved spot) or the spot below the built Pyre
		bool LocatePortal(vec3 &out pos)
		{
			ShowCampfire();
			vec2 spot;
			if (!HWP::Town::ChapelPyreSpot(spot))
			{
				HWP::LogError("campaign", "chapel pyre slot not found in the town layout, portal at the default spot");
				return false;
			}
			auto prod = Resources::GetUnitProducer(CAMPFIRE_UNIT);
			array<UnitPtr>@ fires = null;
			if (prod !is null)
				@fires = g_scene.FetchUnitsOfType(prod, spot, int(MATCH));
			if (fires !is null && fires.length() > 0)
			{
				pos = fires[0].GetPosition();
				if (!g_portal.Custom())
				{
					fires[0].SetHidden(true);
					g_campfire = fires[0];
				}
				HWP::Log("campaign", "portal spot: the chapel campfire at " + int(pos.x) + "," + int(pos.y));
				return true;
			}
			pos = xyz(spot + BELOW_PYRE);
			HWP::Log("campaign", "portal spot: below the chapel pyre at " + int(pos.x) + "," + int(pos.y));
			return true;
		}

		// HWP::Town::PlaceableStale: a rebuild brings a fresh campfire back
		bool PortalStale()
		{
			return g_campfire.IsValid() && g_campfire.IsDestroyed();
		}

		// campaign.enabled (the settings page's switch). Off: the town portal is not placed
		// on the next town load, generated floors get no traps or teleporter, pads already
		// placed do nothing and nothing confuses. A run of the tower already under way plays
		// on (its floors are data), and the Dark Citadel's floor list (Citadel::Fix) stays as
		// it is: changing it under a run would move its floors.
		void RefreshSettings()
		{
			g_enabled = HWP::Settings::GetBool("campaign.enabled", true);
			Confusion::RefreshSettings();
			Traps::RefreshSettings();
			Teleporters::RefreshSettings();
		}

		void OnSettingChanged(const string &in key)
		{
			if (key.findFirst("campaign.") == 0)
				RefreshSettings();
			// moved away ('here') or back ('reset'): show or hide the campfire
			if (key == "campaign.portal_y" && g_inTown && g_portal !is null && g_portal.m_spawnDone)
			{
				vec3 p;
				LocatePortal(p);
			}
		}

		MissionDef@ Find()
		{
			return MissionDef::Get(HashString(MISSION_ID));
		}

		// Missions load with the tweak data; checked once per gameplay load.
		void SelfCheck()
		{
			if (g_checked)
				return;
			g_checked = true;
			auto def = Find();
			if (def is null)
				HWP::LogError("campaign", "mission " + MISSION_ID + " not registered (tweak/hwp/missions/)");
			else if (int(def.m_levels.length()) != FLOORS)
				HWP::LogError("campaign", "mission has " + def.m_levels.length() + " levels, expected " + FLOORS);
			else
			{
				for (uint i = 0; i < BOSS_LEVELS.length(); i++)
				{
					uint floor = i * FLOORS_PER_ACT + FLOORS_PER_ACT - 1;
					if (def.m_levels[floor].m_level != BOSS_LEVELS[i])
						HWP::LogError("campaign", "floor " + (floor + 1) + " is " + def.m_levels[floor].m_level + ", expected " + BOSS_LEVELS[i]);
				}
			}
			int schemes = 0;
			for (uint i = 0; i < SCHEMES.length(); i++)
			{
				if (EnemyPlacementScheme::Get("actors/enemies.sval:" + SCHEMES[i]) !is null)
					schemes++;
				else
					HWP::LogError("campaign", "missing enemy scheme " + SCHEMES[i]);
			}
			auto hoh1 = MissionDef::Get(HashString(HOH1_MISSION_ID));
			HWP::HoH1::Report("campaign", hoh1 !is null, ".hwp.campaign.hoh1");
			if (hoh1 !is null && int(hoh1.m_levels.length()) != HOH1_FLOORS)
				HWP::LogError("campaign", "HoH1 mission has " + hoh1.m_levels.length() + " levels, expected " + HOH1_FLOORS);
			if (hoh1 !is null)
			{
				// every floor's level file must be the import's (hoh1/levels/...) or a generated one
				string bad;
				for (uint i = 0; i < hoh1.m_levels.length(); i++)
				{
					string lvl = hoh1.m_levels[i].m_level;
					if (lvl.findFirst("hoh1/") != 0 && lvl != "levels/generated.lvl")
						bad += (bad.isEmpty() ? "" : ", ") + hoh1.m_levels[i].m_id + "=" + lvl;
				}
				if (!bad.isEmpty())
					HWP::LogError("campaign", "HoH1 mission floors not from the import: " + bad);
			}
			int trapDefs = int(MissionPrefabDef::GetPossiblePrefabs(HashString(Traps::SET)).length());
			if (trapDefs == 0)
				HWP::LogError("campaign", "no prefab in set " + Traps::SET + " (" + Traps::DEFS + " not loaded?)");
			HWP::Log("campaign", "self-check done: mission " + (def is null ? "missing" : "ok") + ", " + schemes + "/" + SCHEMES.length() + " schemes, HoH1 floors " + (hoh1 is null ? "not imported" : "installed") + ", " + trapDefs + " trap prefabs, traps on " + Traps::g_installed + " floors; " + Citadel::g_summary);
		}

		void CmdCampaign(array<string>@ args)
		{
			if (args.length() >= 1 && args[0] == "here")
			{
				g_portal.MoveHere();
				return;
			}
			if (args.length() >= 1 && args[0] == "reset")
			{
				g_portal.Reset();
				return;
			}
			if (args.length() >= 1 && args[0] == "citadel")
			{
				// index:id of every Dark Citadel floor from the first Dark Halls on, as
				// gl mission dark_citadel <index> wants it
				HWP::Commands::Reply(Resources::GetString(".hwp.campaign.citadel", { { "floors", Citadel::Fix() } }));
				return;
			}
			if (args.length() >= 1 && args[0] == "traps")
			{
				Traps::RefreshSettings();
				Teleporters::RefreshSettings();
				HWP::Commands::Reply("traps " + (Traps::g_enabled ? "on" : "off") + ", density " + Traps::g_density + "%, " + MissionPrefabDef::GetPossiblePrefabs(HashString(Traps::SET)).length() + " prefabs, generator command on " + Traps::g_installed + " indoor floors; teleporters " + (Teleporters::g_enabled ? "on" : "off") + ", " + Teleporters::g_links.length() + " link(s) this floor; confusion " + (Confusion::g_enabled ? "on" : "off") + ", eye chance " + Confusion::g_eyeChance + "%");
				return;
			}
			if (args.length() >= 1 && args[0] == "confuse")
			{
				Confusion::Cheat(args);
				return;
			}
			if (args.length() >= 1 && args[0] == "teleporter")
			{
				Teleporters::Cheat(args);
				return;
			}
			auto rec = GetLocalPlayerRecord();
			auto def = Find();
			auto pos = g_portal.Pos();
			if (def is null)
			{
				HWP::Commands::Reply(Resources::GetString(".hwp.campaign.missing"));
				return;
			}
			bool ok = rec !is null && CheckConditionals(def.m_conditionals, rec);
			auto span = def.GetLevelSpan();
			HWP::Commands::Reply(Resources::GetString(".hwp.campaign.status", {
				{ "state", g_enabled ? "on" : "off" }, { "found", Resources::GetString(def.m_name) },
				{ "floors", int(def.m_levels.length()) }, { "span", "" + span.x + "-" + span.y },
				{ "flag", ok ? "" : Resources::GetString(".hwp.campaign.locked") },
				{ "x", int(pos.x) }, { "y", int(pos.y) } }));
		}
	}
}

namespace Modules
{
	class HWPCampaignModule : Module, HWP::ModuleStart
	{
		HWPCampaignModule()
		{
			super("hwp-campaign");
			HWP::Settings::Sync("campaign.");
			HWP::Campaign::RefreshSettings();
			HWP::Campaign::Citadel::Fix();      // before Traps::Install: the new floor gets the command too
			HWP::Campaign::Traps::Install();
			@HWP::Campaign::g_portal = HWP::Town::Placeable("campaign", "campaign.portal", HWP::Campaign::PORTAL_UNIT, -1700, 250);
			@HWP::Campaign::g_portal.m_locate = HWP::Town::PlaceableLocate(HWP::Campaign::LocatePortal);
			@HWP::Campaign::g_portal.m_stale = HWP::Town::PlaceableStale(HWP::Campaign::PortalStale);
			HWP::Commands::OnSettingChanged(HWP::Commands::SettingListener(HWP::Campaign::OnSettingChanged));
			HWP::Commands::Register("campaign", " Forsaken Tower status; 'here' moves the town portal (host), 'reset' puts it back on the chapel campfire; 'citadel' the Dark Citadel floors; 'traps' the trap/teleporter/confusion state; cheats: 'confuse [ms]', 'teleporter [dx dy]'", HWP::Commands::Handler(HWP::Campaign::CmdCampaign));
			array<string> units = { HWP::Campaign::PORTAL_UNIT };
			for (uint i = 0; i < HWP::Campaign::Traps::UNITS.length(); i++)
				units.insertLast(HWP::Campaign::Traps::UNITS[i]);
			HWP::CheckUnits("campaign", units);
			HWP::HoH1::RegisterNet();       // boss sync for the HoH1 levels (hoh1.* events)
		}

		void Start(StartMode sMode)
		{
			HWP::Campaign::RefreshSettings();
			HWP::Campaign::g_checked = false;
			HWP::Campaign::SelfCheck();
			HWP::Campaign::g_portal.OnLoad();
			HWP::HoH1::ApplyUnitMap();     // again on the first frame, in case the scene was not up yet
			m_tiered = false;
		}

		bool m_tiered;          // this level's HoH1 spawn units are on their NG+ tier

		// the town starts with a null save, so Load never runs there (docs/RE_NOTES.md,
		// mod lifecycle): run the check on the first gameplay frame as well
		// HWP::Guard (tools/guard_modules.py): a script error here turns this off, not the game
		HWP::Guard m_guardUpdateFrame;
		void UpdateFrame(int ms, GameInput& gameInput, MenuInput& menuInput, bool paused) override
		{
			if (m_guardUpdateFrame.Skip("campaign", "HWPCampaignModule.UpdateFrame"))
				return;
			if (m_guardUpdateFrame.Raw())
			{
				GuardedUpdateFrame(ms, gameInput, menuInput, paused);
				m_guardUpdateFrame.Ok();
				return;
			}
			try { GuardedUpdateFrame(ms, gameInput, menuInput, paused); m_guardUpdateFrame.Ok(); }
			catch { m_guardUpdateFrame.Failed(); }
		}

		void GuardedUpdateFrame(int ms, GameInput& gameInput, MenuInput& menuInput, bool paused)
		{
			HWP::Campaign::SelfCheck();
			if (!m_tiered)
			{
				m_tiered = true;
				HWP::HoH1::ApplyUnitMap();
			}
			HWP::Campaign::g_portal.Update(ms, HWP::Campaign::g_enabled);
		}
	}
}
