<!-- HoH1's confusion glyph: a player within 20 px lights it, a second later it bursts and everyone in 40 px is confused for 1 s (hwp_trap_confusion: movement and aim reversed); back after 6 s.
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="0">
	<behavior class="HWPTrap">
		<string name="trigger">near</string>
		<int name="sense">20</int>
		<int name="warn">1000</int>
		<int name="on">300</int>
		<int name="rearm">6000</int>
		<bool name="once">true</bool>
		<int name="radius">40</int>
		<int name="freq">0</int>
		<int name="actor-filter">6</int>
		<string name="warn-snd">event:/sfx/doodads/buttons/button_magic</string>
		<string name="setting">campaign.confusion</string>
		<string name="on-fx">effects/generic/explosions/arcane_explosion_1.effect</string>
		<array name="effects">
			<dict><string name="class">ApplyBuff</string><string name="buff">tweak/hwp/campaign_buffs.sval:hwp_trap_confusion</string></dict>
		</array>
	</behavior>
	<scenes>
		<scene name="off">
			<effect src="effects/generic/other/arcane/glyph_idle.effect"/>
		</scene>
		<scene name="warn">
			<effect src="effects/generic/other/arcane/glyph_active.effect"/>
			<effect src="effects/generic/other/area_warning_xray_1000.effect?radius=40"/>
		</scene>
		<scene name="on">
			<effect src="effects/generic/other/arcane/glyph_active.effect"/>
		</scene>
	</scenes>
</unit>
