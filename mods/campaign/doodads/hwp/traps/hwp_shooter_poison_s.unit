<!-- HoH1's poison shooter on a wall, facing s: with a player within 200 px it fires HoH2's trap projectile (arrow_poison.unit) every 2 s.
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="0">
	<behavior class="HWPTrap">
		<string name="trigger">near</string>
		<int name="sense">200</int>
		<int name="warn">0</int>
		<int name="on">100</int>
		<int name="rearm">2000</int>
		<int name="freq">0</int>
		<int name="radius">1</int>
		<string name="shoot">doodads/traps/projectiles/arrow_poison.unit</string>
		<int name="dir">90</int>
		<int name="muzzle">4</int>
		<int name="muzzle-y">0</int>
		<array name="effects">
		</array>
	</behavior>
	<scenes>
		<scene name="off">
			<scene src="doodads/traps/shooters/shooter_wall.unit:s"/>
		</scene>
		<scene name="on">
			<scene src="doodads/traps/shooters/shooter_wall.unit:s"/>
		</scene>
	</scenes>
</unit>
