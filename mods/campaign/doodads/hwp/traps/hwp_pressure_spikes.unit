<!-- HoH1's pressure spikes: stepping on the plate clicks, half a second later the spikes come up for 1.2 s (20% of current health every 0.5 s); 1.5 s to re-arm.
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="-20">
	<behavior class="HWPTrap">
		<string name="trigger">near</string>
		<int name="sense">12</int>
		<int name="warn">500</int>
		<int name="on">1200</int>
		<int name="rearm">1500</int>
		<int name="freq">500</int>
		<int name="radius">14</int>
		<int name="actor-filter">6</int>
		<string name="warn-snd">event:/sfx/character/classes/rogue/pressure_trap_trigger</string>
		<string name="sound-loop">event:/sfx/doodads/traps/floor_spikes/floor_spikes_loop</string>
		<string name="sound-loop-start-snd">event:/sfx/doodads/traps/floor_spikes/floor_spikes_start</string>
		<string name="sound-loop-stop-snd">event:/sfx/doodads/traps/floor_spikes/floor_spikes_stop</string>
		<string name="sound-on-scene">on</string>
		<array name="effects">
			<dict><string name="class">Damage</string><int name="physical">15</int><bool name="true-strike">true</bool></dict>
			<dict><string name="class">HPBasedDamage</string><float name="physical">0.2</float><bool name="curr-hp">true</bool><bool name="true-strike">true</bool></dict>
		</array>
	</behavior>
	<scenes>
		<scene name="off">
			<scene src="doodads/traps/floors/floor_spikes_pressure.unit:off"/>
		</scene>
		<scene name="warn">
			<scene src="doodads/traps/floors/floor_spikes_pressure.unit:off"/>
			<effect src="effects/generic/other/area_warning_xray_500.effect?radius=14"/>
		</scene>
		<scene name="on">
			<scene src="doodads/traps/floors/floor_spikes_pressure.unit:on"/>
		</scene>
	</scenes>
</unit>
