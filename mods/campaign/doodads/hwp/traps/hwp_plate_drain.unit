<!-- HoH1's drain plate (drain_strong): HoH2's curse floor; while active it takes 5% of maximum mana every 0.5 s and darkens the view for 2.5 s (hwp_trap_darkness).
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="-20">
	<behavior class="HWPTrap">
		<string name="trigger">timer</string>
		<int name="off">3000</int>
		<int name="warn">1000</int>
		<int name="on">2000</int>
		<int name="freq">500</int>
		<int name="radius">14</int>
		<int name="actor-filter">6</int>
		<array name="effects">
			<dict><string name="class">GivePercentageMana</string><float name="mana">-0.05</float><bool name="curr-mana">false</bool></dict>
			<dict><string name="class">ApplyBuff</string><string name="buff">tweak/hwp/campaign_buffs.sval:hwp_trap_darkness</string></dict>
		</array>
	</behavior>
	<scenes>
		<scene name="off">
			<scene src="doodads/traps/floors/floor_curse.unit:off"/>
		</scene>
		<scene name="warn">
			<scene src="doodads/traps/floors/floor_curse.unit:inactive"/>
			<effect src="effects/generic/other/area_warning_xray_1000.effect?radius=14"/>
		</scene>
		<scene name="on">
			<scene src="doodads/traps/floors/floor_curse.unit:on"/>
		</scene>
	</scenes>
</unit>
