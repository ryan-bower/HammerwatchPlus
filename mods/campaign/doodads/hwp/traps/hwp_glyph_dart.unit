<!-- HoH1's dart trap: a player within 20 px lights the glyph, a second later a ring of 8 trap arrows (HoH2's arrow.unit) flies out of it, one at the nearest player, and a player on it is stabbed once (an arrow's 20 physical + 20% of current health); back after 5 s.
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="0">
	<behavior class="HWPTrap">
		<string name="trigger">near</string>
		<int name="sense">20</int>
		<int name="warn">1000</int>
		<int name="on">300</int>
		<int name="rearm">5000</int>
		<bool name="once">true</bool>
		<int name="freq">0</int>
		<int name="radius">8</int>
		<int name="actor-filter">6</int>
		<string name="warn-snd">event:/sfx/doodads/buttons/button_magic</string>
		<string name="shoot">doodads/traps/projectiles/arrow.unit</string>
		<int name="shots">8</int>
		<int name="arc">315</int>
		<bool name="aim">true</bool>
		<int name="muzzle">12</int>
		<array name="effects">
			<dict><string name="class">Damage</string><int name="physical">20</int></dict>
			<dict><string name="class">HPBasedDamage</string><float name="physical">0.2</float><bool name="curr-hp">true</bool></dict>
		</array>
	</behavior>
	<scenes>
		<scene name="off">
			<effect src="effects/generic/other/arcane/glyph_idle.effect"/>
		</scene>
		<scene name="warn">
			<effect src="effects/generic/other/arcane/glyph_active.effect"/>
			<effect src="effects/generic/other/area_warning_xray_1000.effect?radius=24"/>
		</scene>
		<scene name="on">
			<effect src="effects/generic/other/arcane/glyph_active.effect"/>
		</scene>
	</scenes>
</unit>
