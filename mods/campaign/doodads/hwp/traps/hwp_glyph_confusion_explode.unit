<!-- The confusion trap's burst: a short fuse, then everyone within 40 px gets
     tweak/hwp/campaign_buffs.sval:hwp_trap_confusion (1000 ms, inverted controls). -->
<unit layer="0" netsync="position">
	<behavior class="BombBehavior">
		<string name="team">enemy</string>
		<string name="spawn-sound">event:/sfx/doodads/buttons/button_magic</string>
		<int name="delay">150</int>

		<array name="actions">
			<dict>
				<string name="class">Explode</string>
				<int name="radius">40</int>
				<float name="dist-scaling">1000</float>
				<bool name="hit-different-team">true</bool>

				<array name="effects">
					<dict>
						<string name="class">ApplyBuff</string>
						<string name="buff">tweak/hwp/campaign_buffs.sval:hwp_trap_confusion</string>
						<bool name="ignore-intensity">true</bool>
					</dict>
				</array>
			</dict>
			<dict>
				<string name="class">SpawnEffect</string>
				<string name="effect">effects/generic/explosions/arcane_explosion_1.effect</string>
			</dict>
		</array>
	</behavior>

	<scenes>
		<scene>
		</scene>
	</scenes>
</unit>
