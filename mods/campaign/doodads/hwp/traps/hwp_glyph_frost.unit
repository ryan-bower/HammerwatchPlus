<!-- HoH1's frost glyph: a player within 20 px lights it, a second later it bursts (32 px: 20 ice + 10% of current health, frozen 1 s); back after 6 s.
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="0">
	<behavior class="HWPTrap">
		<string name="trigger">near</string>
		<int name="sense">20</int>
		<int name="warn">1000</int>
		<int name="on">300</int>
		<int name="rearm">6000</int>
		<bool name="once">true</bool>
		<int name="radius">32</int>
		<int name="freq">0</int>
		<int name="actor-filter">6</int>
		<string name="warn-snd">event:/sfx/player/classes/ranger/trap/trap_set_pre</string>
		<string name="on-snd">event:/sfx/doodads/traps/magic_ball/magic_ball_ice_hit</string>
		<string name="on-fx">effects/generic/explosions/ice_explosion_2.effect?radius=32</string>
		<array name="effects">
			<dict><string name="class">Damage</string><int name="ice">20</int></dict>
			<dict><string name="class">HPBasedDamage</string><float name="ice">0.1</float><bool name="curr-hp">true</bool></dict>
			<dict><string name="class">ApplyBuff</string><string name="buff">tweak/buffs/status_effects.sval:freeze_minor</string></dict>
		</array>
	</behavior>
	<scenes>
		<scene name="off">
			<effect src="effects/generic/other/arcane/glyph_idle.effect"/>
		</scene>
		<scene name="warn">
			<effect src="effects/generic/other/arcane/glyph_ice.effect"/>
			<effect src="effects/generic/other/area_warning_xray_1000.effect?radius=32"/>
		</scene>
		<scene name="on">
			<effect src="effects/generic/other/arcane/glyph_ice.effect"/>
		</scene>
	</scenes>
</unit>
