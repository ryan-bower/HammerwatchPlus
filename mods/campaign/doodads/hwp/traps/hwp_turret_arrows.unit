<!-- HoH1's arrow turret: HoH2's turret art; a player it can see within 220 px wakes it, half a second later it turns and fires a fan of 3 arrows (30 degrees) at them, every 2.5 s.
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="0">
	<behavior class="HWPTrap">
		<string name="trigger">near</string>
		<int name="sense">220</int>
		<bool name="los">true</bool>
		<bool name="aim">true</bool>
		<bool name="facing">true</bool>
		<int name="warn">500</int>
		<int name="on">200</int>
		<int name="rearm">2500</int>
		<int name="freq">0</int>
		<int name="radius">1</int>
		<string name="shoot">doodads/traps/projectiles/arrow.unit</string>
		<int name="shots">3</int>
		<int name="arc">30</int>
		<int name="dir">90</int>
		<int name="muzzle">26</int>
		<int name="muzzle-y">-6</int>
		<array name="effects">
		</array>
	</behavior>
	<scenes>
		<scene name="off_n">
			<scene src="doodads/traps/turrets/turret_arrows.unit:n"/>
		</scene>
		<scene name="warn_n">
			<scene src="doodads/traps/turrets/turret_arrows.unit:n"/>
			<effect src="effects/generic/other/area_warning_xray_500.effect?radius=12"/>
		</scene>
		<scene name="on_n">
			<scene src="doodads/traps/turrets/turret_arrows.unit:shoot_n"/>
		</scene>
		<scene name="off_e">
			<scene src="doodads/traps/turrets/turret_arrows.unit:e"/>
		</scene>
		<scene name="warn_e">
			<scene src="doodads/traps/turrets/turret_arrows.unit:e"/>
			<effect src="effects/generic/other/area_warning_xray_500.effect?radius=12"/>
		</scene>
		<scene name="on_e">
			<scene src="doodads/traps/turrets/turret_arrows.unit:shoot_e"/>
		</scene>
		<scene name="off_s">
			<scene src="doodads/traps/turrets/turret_arrows.unit:s"/>
		</scene>
		<scene name="warn_s">
			<scene src="doodads/traps/turrets/turret_arrows.unit:s"/>
			<effect src="effects/generic/other/area_warning_xray_500.effect?radius=12"/>
		</scene>
		<scene name="on_s">
			<scene src="doodads/traps/turrets/turret_arrows.unit:shoot_s"/>
		</scene>
		<scene name="off_w">
			<scene src="doodads/traps/turrets/turret_arrows.unit:w"/>
		</scene>
		<scene name="warn_w">
			<scene src="doodads/traps/turrets/turret_arrows.unit:w"/>
			<effect src="effects/generic/other/area_warning_xray_500.effect?radius=12"/>
		</scene>
		<scene name="on_w">
			<scene src="doodads/traps/turrets/turret_arrows.unit:shoot_w"/>
		</scene>
	</scenes>
</unit>
