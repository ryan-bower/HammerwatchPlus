<!-- HoH1's stalactites: a player within 20 px shakes one loose; its shadow grows while it falls (0.9 s) and the impact hits 18 px (20 physical + 20% of current health); another hangs there 5 s later.
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="0">
	<behavior class="HWPTrap">
		<string name="trigger">near</string>
		<int name="sense">20</int>
		<int name="warn">900</int>
		<int name="on">200</int>
		<int name="rearm">5000</int>
		<bool name="once">true</bool>
		<int name="radius">18</int>
		<int name="freq">0</int>
		<int name="actor-filter">6</int>
		<string name="warn-snd">event:/sfx/doodads/traps/boulder/boulder_fall</string>
		<string name="on-snd">event:/sfx/doodads/traps/boulder/boulder_impact</string>
		<string name="on-fx">effects/generic/impacts/stalactite_impact.effect</string>
		<array name="effects">
			<dict><string name="class">Damage</string><int name="physical">20</int><bool name="true-strike">true</bool></dict>
			<dict><string name="class">HPBasedDamage</string><float name="physical">0.2</float><bool name="curr-hp">true</bool><bool name="true-strike">true</bool></dict>
		</array>
	</behavior>
	<scenes>
		<scene name="off"/>
		<scene name="warn">
			<effect src="actors/bosses/bone_serpent/effects/trap_falling_stalactite_shadow_small.effect"/>
			<effect src="effects/generic/other/environment/stalactite.effect"/>
		</scene>
		<scene name="on"/>
	</scenes>
</unit>
