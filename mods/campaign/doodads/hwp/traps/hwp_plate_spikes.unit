<!-- HoH1's spike plate: HoH2's floor spikes on a cycle (2.5 s down, 1 s red warning, 1.5 s up), 25 physical + 10% of current health every 0.5 s while up (HoH2's spike numbers).
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="-20">
	<behavior class="HWPTrap">
		<string name="trigger">timer</string>
		<int name="off">2500</int>
		<int name="warn">1000</int>
		<int name="on">1500</int>
		<int name="freq">500</int>
		<int name="radius">14</int>
		<int name="actor-filter">6</int>
		<string name="sound-loop">event:/sfx/doodads/traps/floor_spikes/floor_spikes_loop</string>
		<string name="sound-loop-start-snd">event:/sfx/doodads/traps/floor_spikes/floor_spikes_start</string>
		<string name="sound-loop-stop-snd">event:/sfx/doodads/traps/floor_spikes/floor_spikes_stop</string>
		<string name="sound-on-scene">on</string>
		<array name="effects">
			<dict><string name="class">Damage</string><int name="physical">25</int><bool name="true-strike">true</bool></dict>
			<dict><string name="class">HPBasedDamage</string><float name="physical">0.1</float><bool name="curr-hp">true</bool><bool name="true-strike">true</bool></dict>
		</array>
	</behavior>
	<scenes>
		<scene name="off">
			<scene src="doodads/traps/floors/floor_spikes.unit:off"/>
		</scene>
		<scene name="warn">
			<scene src="doodads/traps/floors/floor_spikes.unit:inactive"/>
			<effect src="effects/generic/other/area_warning_xray_1000.effect?radius=14"/>
		</scene>
		<scene name="on">
			<scene src="doodads/traps/floors/floor_spikes.unit:on"/>
		</scene>
	</scenes>
</unit>
