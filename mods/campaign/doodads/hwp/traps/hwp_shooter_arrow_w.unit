<!-- HoH1's arrow shooter on a wall, facing w: with a player within 200 px it fires HoH2's trap projectile (arrow.unit) every 1.5 s.
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="0">
	<behavior class="HWPTrap">
		<string name="trigger">near</string>
		<int name="sense">200</int>
		<int name="warn">0</int>
		<int name="on">100</int>
		<int name="rearm">1500</int>
		<int name="freq">0</int>
		<int name="radius">1</int>
		<string name="shoot">doodads/traps/projectiles/arrow.unit</string>
		<int name="dir">180</int>
		<int name="muzzle">4</int>
		<int name="muzzle-y">-8</int>
		<array name="effects">
		</array>
	</behavior>
	<scenes>
		<scene name="off">
			<scene src="doodads/traps/shooters/shooter_wall.unit:w"/>
		</scene>
		<scene name="on">
			<scene src="doodads/traps/shooters/shooter_wall.unit:w"/>
		</scene>
	</scenes>
</unit>
