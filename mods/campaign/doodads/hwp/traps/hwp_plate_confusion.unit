<!-- HoH1's confusion plate (trap_confusion): while the rune glows, 1 s of confusion (hwp_trap_confusion: movement and aim reversed), renewed every 0.5 s.
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="-20">
	<behavior class="HWPTrap">
		<string name="trigger">timer</string>
		<int name="off">3500</int>
		<int name="warn">1000</int>
		<int name="on">1500</int>
		<int name="freq">500</int>
		<int name="radius">14</int>
		<int name="actor-filter">6</int>
		<array name="effects">
			<dict><string name="class">ApplyBuff</string><string name="buff">tweak/hwp/campaign_buffs.sval:hwp_trap_confusion</string></dict>
		</array>
	</behavior>
	<scenes>
		<scene name="off">
			<sprite origin="16 16" texture="doodads/traps/floors/trap_curse.png" material="system/default.mats:floor"><frame>0 32 32 32</frame></sprite>
			<scene src="special/minimap.unit:trap_spikes_off"/>
		</scene>
		<scene name="warn">
			<sprite origin="16 16" texture="doodads/traps/floors/trap_curse.png" material="system/default.mats:floor"><frame>0 32 32 32</frame></sprite>
			<scene src="special/minimap.unit:trap_spikes_off"/>
			<effect src="effects/generic/other/area_warning_xray_1000.effect?radius=14"/>
		</scene>
		<scene name="on">
			<sprite origin="16 16" texture="doodads/traps/floors/trap_curse.png" material="system/default.mats:floor"><frame>0 32 32 32</frame></sprite>
			<scene src="special/minimap.unit:trap_spikes_on"/>
			<effect src="effects/generic/other/arcane/glyph_active.effect"/>
		</scene>
	</scenes>
</unit>
