<!-- HoH1's bear traps (the Warden's): the ranger's trap art; it snaps on a player within 10 px (30 physical, immobilized 2 s) and stays sprung.
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="0">
	<behavior class="HWPTrap">
		<string name="trigger">near</string>
		<int name="sense">10</int>
		<int name="warn">0</int>
		<int name="on">500</int>
		<int name="uses">1</int>
		<bool name="once">true</bool>
		<int name="radius">16</int>
		<int name="freq">0</int>
		<int name="actor-filter">6</int>
		<string name="on-snd">event:/sfx/player/classes/ranger/trap/trap_trigger</string>
		<array name="effects">
			<dict><string name="class">Damage</string><int name="physical">30</int><bool name="true-strike">true</bool></dict>
			<dict><string name="class">ApplyBuff</string><string name="buff">tweak/buffs/status_effects.sval:immobilize_minor</string></dict>
		</array>
	</behavior>
	<scenes>
		<scene name="off">
			<effect src="players/ranger/units/bear_trap.effect"/>
		</scene>
		<scene name="warn">
			<effect src="players/ranger/units/bear_trap.effect"/>
		</scene>
		<scene name="on">
			<effect src="players/ranger/units/bear_trap_triggered.effect"/>
		</scene>
		<scene name="spent"/>
	</scenes>
</unit>
