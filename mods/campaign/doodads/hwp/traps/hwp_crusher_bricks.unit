<!-- HoH1's crushing ceiling: a player within 40 px brings dust down and the red warning for 1 s, then the bricks hit 16 px (30 physical + 20% of current health); 3 s to re-arm.
     Generated by tools/make_hwp_traps.py (HWPTrap, scripts/HWP/Campaign/TrapBehavior.as). -->
<unit slot="doodad" layer="0">
	<behavior class="HWPTrap">
		<string name="trigger">near</string>
		<int name="sense">40</int>
		<int name="warn">1000</int>
		<int name="on">300</int>
		<int name="rearm">3000</int>
		<bool name="once">true</bool>
		<int name="radius">16</int>
		<int name="freq">0</int>
		<int name="actor-filter">6</int>
		<string name="on-snd">event:/sfx/doodads/traps/boulder/boulder_impact</string>
		<string name="on-fx">effects/generic/impacts/stalactite_impact.effect</string>
		<array name="effects">
			<dict><string name="class">Damage</string><int name="physical">30</int><bool name="true-strike">true</bool></dict>
			<dict><string name="class">HPBasedDamage</string><float name="physical">0.2</float><bool name="curr-hp">true</bool><bool name="true-strike">true</bool></dict>
		</array>
	</behavior>
	<scenes>
		<scene name="off"/>
		<scene name="warn">
			<effect src="actors/bosses/bone_serpent/effects/environment/falling_bricks_hint.effect"/>
			<effect src="effects/generic/other/area_warning_xray_1000.effect?radius=16"/>
		</scene>
		<scene name="on"/>
	</scenes>
</unit>
