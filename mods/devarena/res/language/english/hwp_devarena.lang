<lang name="English" official="false">
	<string name="hwp.devarena.key.dock">Dev Arena: dock</string>
	<string name="hwp.devarena.key.ab">Dev Arena: swap A/B</string>
	<string name="hwp.devarena.key.undo">Dev Arena: previous version</string>
	<string name="hwp.devarena.key.redo">Dev Arena: next version</string>
	<string name="hwp.devarena.key.reset">Dev Arena: arena reset</string>
	<string name="hwp.devarena.key.golem">Dev Arena: golem room</string>
	<string name="hwp.devarena.key.pause">Dev Arena: pause</string>
	<string name="hwp.cfg.o.devarena-dock.about">Opens or closes the Dev Arena dock. Default F1.</string>
	<string name="hwp.cfg.o.devarena-ab.about">Swaps the live slot between A and B. Default F2.</string>
	<string name="hwp.cfg.o.devarena-undo.about">With Ctrl held: steps the live slot back a version. Default Ctrl+Z (US layout).</string>
	<string name="hwp.cfg.o.devarena-redo.about">With Ctrl held: steps the live slot forward a version. Default Ctrl+Y (US layout).</string>
	<string name="hwp.cfg.o.devarena-reset.about">Arena reset: kills what the brush placed, clears encounters, fresh golem. Default F3.</string>
	<string name="hwp.cfg.o.devarena-golem.about">Into or out of the golem room. Default F4.</string>
	<string name="hwp.cfg.o.devarena-pause.about">Pauses or resumes the game. Default F6.</string>
</lang>
