	<!--
		The Flamethrower Rifle's under-barrel flamethrower (right click): held, a jet of flame
		every 100 ms (flame.unit: fire, through 3 enemies, about 68 px out) for 1 mana each
		100 ms while held. The channel stops when the mana runs out. No rounds, no cooldown.
	-->
	<dict>
		<string name="name">.skills.attacks.twohanded.hwp_flamer.name</string>
		<string name="description">.skills.attacks.twohanded.hwp_flamer.desc?dmg=25%&mana=10</string>
		<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>0 144 24 24</vec4></array>
		<string name="id">hwp_attack_flamer</string>
		<string name="type">offhand</string>
		<array name="tags"><s>weapon</s><s>ranged</s><s>hwp_firearm</s><s>fire</s></array>

		<dict name="skill">
			<string name="class">Skills::PlayerSkillDirectionalChannelling</string>
			<string name="anim">cast-channel</string>

			<int name="cooldown">0</int>
			<int name="castpoint">100</int>
			<float name="cast-speed-mul">1</float>
			<float name="move-speed-mul">0.5</float>
			<ivec2 name="move-speed">0 1000000000</ivec2>
			<ivec2 name="blocking">0 100</ivec2>
			<bool name="update-aim">true</bool>
			<bool name="cooldown-on-castpoint">false</bool>

			<!-- paid every cost-interval; one no longer than the castpoint, or the channel ends at
			     its first castpoint before the first payment (PlayerSkillDirectionalChannelling.Update) -->
			<int name="mana-cost">1</int>
			<int name="cost-interval">100</int>

			<dict name="actions">
				<array name="flame">
					<dict>
						<string name="class">ShootProjectile</string>
						<string name="projectile">players/hwp/firearms/projectiles/flame.unit</string>
						<int name="dist">22</int>
						<int name="spread">12</int>
					</dict>
				</array>
			</dict>

			<array name="timelines-looping">
				<array>
					<i>100</i><s>flame</s>
				</array>
			</array>
		</dict>
	</dict>

	<!--
		The Full Auto Rifle's full auto (right click): held, one rifle round every 100 ms (a
		100 ms cycle with its round at 0) with a 40 degree spread (ShootProjectile.as:60:
		+-20 degrees), against the burst's 2. Rounds, not mana; no cooldown. The blocking covers
		the first 50 ms, so a skill or a dodge can still cut in between rounds.
	-->
	<dict>
		<string name="name">.skills.attacks.twohanded.hwp_autofire.name</string>
		<string name="description">.skills.attacks.twohanded.hwp_autofire.desc?dmg=52%&rate=10</string>
		<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>24 144 24 24</vec4></array>
		<string name="id">hwp_attack_autofire</string>
		<string name="type">offhand</string>
		<array name="tags"><s>weapon</s><s>ranged</s><s>hwp_firearm</s><s>physical</s></array>

		<dict name="skill">
			<string name="class">HWPFirearmsGun</string>
			<string name="anim">attack</string>
			<int name="anim-length">100</int>

			<int name="cooldown">0</int>
			<float name="move-speed-mul">0.4</float>
			<ivec2 name="move-speed">0 100</ivec2>
			<float name="cast-speed-mul">1</float>
			<ivec2 name="blocking">0 50</ivec2>
			<int name="castpoint">0</int>
			<ivec2 name="update-aim">0 100</ivec2>
			<bool name="repeating">true</bool>
			<int name="mana-cost">0</int>
			%block HasRound

			<dict name="actions">
				<array name="shot">
					<dict>
						<string name="class">HWPFirearmsGunShot</string>
						<string name="projectile">players/hwp/firearms/projectiles/rifle_round.unit</string>
						<string name="fire">players/hwp/firearms/projectiles/rifle_round_fire.unit</string>
						<string name="ice">players/hwp/firearms/projectiles/rifle_round_ice.unit</string>
						<string name="lightning">players/hwp/firearms/projectiles/rifle_round_lightning.unit</string>
						<string name="poison">players/hwp/firearms/projectiles/rifle_round_poison.unit</string>
						<int name="dist">22</int>
						<int name="spread">40</int>
					</dict>
					%block Bang 1.2
					%block Spend 1
					%block Low 3
				</array>
			</dict>

			<array name="timeline">
				<i>0</i><s>shot</s>
			</array>
		</dict>
	</dict>
</array>
