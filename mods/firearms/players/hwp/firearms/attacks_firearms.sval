<loader order="-2">Item::ItemSkillDef::LoadMultiple</loader>
<!--
	Gun attacks. Every round spends one clip stack (stacks_firearms.sval:clip); a skill
	won't start without a round left, and an action list whose conditional fails stops
	there (IAction.as DoActions), so each list below checks what it needs before it shoots.
	The keywords of one "conditional" array must all hold; a "conditionals" list of arrays
	passes when any one array does (Conditional.as CheckConditionals), so the gates are flat.
	The Glocks read the other hand's marker buff (buffs_firearms.sval) to pair up.
	The rounds are shot by HWPFirearmsGunShot (Elemental.as), which may swap in an element's
	round for Elemental Bullets (fs_scavenger.sval).
	Each attack's blocking ends just after its last round, as vanilla attacks block only their
	opening (shortbow 0 100 of 300). A held gun restarts itself in the frame its cycle ends
	(Combat.as HWPFirearmsGun), so while one blocked its whole cycle no skill could start
	(PlayerTargetingHelper.CheckSkillBlocked) and the bench cast a 3 s Sniper Shot 1-3 times in 15 s.
-->

<array>
%defblock Spend N
				<dict>
					<string name="class">AddStacks</string>
					<string name="buff">players/hwp/firearms/stacks_firearms.sval:clip</string>
					<int name="stacks">-%%N%%</int>
					<bool name="target-self">true</bool>
				</dict>
%endblock
%defblock Shot ROUND OFFSET SPREAD
					<dict>
						<string name="class">HWPFirearmsGunShot</string>
						<string name="projectile">players/hwp/firearms/projectiles/%%ROUND%%.unit</string>
						<string name="fire">players/hwp/firearms/projectiles/%%ROUND%%_fire.unit</string>
						<string name="ice">players/hwp/firearms/projectiles/%%ROUND%%_ice.unit</string>
						<string name="lightning">players/hwp/firearms/projectiles/%%ROUND%%_lightning.unit</string>
						<string name="poison">players/hwp/firearms/projectiles/%%ROUND%%_poison.unit</string>
						<int name="dist">12</int>
						<vec2 name="offset">0 %%OFFSET%%</vec2>
						<bool name="rotate-offset">true</bool>
						<int name="converge">100</int>
						<int name="spread">%%SPREAD%%</int>
					</dict>
%endblock
%defblock Bang VOLUME
					<dict>
						<string name="class">HWPFirearmsSound</string>
						<string name="sound">event:/sfx/actors/humans/bandits/bandit_rogue/bandit_rogue_bomb_bounce</string>
						<float name="volume">%%VOLUME%%</float>
					</dict>
%endblock
%defblock Low N
					<dict>
						<string name="class">HWPFirearmsLowClick</string>
						<int name="low">%%N%%</int>
					</dict>
%endblock
%defblock If MARK N
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>has</s><s>players/hwp/firearms/buffs_firearms.sval:%%MARK%%</s><s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>ge</s><i>%%N%%</i>
						</array>
					</dict>
%endblock
%defblock IfLast MARK
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>has</s><s>players/hwp/firearms/buffs_firearms.sval:%%MARK%%</s><s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>lt</s><i>2</i>
						</array>
					</dict>
%endblock
%defblock HasRound
		<array name="conditional">
			<s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>ge</s><i>1</i>
		</array>
%endblock

	<dict>
		<string name="name">.skills.attacks.twohanded.hwp_rifle1.name</string>
		<string name="description">.skills.attacks.twohanded.hwp_rifle1.desc?dmg=52%</string>
		<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>48 48 24 24</vec4></array>
