					%block Shot hcannon_round 6 5
					%block Bang 1.8
					%block Spend 1
					%block Low 4
				</array>
				<array name="right">
					%block If hcannon_off 1
					%block Shot hcannon_round_off -6 5
					%block Bang 1.8
					%block Spend 1
					%block Low 4
				</array>
				<array name="mix1">
					%block If glock_off 1
					%block Shot glock_round_off -6 5
					%block Bang 1
					%block Spend 1
					%block Low 6
				</array>
				<array name="mix2">
					%block If glock_off 1
					%block Shot hcannon_round 6 5
					%block Bang 1.8
					%block Spend 1
					%block Low 6
				</array>
				<array name="mix3">
