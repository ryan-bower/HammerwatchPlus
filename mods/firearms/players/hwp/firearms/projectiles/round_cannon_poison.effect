<!-- A Hand Cannon (a fat slug) round, poison. Generated by tools/make_bullet_art.py; edit that, not this. -->
<effect looping="true" wpos-track="3">
	<param name="angle" default="0" />
	<param name="height" default="0" />

	<sprite looping="true" origin="9 3.5" texture="./rounds.png" material="system/default.mats:shadow"
		pos-x="0"
		pos-y="+height"
		angle="angle">
		<frame time="60">0 96 16 8</frame>
		<frame time="60">16 96 16 8</frame>
	</sprite>
	<sprite looping="true" origin="9 3.5" texture="./rounds.png" material="system/default.mats:default"
		pos-x="0"
		pos-y="-height"
		angle="angle">
		<frame time="60">0 96 16 8</frame>
		<frame time="60">16 96 16 8</frame>
	</sprite>

	<particle_spawner
		spawn-rate="12"
		length="200"
		looping="true"
		ttl="rpick(150,350)"
		angle="0"
		pos="cos(angle)*-3;-height+sin(angle)*-3;0"
		color-mul="0.7;2.4;0.4;1"
		rot-speed="rpick(-2.2,2.2)"
		rot-damping="2"
		force-damping="rpick(1,3)">
		<behaviors>
			<spread_range radius="rpick(0,1.5)"/>
			<force_dir dir="cos(angle)*-0.2;sin(angle)*-0.2;0"/>
			<fade_to a="0" r="0" g="0" b="0" />
		</behaviors>
		<particle src="effects/subeffects/particles_speckles.unit:single_grey200_add_offset_2"/>
		<particle src="effects/subeffects/particles_speckles.unit:single_grey200_add"/>
	</particle_spawner>

	<light pos-x="cos(angle)*2" pos-y="-height+sin(angle)*2">
		<sprite texture="effects/lights/light2_L.png">
			<frame time="800">0 0 128 128</frame>
		</sprite>
		<looping value="true" />
		<length value="150" />
		<cast-shadows value="false" />
		<size value="44" />
		<color-r value="0.12" />
		<color-g value="0.30" />
		<color-b value="0.07" />
		<color-a value="0"/>
	</light>
</effect>
