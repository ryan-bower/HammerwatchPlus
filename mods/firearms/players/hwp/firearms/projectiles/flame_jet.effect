<!-- One flame of the Flamethrower Rifle's spray. Generated by tools/make_bullet_art.py; edit that, not this. -->
<effect looping="true" wpos-track="3">
	<param name="angle" default="0" />
	<param name="height" default="0" />

	<sprite looping="false" origin="16 16" texture="./rounds.png" material="system/default.mats:bright-glow"
		pos-x="0"
		pos-y="-height+(rand(u+7)-0.5)*3"
		scale-x="0.85+rand(u+12)*0.3"
		scale-y="0.8+rand(u+31)*0.4"
		color-a="1-pow(t,6)"
		angle="angle">
		<frame time="80">32 64 32 32</frame>
		<frame time="80">64 64 32 32</frame>
		<frame time="80">96 64 32 32</frame>
		<frame time="80">32 96 32 32</frame>
		<frame time="80">64 96 32 32</frame>
		<frame time="80">96 96 32 32</frame>
	</sprite>

	<particle_spawner
		spawn-rate="14"
		length="200"
		looping="true"
		ttl="rpick(200,450)"
		angle="0"
		pos="cos(angle)*-4;-height+sin(angle)*-4;0"
		color-mul="2.8;0.7;0.1;1"
		rot-speed="rpick(-2.2,2.2)"
		rot-damping="2"
		force-damping="rpick(1,3)">
		<behaviors>
			<spread_range radius="rpick(0,1.5)"/>
			<force_dir dir="cos(angle)*-0.2;sin(angle)*-0.2;0"/>
			<fade_to a="0" r="0" g="0" b="0" />
		</behaviors>
		<particle src="effects/subeffects/particles_speckles.unit:single_grey200_add_offset_2"/>
		<particle src="effects/subeffects/particles_speckles.unit:single_grey200_add"/>
	</particle_spawner>

	<light pos-x="cos(angle)*2" pos-y="-height+sin(angle)*2">
		<sprite texture="effects/lights/light2_L.png">
			<frame time="800">0 0 128 128</frame>
		</sprite>
		<looping value="true" />
		<length value="150" />
		<cast-shadows value="false" />
		<size value="40" />
		<color-r value="0.45" />
		<color-g value="0.23" />
		<color-b value="0.07" />
		<color-a value="0"/>
	</light>
</effect>
