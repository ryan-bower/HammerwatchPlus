<!-- The example Luck buff (scripts/HWP/Core/Luck.as, `hwp luck buff [n]`): +n Luck for ten
     minutes, n = intensity x 100 (the add lerps 0..100 by the buff's intensity). Any buff
     gives Luck the same way: a Modifiers::CustomStat named hwp-luck in its modifiers
     (docs/design/luck.md has the snippet for herb, food and fish buffs). -->
<svals>
	<dict name="hwp_luck_charm">
		<string name="name">.hwp.luck.buff.name</string>
		<string name="description">.hwp.luck.buff.desc</string>
		<array name="hud"><s>items/icons_consumables.png</s><i>100</i><vec4>225 297 14 14</vec4></array>
		<array name="tags"><string>buff</string></array>
		<bool name="debuff">false</bool>
		<int name="duration">600000</int>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::CustomStat</string>
				<string name="name">hwp-luck</string>
				<vec2 name="add">0 100</vec2>
			</dict>
		</array>
	</dict>
</svals>
