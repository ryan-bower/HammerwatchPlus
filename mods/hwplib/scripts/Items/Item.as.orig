namespace Item
{
	enum Quality
	{
		None = 0,
		Common = 1,
		Uncommon = 2,
		Rare = 4,
		Epic = 8,
		Legendary = 16,
		Quest = 32,
		Unique = 64,
		Cursed = 128
	}

	int QualityEnumLength()
	{
		return 8;
	}

	int QualityToIndex(Quality q)
	{
		if (q == Quality::None)
			return 0;
		else if (q == Quality::Common)
			return 1;
		else if (q == Quality::Uncommon)
			return 2;
		else if (q == Quality::Rare)
			return 3;
		else if (q == Quality::Epic)
			return 4;
		else if (q == Quality::Legendary)
			return 5;
		else if (q == Quality::Quest)
			return 6;
		else if (q == Quality::Unique)
			return 7;
		else if (q == Quality::Cursed)
			return 8;
		
		return 0;
	}

	Quality IndexToQuality(int q)
	{
		if (q == 0)
			return Quality::None;
		else if (q == 1)
			return Quality::Common;
		else if (q == 2)
			return Quality::Uncommon;
		else if (q == 3)
			return Quality::Rare;
		else if (q == 4)
			return Quality::Epic;
		else if (q == 5)
			return Quality::Legendary;
		else if (q == 6)
			return Quality::Quest;
		else if (q == 7)
			return Quality::Unique;
		else if (q == 8)
			return Quality::Cursed;
		
		return Quality::None;
	}

	enum SavedItem
	{
		None = 0,
		Regular = 1,
		Map = 2
	}


	class Item : IModifierProvider
	{
		Item()
		{
		}
		
		void Save(SValueBuilder& builder) { }
		void Load(SValue@ save) { }
		
		Quality GetQuality() { return Quality::None; }
		ScriptSprite@ GetIcon() { return null; }
		string& GetPickupText() { return GetName(); }
		string& GetName() { return emptyString; }
		string& GetDescription(PlayerRecord@ plr) { return emptyString; }
		string& GetGraphic() { return emptyString; }
		
		string GetModifierProviderName() { return "\\c" + Item::QualityColorString(GetQuality()) + GetName() + "\\d"; }
		
		bool IsEquippable() { return false; }
		int GetPrice() { return 0; }
		ItemSkillDef@ GetSkill() { return null; }
		ItemSkillDef@ GetSecondarySkill() { return null; }
		bool ShouldShowPickupTooltip() { return false; }
		Item@ Copy() { return this; }
		
		uint GetIDHash() { return 1; }
	}
	
	
	void SaveItem(SValueBuilder& builder, Item::Item@ item)
	{
		if (item is null)
			builder.PushNull();
		else
			item.Save(builder);
	}
	
	Item::Item@ LoadItem(SValue@ sval)
	{
		if (sval is null)
			return null;
		
		auto type = sval.GetType();
		
		if (type == SValueType::Array)
		{
			auto arr = sval.GetArray();
			if (arr.length() > 0)
			{
				Item::Item@ item = null;
				
				if (arr[0].GetType() == SValueType::String)
					@item = Item::Get(arr[0].GetString());
				else if (arr[0].GetType() == SValueType::Long)
				{
					if (Item::SavedItem(arr[0].GetLong()) == Item::SavedItem::Map)
					{
						auto def = Item::LoadMissionMapDef(arr[1]);
						if (def !is null)
							@item = MissionMap(def);
					}
				}
				else
					return Equipment::LoadItem(sval);
				
				if (item is null)
					return null;
				
				item.Load(sval);
				return item;
			}
		}
		
		if (type == SValueType::String)
			return Item::Get(sval.GetString());
		
		return null;
	}
	
	Item::Item@ Get(const string &in id)
	{
		uint idh = HashString(id);
		Item::Item@ ret;
		
		@ret = SimpleItem::Get(idh);
		if (ret !is null)
			return ret;
		
		@ret = Trinket::Get(idh);
		if (ret !is null)
			return ret;
		
		@ret = Valuable::Get(idh);
		if (ret !is null)
			return ret;
		
		@ret = Equipment::UniqueEquipment::Get(idh);
		if (ret !is null)
			return ret;
		
		return null;
	}
	
	Item::Item@ Get(uint idh)
	{
		Item::Item@ ret;
		
		@ret = SimpleItem::Get(idh);
		if (ret !is null)
			return ret;
		
		@ret = Trinket::Get(idh);
		if (ret !is null)
			return ret;
		
		@ret = Valuable::Get(idh);
		if (ret !is null)
			return ret;
		
		@ret = Equipment::UniqueEquipment::Get(idh);
		if (ret !is null)
			return ret;
		
		return null;
	}


	Material@ GetQualityMaterial(Quality quality)
	{
		switch (quality)
		{
		case Quality::None:
		case Quality::Quest:
		case Quality::Unique:
		
		case Quality::Cursed: return Resources::GetMaterial("items/trinkets/items.mats:common");
		case Quality::Common: return Resources::GetMaterial("items/trinkets/items.mats:common");
		case Quality::Uncommon: return Resources::GetMaterial("items/trinkets/items.mats:uncommon");
		case Quality::Rare: return Resources::GetMaterial("items/trinkets/items.mats:rare");
		case Quality::Epic: return Resources::GetMaterial("items/trinkets/items.mats:epic");
		case Quality::Legendary: return Resources::GetMaterial("items/trinkets/items.mats:legendary");
		}

		return null;
	}

	vec4 QualityColor(Quality quality)
	{
		switch (quality)
		{
		case Quality::None:
		case Quality::Cursed: return vec4(200.0f/200.0f,200.0f/255.0f,200.0f/255.0f, 1);
		case Quality::Common: return vec4(255.0f/255.0f,255.0f/255.0f,255.0f/255.0f, 1);
		case Quality::Uncommon: return vec4(66/255.0f,255.0f/255.0f,0/255.0f, 1);
		case Quality::Rare: return vec4(0/255.0f,192/255.0f,255.0f/255.0f, 1);
		case Quality::Epic: return vec4(255.0f/255.0f,0/255.0f,255.0f/255.0f, 1);
		case Quality::Legendary: return vec4(255.0f/255.0f,36/255.0f,0/255.0f, 1);
		case Quality::Quest: return vec4(255.0f/255.0f,198/255.0f,0/255.0f, 1);
		case Quality::Unique: return vec4(255.0f/255.0f,36/255.0f,0/255.0f, 1);
		}

		return vec4(1, 1, 1, 1);
	}

	string QualityColorString(Quality quality)
	{
		switch (quality)
		{
		case Quality::None:
		case Quality::Cursed: return "c8c8c8";
		case Quality::Common: return "ffffff";
		case Quality::Uncommon: return "42ff00";
		case Quality::Rare: return "00c0ff";
		case Quality::Epic: return "ff00ff";
		case Quality::Legendary: return "ff2400";
		case Quality::Quest: return "ffc600";
		case Quality::Unique: return "ff2400";
		}

		return "";
	}

	// @TODO: Localize? item.quality.common ..?
	string QualityToString(Quality quality)
	{
		switch (quality)
		{
		case Quality::Cursed: return "cursed";
		case Quality::Common: return "common";
		case Quality::Uncommon: return "uncommon";
		case Quality::Rare: return "rare";
		case Quality::Epic: return "epic";
		case Quality::Legendary: return "legendary";
		case Quality::Quest: return "quest";
		case Quality::Unique: return "unique";
		}

		return "none";
	}

	Quality ParseQuality(string _quality)
	{
		_quality = _quality.toLower();

		if (_quality == "cursed") return Quality::Cursed;
		if (_quality == "common") return Quality::Common;
		if (_quality == "uncommon") return Quality::Uncommon;
		if (_quality == "rare") return Quality::Rare;
		if (_quality == "epic") return Quality::Epic;
		if (_quality == "legendary") return Quality::Legendary;
		if (_quality == "quest") return Quality::Quest;
		if (_quality == "unique") return Quality::Unique;

		return Quality::None;
	}

	
	UnitProducer@ g_baseItemPickup = Resources::GetUnitProducer("items/base.unit");

	UnitPtr DropItem(Item@ item, vec3 pos, int count, bool dropAnim, PlayerRecord@ owner)
	{
		if (item is null)
			return UnitPtr();
		
		SValueBuilder builder;
		item.Save(builder);
	
		if (Network::IsServer())
		{
			auto pickup = g_baseItemPickup.Produce(g_scene, pos);
			auto behavior = cast<UnitBehavior>(pickup.GetScriptBehavior());
			
			if (owner is null)
				behavior.Initialize(item, count, dropAnim);
			else
				behavior.Initialize(item, count, dropAnim, owner.id);

			(Network::Message("DroppedItem") << pickup << builder.Build() << count << dropAnim << behavior.m_playerOwner.String()).SendToAll();
			
			return pickup;
		}
		else if (owner !is null)
			(Network::Message("DropItem") << xy(pos) << builder.Build() << count << dropAnim << owner.peer).SendToHost();
		else
			(Network::Message("DropItem") << xy(pos) << builder.Build() << count << dropAnim << -1).SendToHost();
		
		return UnitPtr();
	}
	
	
	string emptyString = "";
}