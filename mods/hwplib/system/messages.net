	</message>

	<message name="DangerAreaAddUnit" namespace="UnitHandler" delivery="ReliableOrdered">
		<unit /> <!-- Danger Area -->
		<unit /> <!-- Unit -->
	</message>

	<message name="DangerAreaRemoveUnit" namespace="UnitHandler" delivery="ReliableOrdered">
		<unit /> <!-- Danger Area -->
		<unit /> <!-- Unit -->
	</message>

	<message name="TeleportBeaconActivate" namespace="UnitHandler" delivery="ReliableOrdered">
		<unit /> <!-- Unit -->
	</message>

	<message name="AddDynamicTag" namespace="UnitHandler" delivery="ReliableOrdered">
		<unit /> <!-- Unit -->
		<int /> <!-- Added Tag -->
	</message>

	<message name="SetRankReward" namespace="GameModeHandler" delivery="ReliableOrdered">
		<int /> <!-- Reward Level -->
	</message>

	<!-- HammerwatchPlus: generic request/event bus, see scripts/HWP/Core/Net.as -->
	<message name="HWPRequest" namespace="HWPNet" delivery="ReliableOrdered">
		<int /> <!-- Request id: HashString of the request name -->
		<svalue /> <!-- Payload -->
	</message>

	<message name="HWPEvent" namespace="HWPNet" delivery="ReliableOrdered">
		<int /> <!-- Event id: HashString of the event name -->
		<svalue /> <!-- Payload -->
	</message>

</network>
