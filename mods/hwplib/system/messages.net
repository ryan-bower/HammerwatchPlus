<!--
	Unreliable
	UnreliableSequenced
	ReliableUnordered
	ReliableSequenced
	ReliableOrdered
-->
<network>
	<message name="SpawnPlayer" namespace="PlayerHandler" delivery="ReliableOrdered">
		<int /> <!-- Player ID -->
		<vec2pos /> <!-- Spawn position -->
