<gui>
	<!-- HammerwatchPlus core: the HammerwatchPlus tab of the player menu (HWPOptionsTab, scripts/HWP/Core/Options.as).
	     One row per option id; a module fills its row by registering an HWP::Options::Option under the same id, and a
	     row without one hides (the list closes up). Rows stay visible here: the menu collects its buttons once, at load.
	     The value text sits over the button (centred on it) so a script can change it every frame. -->
	<sprites>
		%include "gui/scalablebutton_sprites.inc"
	</sprites>

	<doc>
		<group>
			<group anchor="1 0.5" width="251" height="292" offset="0 17" >
				<text text=".hwp.options.title" anchor="0.5 0" offset="0 4" font="title" color="#ffffff" />
				<!-- Search: rows whose title (or value) holds the text stay; filtered as you type (func-edit) -->
				<rect width="231" height="18" offset="10 22" spriteset="gui/sprite_rect.sval:rounded" >
					<text id="search-hint" text=".hwp.options.search" anchor="0 0.5" offset="5 0" font="text" color="#808080" />
					<textinput id="search" textlimit="32" anchor="0 0.5" offset="5 0" textoffset="0 1" width="221" height="14" font="gui/fonts/hw8.fnt" check-reserved-characters="true" func-edit="hwp-search" func="hwp-search" func-cancel="hwp-search-clear" />
				</rect>
				<group id="rows" width="231" height="214" offset="10 44" flow="vbox" spacing="2" >
					<!-- Projectile colours (colors) -->
					<group id="hwp-opt-colors" width="231" height="22" >
						<text id="title" text="" anchor="0 0.5" offset="4 0" font="text" color="#ffffff" />
						<scalebutton id="button" func="hwp-opt colors" spriteset="scalebutton-regular" width="112" anchor="1 0.5" offset="-2 0" />
						<group width="112" height="18" anchor="1 0.5" offset="-2 0" ><text id="value" text="" anchor="0.5 0.5" offset="0 0" font="text" color="#ffffff" /></group>
					</group>
					<!-- Swap weapons key (weaponswap) -->
					<group id="hwp-opt-swapkey" width="231" height="22" >
						<text id="title" text="" anchor="0 0.5" offset="4 0" font="text" color="#ffffff" />
						<scalebutton id="button" func="hwp-opt swapkey" spriteset="scalebutton-regular" width="112" anchor="1 0.5" offset="-2 0" />
						<group width="112" height="18" anchor="1 0.5" offset="-2 0" ><text id="value" text="" anchor="0.5 0.5" offset="0 0" font="text" color="#ffffff" /></group>
					</group>
					<!-- Skill 4 key (core, SkillKeys.as) -->
					<group id="hwp-opt-skill4" width="231" height="22" >
						<text id="title" text="" anchor="0 0.5" offset="4 0" font="text" color="#ffffff" />
						<scalebutton id="button" func="hwp-opt skill4" spriteset="scalebutton-regular" width="112" anchor="1 0.5" offset="-2 0" />
						<group width="112" height="18" anchor="1 0.5" offset="-2 0" ><text id="value" text="" anchor="0.5 0.5" offset="0 0" font="text" color="#ffffff" /></group>
					</group>
					<!-- Skill 5 key (core, SkillKeys.as) -->
					<group id="hwp-opt-skill5" width="231" height="22" >
						<text id="title" text="" anchor="0 0.5" offset="4 0" font="text" color="#ffffff" />
						<scalebutton id="button" func="hwp-opt skill5" spriteset="scalebutton-regular" width="112" anchor="1 0.5" offset="-2 0" />
						<group width="112" height="18" anchor="1 0.5" offset="-2 0" ><text id="value" text="" anchor="0.5 0.5" offset="0 0" font="text" color="#ffffff" /></group>
					</group>
					<!-- Skill 6 key (core, SkillKeys.as) -->
					<group id="hwp-opt-skill6" width="231" height="22" >
						<text id="title" text="" anchor="0 0.5" offset="4 0" font="text" color="#ffffff" />
						<scalebutton id="button" func="hwp-opt skill6" spriteset="scalebutton-regular" width="112" anchor="1 0.5" offset="-2 0" />
						<group width="112" height="18" anchor="1 0.5" offset="-2 0" ><text id="value" text="" anchor="0.5 0.5" offset="0 0" font="text" color="#ffffff" /></group>
					</group>
					<!-- Auto aim mode (autoaim) -->
					<group id="hwp-opt-autoaim" width="231" height="22" >
						<text id="title" text="" anchor="0 0.5" offset="4 0" font="text" color="#ffffff" />
						<scalebutton id="button" func="hwp-opt autoaim" spriteset="scalebutton-regular" width="112" anchor="1 0.5" offset="-2 0" />
						<group width="112" height="18" anchor="1 0.5" offset="-2 0" ><text id="value" text="" anchor="0.5 0.5" offset="0 0" font="text" color="#ffffff" /></group>
					</group>
					<!-- Auto aim cone (autoaim) -->
					<group id="hwp-opt-aimcone" width="231" height="22" >
						<text id="title" text="" anchor="0 0.5" offset="4 0" font="text" color="#ffffff" />
						<scalebutton id="button" func="hwp-opt aimcone" spriteset="scalebutton-regular" width="112" anchor="1 0.5" offset="-2 0" />
						<group width="112" height="18" anchor="1 0.5" offset="-2 0" ><text id="value" text="" anchor="0.5 0.5" offset="0 0" font="text" color="#ffffff" /></group>
					</group>
					<!-- Auto fire (autoaim) -->
					<group id="hwp-opt-autofire" width="231" height="22" >
						<text id="title" text="" anchor="0 0.5" offset="4 0" font="text" color="#ffffff" />
						<scalebutton id="button" func="hwp-opt autofire" spriteset="scalebutton-regular" width="112" anchor="1 0.5" offset="-2 0" />
						<group width="112" height="18" anchor="1 0.5" offset="-2 0" ><text id="value" text="" anchor="0.5 0.5" offset="0 0" font="text" color="#ffffff" /></group>
					</group>
					<!-- Auto skill (autoaim) -->
					<group id="hwp-opt-autoskill" width="231" height="22" >
						<text id="title" text="" anchor="0 0.5" offset="4 0" font="text" color="#ffffff" />
						<scalebutton id="button" func="hwp-opt autoskill" spriteset="scalebutton-regular" width="112" anchor="1 0.5" offset="-2 0" />
						<group width="112" height="18" anchor="1 0.5" offset="-2 0" ><text id="value" text="" anchor="0.5 0.5" offset="0 0" font="text" color="#ffffff" /></group>
					</group>
				</group>
				<text id="hint" text="" anchor="0.5 1" offset="0 -8" font="text" color="#a6a6a6" />
			</group>
		</group>
	</doc>
</gui>
