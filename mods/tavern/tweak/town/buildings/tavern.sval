			<string name="prefab">prefabs/town/buildings/tavern/tavern_tier_3.pfb</string>

			<int name="cost-wood">150</int>
			<int name="cost-stone">30</int>
			<int name="cost-ore">10</int>
		</dict>

		<dict>
			<array name="conditionals"><a>
				<s>my town building</s><s>guild_hall</s><s>ge</s><i>7</i>
			</a></array>

			<string name="name">.building.tavern.name</string>
			<string name="description">.hwp.tavern.desc5</string>
			<string name="prefab">prefabs/town/buildings/tavern/tavern_tier_3.pfb</string>

			<int name="cost-wood">200</int>
			<int name="cost-stone">45</int>
			<int name="cost-ore">20</int>
