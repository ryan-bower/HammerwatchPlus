%include "players/skills_cost.inc"
<!--
	Static Charge (Aerotheurge passive). Every spell cast adds a static_charge stack
	(stacks_specs.sval, max 5, 10 s, reset by each new stack) and its first crit one more
	(HWPSpecsStaticCrit). At 5 stacks the next spell cast releases it (HWPSpecsStaticRelease,
	scripts/HWP/Specs/Invocation.as): 3 strikes of sc-dmg lightning split over up to 3 enemies
	within 120 of the wizard, x1.5 when all three hit one. The strikes are this skill's damage,
	so their crits never add a stack.
	Planner numbers: 50/70/90/120/150 a strike, the range 120.
	Orbs: Charged Font (sc-channel: 10/20% of max mana back on a release), Conduit
	(sc-conduit-lvl: +4/8% cast speed per stack, conduit_<lvl>_<stacks> kept on by the module).
-->
<dict>
	<string name="name">.hwp.specs.static_charge.name</string>
	<string name="type-name">.skills.type.passive</string>
	<string name="description">.hwp.specs.static_charge.desc</string>

	<array name="description-params">
		<array><s>damage</s><s>.hwp.specs.param.dmg_per_strike</s><s>50</s><s>70</s><s>90</s><s>120</s><s>150</s></array>
	</array>

	<array name="icon"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>48 24 24 24</vec4></array>

	<string name="id">hwp_wiz_static_charge</string>
	<array name="tags"><s>passive</s></array>
	<int name="starting-level">1</int>

	<dict name="skill">
		<int name="skill-cost">SKILLCOSTMASTERYLEVEL_1</int>
		<string name="class">Skills::PassiveSkill</string>
		<dict name="binds">
			<int name="sc-dmg">50</int>
			<float name="sc-channel">0</float>
			<int name="sc-conduit-lvl">0</int>
		</dict>
		<array name="modifiers">
			<array>
				<dict>
					<string name="class">Modifiers::SkillTriggerEffect</string>
					<string name="trigger">criticalhit</string>
					<string name="skill-type">spell</string>
					<string name="not-skill-id">hwp_wiz_static_charge</string>
					<vec2 name="chance">1 1</vec2>
					<bool name="target-self">true</bool>
					<array name="effects">
						<dict><string name="class">HWPSpecsStaticCrit</string></dict>
					</array>
				</dict>
				<dict>
					<string name="class">Modifiers::SkillTriggerEffect</string>
					<string name="trigger">castspell</string>
					<string name="skill-type">spell</string>
					<vec2 name="chance">1 1</vec2>
					<bool name="target-self">true</bool>
					<array name="effects">
						<dict>
							<string name="class">HWPSpecsStaticRelease</string>
							<string name="channel-bind">sc-channel</string>
							<dict name="zap">
								<int name="targets">3</int>
								<int name="radius">120</int>
								<float name="lone-mul">1.5</float>
								<string name="beam-fx">effects/generic/raycast/paladin_lightning_beam_1.effect</string>
								<array name="effects">
									<dict>
										<string name="class">Damage</string>
										<string name="lightning-bind">sc-dmg</string>
									</dict>
								</array>
							</dict>
						</dict>
					</array>
				</dict>
			</array>
		</array>
	</dict>

	<array name="upgrades">
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_2</int>
			<dict name="binds"><int name="sc-dmg">70</int></dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_3</int>
			<dict name="binds"><int name="sc-dmg">90</int></dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_4</int>
			<dict name="binds"><int name="sc-dmg">120</int></dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_5</int>
			<dict name="binds"><int name="sc-dmg">150</int></dict>
		</dict>
	</array>

	<array name="modifier-skills">
		<dict>
			<string name="name">.hwp.specs.charged_font.name</string>
			<string name="description">.hwp.specs.charged_font.desc</string>
			<array name="description-params">
				<array><s>mana</s><s>.skills.desc.params.restore.mana.max</s><s>10%</s><s>20%</s></array>
			</array>
			<array name="icon"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>144 24 24 24</vec4></array>
			<array name="tags"><s>passive</s></array>
			<string name="id">hwp_wiz_sc_static_channel</string>
			<string name="quality">uncommon</string>
			<int name="starting-level">0</int>
			<dict name="skill">
				<dict name="binds"><float name="sc-channel">0.1</float></dict>
			</dict>
			<array name="upgrades">
				<dict>
					<string name="quality">rare</string>
					<dict name="binds"><float name="sc-channel">0.2</float></dict>
				</dict>
			</array>
		</dict>
		<dict>
			<string name="name">.hwp.specs.conduit.name</string>
			<string name="description">.hwp.specs.conduit.desc</string>
			<array name="description-params">
				<array><s>cast-speed</s><s>.hwp.specs.param.cast_speed_per_stack</s><s>+4%</s><s>+8%</s></array>
			</array>
			<array name="icon"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>168 24 24 24</vec4></array>
			<array name="tags"><s>passive</s></array>
			<string name="id">hwp_wiz_sc_conduit</string>
			<string name="quality">uncommon</string>
			<int name="starting-level">0</int>
			<dict name="skill">
				<dict name="binds"><int name="sc-conduit-lvl">1</int></dict>
			</dict>
			<array name="upgrades">
				<dict>
					<string name="quality">rare</string>
					<dict name="binds"><int name="sc-conduit-lvl">2</int></dict>
				</dict>
			</array>
		</dict>
	</array>
</dict>
