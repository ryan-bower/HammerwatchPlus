<unit netsync="none">
	<!--
		Thunder Orb's orb (invocation/tempest_torrent.sval, HWPSpecsZap in
		scripts/HWP/Specs/Invocation.as). Slow (2.0 px a tick, about 60 px/s; 1.6 / 48 until
		2026-10-25, +25% as the user asked), through enemies (penetration 999, no hit effects),
		stopped by a wall (bounce speed 0: it stays and keeps zapping). Its body is a 3 px circle
		(6 until 2026-10-25) so a corner of the geometry snags it less; the look is bigger: the
		vanilla lightning ball at radius 5 (was 3) under orb.effect at 1.5x. HWPSpecsTtlAdd logs
		the speed and the time to live of every orb shot ("thunder orb: speed ..."). Every 250 ms: tt-zaps zaps of tt-dmg lightning within tt-radius (3 and 70; Lightning Rod
		raises both). Binds: tt-ttl (+tt-ttl-add, Lingering Storm), tt-overcharge (Focal Point),
		tt-clap (Thunderclap, on the way out). Sounds (art/specs/AUDIO.md): the static loop while
		it flies, one zap sound a tick that zaps anything, the blast with Thunderclap's burst.
	-->
	<behavior class="NewProjectile">
		<string name="anim">default</string>
		<float name="speed">2.0</float>
		<string name="ttl-bind">tt-ttl</string>
		<int name="penetration">999</int>
		<int name="bounces">999</int>
		<bool name="bounce-on-collide">true</bool>

		<array name="modifiers">
			<dict>
				<string name="class">Projectile::Speed</string>
				<float name="bounce-speed-mul">0</float>
				<vec2 name="speed-limits">0 10</vec2>
			</dict>
			<dict>
				<string name="class">Projectile::AttachedLoopingSound</string>
				<string name="sound">event:/sfx/player/classes/sorcerer/lightning_ball/lightning_ball_static_loop</string>
			</dict>
			<dict>
				<string name="class">HWPSpecsTtlAdd</string>
				<string name="add-bind">tt-ttl-add</string>
			</dict>
			<dict>
				<string name="class">Projectile::PeriodicEffect</string>
				<int name="freq">250</int>
				<array name="effects">
					<dict>
						<string name="class">HWPSpecsZap</string>
						<string name="targets-bind">tt-zaps</string>
						<string name="radius-bind">tt-radius</string>
						<string name="overcharge-bind">tt-overcharge</string>
						<int name="max-overcharge">10</int>
						<string name="sound">event:/sfx/player/classes/rogue/artificer_suit/artificer_suit_zap</string>
						<array name="effects">
							<dict>
								<string name="class">Damage</string>
								<string name="lightning-bind">tt-dmg</string>
							</dict>
						</array>
					</dict>
				</array>
			</dict>
		</array>

		<array name="destroyed-effects">
			<dict>
				<string name="class">HWPSpecsZap</string>
				<bool name="all">true</bool>
				<string name="radius-bind">tt-radius</string>
				<string name="mul-bind">tt-clap</string>
				<string name="hit-fx">effects/generic/explosions/lightning_explosion_1.effect</string>
				<string name="sound">event:/sfx/player/attacks/twohanded/lightning_blast</string>
				<array name="effects">
					<dict>
						<string name="class">Damage</string>
						<string name="lightning-bind">tt-dmg</string>
					</dict>
				</array>
			</dict>
		</array>

		<dict name="effect-params">
			<float name="height">6</float>
		</dict>
	</behavior>

	<scenes start="default">
		<scene name="default">
			<collision static="false">
				<circle radius="3" projectile="true" />
			</collision>
			<effect layer="0" src="effects/generic/projectiles/lightning_projectile_ball_2.effect?radius=5" />
			<effect layer="1" src="players/hwp/specs/effects/orb.effect" />
		</scene>
	</scenes>
</unit>
