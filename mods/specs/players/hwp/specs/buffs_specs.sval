<svals>
	<!--
		Buffs of the 4th specializations (mods/specs). A buff def never sees skill binds, so
		the strength of a scripted buff is its intensity: the scripts read the skill's binds
		and pass them in (scripts/HWP/Specs). HUD icons: players/hwp/specs/icons.png, 14x14
		at x 192+ on the spec's row (tools/make_specs_icons.py).
	-->

	<!-- Bannerlord: Battlefield Standard. damage taken x (1 - intensity); the standard
	     re-applies it every 250 ms to players in its radius (Bannerlord.as StandardPulse) -->
	<dict name="standard_dr">
		<bool name="debuff">false</bool>
		<int name="duration">600</int>
		<bool name="ignore-buff-scaling">true</bool>
		<vec2 name="dmg-taken-mul">1 0</vec2>
		<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>192 96 14 14</vec4></array>
	</dict>
	<dict name="standard_dr_planted">
		<bool name="debuff">false</bool>
		<int name="duration">600</int>
		<bool name="ignore-buff-scaling">true</bool>
		<vec2 name="dmg-taken-mul">1 0</vec2>
		<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>208 96 14 14</vec4></array>
	</dict>

	<!-- Bannerlord: Righteous Crusade on allies in the standard, buffs last longer -->
	%defblock Crusade LVL SCALE
	<dict name="crusade_%%LVL%%">
		<bool name="debuff">false</bool>
		<int name="duration">600</int>
		<bool name="ignore-buff-scaling">true</bool>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::BuffScaling</string>
				<vec2 name="buff-scale">%%SCALE%% %%SCALE%%</vec2>
			</dict>
		</array>
	</dict>
	%endblock

	%block Crusade 1 1.1
	%block Crusade 2 1.2
	%block Crusade 3 1.3
	%block Crusade 4 1.4
	%block Crusade 5 1.5

	<!-- Winddancer: Protective Gale. Evasion by level; the effect follows each player -->
	%defblock Gale LVL EVADE
	<dict name="gale_%%LVL%%">
		<bool name="debuff">false</bool>
		<int name="duration">6000</int>
		<string name="category">hwp_gale</string>
		<int name="category-level">%%LVL%%</int>
		<string name="fx">players/hwp/specs/effects/gale_buff.effect</string>
		<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>192 72 14 14</vec4></array>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::Evade</string>
				<float name="chance">%%EVADE%%</float>
			</dict>
		</array>
	</dict>
	%endblock

	%block Gale 1 0.15
	%block Gale 2 0.18
	%block Gale 3 0.21
	%block Gale 4 0.24
	%block Gale 5 0.3

	<!-- Winddancer: Tailwind (Protective Gale's orb), movement speed for the gale's time -->
	%defblock GaleTailwind LVL SPEED
	<dict name="gale_tailwind_%%LVL%%">
		<bool name="debuff">false</bool>
		<int name="duration">6000</int>
		<string name="category">hwp_gale_tailwind</string>
		<int name="category-level">%%LVL%%</int>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::SpeedMul</string>
				<float name="move-speed">%%SPEED%%</float>
			</dict>
		</array>
	</dict>
	%endblock

	%block GaleTailwind 1 1.1
	%block GaleTailwind 2 1.15
	%block GaleTailwind 3 1.2

	<!-- Winddancer: Lingering Breeze (Second Wind's orb), a heal every second for 4 s on
	     everyone a gust heals. A timed Heal: regeneration pauses after each hit taken -->
	%defblock Breeze LVL HEAL
	<dict name="breeze_%%LVL%%">
		<bool name="debuff">false</bool>
		<int name="duration">4000</int>
		<string name="category">hwp_breeze</string>
		<int name="category-level">%%LVL%%</int>
		<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>208 72 14 14</vec4></array>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::TimedTriggerEffect</string>
				<ivec2 name="freq">1000 1000</ivec2>
				<vec2 name="chance">1 1</vec2>
				<array name="effects">
					<dict>
						<string name="class">Heal</string>
						<int name="heal">%%HEAL%%</int>
					</dict>
				</array>
			</dict>
		</array>
	</dict>
	%endblock

	%block Breeze 1 2
	%block Breeze 2 4
	%block Breeze 3 6

	<!-- Winddancer: Shared Breath (Second Wind's orb). A teammate the gale reaches releases the
	     rogue's gust when they evade: gale_share_<heal>_<breeze>, picked by HWPSpecsShareBreath
	     (Winddancer.as) from the rogue's Second Wind. No HUD (the gale's shows). -->
	%defblock GaleShare HEAL BREEZE LVL BREEZEBUFF
	<dict name="gale_share_%%HEAL%%_%%BREEZE%%">
		<bool name="debuff">false</bool>
		<int name="duration">6000</int>
		<string name="category">hwp_gale_share</string>
		<int name="category-level">%%LVL%%</int>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::TriggerEffect</string>
				<string name="trigger">evade</string>
				<vec2 name="chance">1 1</vec2>
				<ivec2 name="timeout">4000 4000</ivec2>
				<bool name="target-self">true</bool>
				<array name="effects">
					<dict>
						<string name="class">PlaySound</string>
						<string name="sound">event:/sfx/actors/bosses/boss_warrior_spirit/dive_attack/dive_attack_healing_wave</string>
					</dict>
					<dict>
						<string name="class">Explode</string>
						<string name="fx">players/hwp/specs/effects/gust.effect?radius=80</string>
						<int name="radius">80</int>
						<int name="min-radius">80</int>
						<float name="dist-scaling">1000</float>
						<bool name="hit-self">true</bool>
						<bool name="hit-same-team">true</bool>
						<bool name="hit-different-team">false</bool>
						<array name="effects">
							<dict>
								<float name="self-dmg">1</float>
								<float name="team-dmg">1</float>
								<float name="enemy-dmg">0</float>
								<bool name="only-actors">true</bool>
							</dict>
							<dict>
								<string name="class">Heal</string>
								<int name="heal">%%HEAL%%</int>
							</dict>
							<dict>
								<string name="class">ApplyBuff</string>
								<string name="buff">%%BREEZEBUFF%%</string>
								<bool name="ignore-intensity">true</bool>
							</dict>
						</array>
					</dict>
				</array>
			</dict>
		</array>
	</dict>
	%endblock

	%block GaleShare 20 0 1 null
	%block GaleShare 20 1 2 players/hwp/specs/buffs_specs.sval:breeze_1
	%block GaleShare 20 2 3 players/hwp/specs/buffs_specs.sval:breeze_2
	%block GaleShare 20 3 4 players/hwp/specs/buffs_specs.sval:breeze_3
	%block GaleShare 30 0 5 null
	%block GaleShare 30 1 6 players/hwp/specs/buffs_specs.sval:breeze_1
	%block GaleShare 30 2 7 players/hwp/specs/buffs_specs.sval:breeze_2
	%block GaleShare 30 3 8 players/hwp/specs/buffs_specs.sval:breeze_3
	%block GaleShare 40 0 9 null
	%block GaleShare 40 1 10 players/hwp/specs/buffs_specs.sval:breeze_1
	%block GaleShare 40 2 11 players/hwp/specs/buffs_specs.sval:breeze_2
	%block GaleShare 40 3 12 players/hwp/specs/buffs_specs.sval:breeze_3
	%block GaleShare 50 0 13 null
	%block GaleShare 50 1 14 players/hwp/specs/buffs_specs.sval:breeze_1
	%block GaleShare 50 2 15 players/hwp/specs/buffs_specs.sval:breeze_2
	%block GaleShare 50 3 16 players/hwp/specs/buffs_specs.sval:breeze_3
	%block GaleShare 60 0 17 null
	%block GaleShare 60 1 18 players/hwp/specs/buffs_specs.sval:breeze_1
	%block GaleShare 60 2 19 players/hwp/specs/buffs_specs.sval:breeze_2
	%block GaleShare 60 3 20 players/hwp/specs/buffs_specs.sval:breeze_3
</svals>
