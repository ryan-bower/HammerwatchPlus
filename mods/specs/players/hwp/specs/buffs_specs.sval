<svals>
	<!--
		Buffs of the 4th specializations (mods/specs). A buff def never sees skill binds, so
		the strength of a scripted buff is its intensity: the scripts read the skill's binds
		and pass them in (scripts/HWP/Specs). HUD icons: players/hwp/specs/icons.png, 14x14
		at x 192+ on the spec's row (tools/make_specs_icons.py).
	-->

	<!-- Bannerlord: Battlefield Standard. damage taken x (1 - intensity); the standard
	     re-applies it every 250 ms to players in its radius (Bannerlord.as StandardPulse) -->
	<dict name="standard_dr">
		<bool name="debuff">false</bool>
		<int name="duration">600</int>
		<bool name="ignore-buff-scaling">true</bool>
		<vec2 name="dmg-taken-mul">1 0</vec2>
		<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>192 96 14 14</vec4></array>
	</dict>
	<!-- Deadeye, Wind Ward: gw-ward x Tailwind stacks less damage taken, as the intensity
	     (Stormbringer.as UpdateTailwind) -->
	<dict name="wind_ward">
		<bool name="debuff">false</bool>
		<int name="duration">600</int>
		<bool name="ignore-buff-scaling">true</bool>
		<vec2 name="dmg-taken-mul">1 0</vec2>
	</dict>
	<dict name="standard_dr_planted">
		<bool name="debuff">false</bool>
		<int name="duration">600</int>
		<bool name="ignore-buff-scaling">true</bool>
		<vec2 name="dmg-taken-mul">1 0</vec2>
		<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>208 96 14 14</vec4></array>
	</dict>

	<!-- Bannerlord: Righteous Crusade on allies in the standard, buffs last longer -->
	%defblock Crusade LVL SCALE
	<dict name="crusade_%%LVL%%">
		<bool name="debuff">false</bool>
		<int name="duration">600</int>
		<bool name="ignore-buff-scaling">true</bool>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::BuffScaling</string>
				<vec2 name="buff-scale">%%SCALE%% %%SCALE%%</vec2>
			</dict>
		</array>
	</dict>
	%endblock

	%block Crusade 1 1.1
	%block Crusade 2 1.2
	%block Crusade 3 1.3
	%block Crusade 4 1.4
	%block Crusade 5 1.5

	<!-- Winddancer: Protective Gale. Evasion by level; the effect follows each player -->
	%defblock Gale LVL EVADE
	<dict name="gale_%%LVL%%">
		<bool name="debuff">false</bool>
		<int name="duration">6000</int>
		<string name="category">hwp_gale</string>
		<int name="category-level">%%LVL%%</int>
		<string name="fx">players/hwp/specs/effects/gale_buff.effect</string>
		<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>192 72 14 14</vec4></array>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::Evade</string>
				<float name="chance">%%EVADE%%</float>
			</dict>
		</array>
	</dict>
	%endblock

	%block Gale 1 0.15
	%block Gale 2 0.18
	%block Gale 3 0.21
	%block Gale 4 0.24
	%block Gale 5 0.3

	<!-- Winddancer: Tailwind (Protective Gale's orb), movement speed for the gale's time -->
	%defblock GaleTailwind LVL SPEED
	<dict name="gale_tailwind_%%LVL%%">
		<bool name="debuff">false</bool>
		<int name="duration">6000</int>
		<string name="category">hwp_gale_tailwind</string>
		<int name="category-level">%%LVL%%</int>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::SpeedMul</string>
				<float name="move-speed">%%SPEED%%</float>
			</dict>
		</array>
	</dict>
	%endblock

	%block GaleTailwind 1 1.1
	%block GaleTailwind 2 1.15
	%block GaleTailwind 3 1.2

	<!-- Winddancer: Lingering Breeze (Second Wind's orb), a heal every second for 4 s on
	     everyone a gust heals. A timed Heal: regeneration pauses after each hit taken -->
	%defblock Breeze LVL HEAL
	<dict name="breeze_%%LVL%%">
		<bool name="debuff">false</bool>
		<int name="duration">4000</int>
		<string name="category">hwp_breeze</string>
		<int name="category-level">%%LVL%%</int>
		<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>208 72 14 14</vec4></array>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::TimedTriggerEffect</string>
				<ivec2 name="freq">1000 1000</ivec2>
				<vec2 name="chance">1 1</vec2>
				<array name="effects">
					<dict>
						<string name="class">Heal</string>
						<int name="heal">%%HEAL%%</int>
					</dict>
				</array>
			</dict>
		</array>
	</dict>
	%endblock

	%block Breeze 1 2
	%block Breeze 2 4
	%block Breeze 3 6

	<!-- Winddancer: Shared Breath (Second Wind's orb). A teammate the gale reaches releases the
	     rogue's gust when they evade: gale_share_<heal>_<breeze>, picked by HWPSpecsShareBreath
	     (Winddancer.as) from the rogue's Second Wind. No HUD (the gale's shows). -->
	%defblock GaleShare HEAL BREEZE LVL BREEZEBUFF
	<dict name="gale_share_%%HEAL%%_%%BREEZE%%">
		<bool name="debuff">false</bool>
		<int name="duration">6000</int>
		<string name="category">hwp_gale_share</string>
		<int name="category-level">%%LVL%%</int>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::TriggerEffect</string>
				<string name="trigger">evade</string>
				<vec2 name="chance">1 1</vec2>
				<ivec2 name="timeout">4000 4000</ivec2>
				<bool name="target-self">true</bool>
				<array name="effects">
					<dict>
						<string name="class">PlaySound</string>
						<string name="sound">event:/sfx/player/classes/ranger/wind_weaver/wind_weaver_hit</string>
					</dict>
					<dict>
						<string name="class">Explode</string>
						<string name="fx">players/hwp/specs/effects/gust.effect?radius=80</string>
						<int name="radius">80</int>
						<int name="min-radius">80</int>
						<float name="dist-scaling">1000</float>
						<bool name="hit-self">true</bool>
						<bool name="hit-same-team">true</bool>
						<bool name="hit-different-team">false</bool>
						<array name="effects">
							<dict>
								<float name="self-dmg">1</float>
								<float name="team-dmg">1</float>
								<float name="enemy-dmg">0</float>
								<bool name="only-actors">true</bool>
							</dict>
							<dict>
								<string name="class">Heal</string>
								<int name="heal">%%HEAL%%</int>
							</dict>
							<dict>
								<string name="class">ApplyBuff</string>
								<string name="buff">%%BREEZEBUFF%%</string>
								<bool name="ignore-intensity">true</bool>
							</dict>
						</array>
					</dict>
				</array>
			</dict>
		</array>
	</dict>
	%endblock

	%block GaleShare 20 0 1 null
	%block GaleShare 20 1 2 players/hwp/specs/buffs_specs.sval:breeze_1
	%block GaleShare 20 2 3 players/hwp/specs/buffs_specs.sval:breeze_2
	%block GaleShare 20 3 4 players/hwp/specs/buffs_specs.sval:breeze_3
	%block GaleShare 30 0 5 null
	%block GaleShare 30 1 6 players/hwp/specs/buffs_specs.sval:breeze_1
	%block GaleShare 30 2 7 players/hwp/specs/buffs_specs.sval:breeze_2
	%block GaleShare 30 3 8 players/hwp/specs/buffs_specs.sval:breeze_3
	%block GaleShare 40 0 9 null
	%block GaleShare 40 1 10 players/hwp/specs/buffs_specs.sval:breeze_1
	%block GaleShare 40 2 11 players/hwp/specs/buffs_specs.sval:breeze_2
	%block GaleShare 40 3 12 players/hwp/specs/buffs_specs.sval:breeze_3
	%block GaleShare 50 0 13 null
	%block GaleShare 50 1 14 players/hwp/specs/buffs_specs.sval:breeze_1
	%block GaleShare 50 2 15 players/hwp/specs/buffs_specs.sval:breeze_2
	%block GaleShare 50 3 16 players/hwp/specs/buffs_specs.sval:breeze_3
	%block GaleShare 60 0 17 null
	%block GaleShare 60 1 18 players/hwp/specs/buffs_specs.sval:breeze_1
	%block GaleShare 60 2 19 players/hwp/specs/buffs_specs.sval:breeze_2
	%block GaleShare 60 3 20 players/hwp/specs/buffs_specs.sval:breeze_3

	<!-- Invocation: Conduit (Static Charge's orb), cast speed per Static Charge stack, orb
	     level x stacks; the module keeps the current one on (Invocation.as UpdateConduit) -->
	%defblock Conduit LVL N SPEED
	<dict name="conduit_%%LVL%%_%%N%%">
		<bool name="debuff">false</bool>
		<int name="duration">600</int>
		<bool name="ignore-buff-scaling">true</bool>
		<string name="category">hwp_conduit</string>
		<int name="category-level">%%N%%</int>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::SpeedMul</string>
				<float name="cast-speed">%%SPEED%%</float>
			</dict>
		</array>
	</dict>
	%endblock

	%block Conduit 1 1 1.04
	%block Conduit 1 2 1.08
	%block Conduit 1 3 1.12
	%block Conduit 1 4 1.16
	%block Conduit 1 5 1.2
	%block Conduit 2 1 1.08
	%block Conduit 2 2 1.16
	%block Conduit 2 3 1.24
	%block Conduit 2 4 1.32
	%block Conduit 2 5 1.4
	<!-- Deadeye: Gathering Winds' speed, move, attack and cast speed per Tailwind stack by the
	     skill level (2/2.5/3/3.5/4%) x stacks; the module keeps the current one on
	     (Stormbringer.as UpdateTailwind) -->
	%defblock Tailwind LVL N SPEED
	<dict name="tailwind_%%LVL%%_%%N%%">
		<bool name="debuff">false</bool>
		<int name="duration">600</int>
		<bool name="ignore-buff-scaling">true</bool>
		<string name="category">hwp_tailwind</string>
		<int name="category-level">%%N%%</int>
		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::SpeedMul</string>
				<float name="move-speed">%%SPEED%%</float>
				<float name="attack-speed">%%SPEED%%</float>
				<float name="cast-speed">%%SPEED%%</float>
			</dict>
		</array>
	</dict>
	%endblock

	%block Tailwind 1 1 1.02
	%block Tailwind 1 2 1.04
	%block Tailwind 1 3 1.06
	%block Tailwind 1 4 1.08
	%block Tailwind 1 5 1.1
	%block Tailwind 2 1 1.025
	%block Tailwind 2 2 1.05
	%block Tailwind 2 3 1.075
	%block Tailwind 2 4 1.1
	%block Tailwind 2 5 1.125
	%block Tailwind 3 1 1.03
	%block Tailwind 3 2 1.06
	%block Tailwind 3 3 1.09
	%block Tailwind 3 4 1.12
	%block Tailwind 3 5 1.15
	%block Tailwind 4 1 1.035
	%block Tailwind 4 2 1.07
	%block Tailwind 4 3 1.105
	%block Tailwind 4 4 1.14
	%block Tailwind 4 5 1.175
	%block Tailwind 5 1 1.04
	%block Tailwind 5 2 1.08
	%block Tailwind 5 3 1.12
	%block Tailwind 5 4 1.16
	%block Tailwind 5 5 1.2
	<!-- Branding: the Pyrebrand on an enemy, kept on by UpdateBrands (scripts/HWP/Specs/Branding.as) -->
	<dict name="pyrebrand">
		<bool name="debuff">true</bool>
		<int name="duration">400</int>
		<string name="fx">players/hwp/specs/effects/branded_sigil.effect</string>
		<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>192 120 14 14</vec4></array>
	</dict>
	<!-- Devil Forgemaster: the Necrotic Resurrection / Sacrificial Penance channel (3 s, an
	     elite's body 5 s, a boss's 10 s; the duration is given by the script). The rotation is
	     locked too (the user, 2026-10-25: locked onto the body; Forgemaster.as LockOn sets the facing) -->
	<dict name="raising">
		<bool name="debuff">false</bool>
		<int name="duration">3000</int>
		<bool name="ignore-buff-scaling">true</bool>
		<bool name="silence">true</bool>
		<bool name="disarm">true</bool>
		<bool name="lock-movement">true</bool>
		<bool name="lock-rotation">true</bool>
		<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>24 144 14 14</vec4></array>
	</dict>
	<!-- Devil Forgemaster: the Penance channel's stance, under the body facing up: the rotation
	     locked for the channel (the raising buff roots and silences) -->
	<dict name="penance_stance">
		<bool name="debuff">false</bool>
		<int name="duration">3000</int>
		<bool name="ignore-buff-scaling">true</bool>
		<bool name="lock-rotation">true</bool>
	</dict>
	<!-- Devil Forgemaster: eating an intact body after a Heresy lunge: 3 s rooted, facing the body
	     (rotation locked), silenced and disarmed, 30% of the maximum health regenerated a second
	     (HWPSpecsMaxHealthRegen, Forgemaster.as) -->
	<dict name="devouring">
		<bool name="debuff">true</bool>
		<int name="duration">3000</int>
		<bool name="ignore-buff-scaling">true</bool>
		<bool name="silence">true</bool>
		<bool name="disarm">true</bool>
		<bool name="lock-movement">true</bool>
		<bool name="lock-rotation">true</bool>
		<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>224 144 14 14</vec4></array>
		<array name="modifiers">
			<dict>
				<string name="class">HWPSpecsMaxHealthRegen</string>
				<float name="pct">0.3</float>
			</dict>
		</array>
	</dict>
	<!-- Generosity, Pelor's Fury on its target (Generosity.as StartFury; intensity = pf-dmg): stunned
	     (rooted, disarmed, silenced: a boss's attack is cancelled, CompositeActorBehavior.ApplyBuff),
	     armor and resistances 0 (armor-mul / resistance-mul are lerped by the intensity, so 0 0 is
	     0 at any), damage taken lerp(1, 2, pf-dmg) = 1 + pf-dmg. No tags: no stun immunity
	     (buff-immune-tags) or ResistBuffSkill refuses it. The duration is pf-stun, passed in. -->
	<dict name="pelors_fury">
		<bool name="debuff">true</bool>
		<int name="duration">3000</int>
		<bool name="ignore-buff-scaling">true</bool>
		<string name="icon">special/icons/stun.unit</string>
		<vec2 name="speed-mul">0 0</vec2>
		<bool name="disarm">true</bool>
		<bool name="silence">true</bool>
		<bool name="lock-movement">true</bool>
		<bool name="lock-rotation">true</bool>
		<vec2 name="armor-mul">0 0</vec2>
		<vec2 name="resistance-mul">0 0</vec2>
		<vec2 name="dmg-taken-mul">1 2</vec2>
	</dict>
	<!-- Generosity: the caster in a party, held for Pelor's Fury's stun (Generosity.as; the dash
	     is pinned on cooldown for it, as the Forgemaster's channel does) -->
	<dict name="pelors_channel">
		<bool name="debuff">false</bool>
		<int name="duration">3000</int>
		<bool name="ignore-buff-scaling">true</bool>
		<bool name="silence">true</bool>
		<bool name="disarm">true</bool>
		<bool name="lock-movement">true</bool>
		<bool name="lock-rotation">true</bool>
		<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>192 168 14 14</vec4></array>
	</dict>
</svals>
