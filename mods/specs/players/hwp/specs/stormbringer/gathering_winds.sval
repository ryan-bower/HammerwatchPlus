%include "players/skills_cost.inc"
<!--
	Gathering Winds (Deadeye passive). Every 5 kills add a Tailwind stack (HWPSpecsKillTailwind,
	scripts/HWP/Specs/Stormbringer.as), up to 5, each lasting 4 s on its own. Each stack is
	gw-lvl's tailwind_<lvl>_<n> buff: 2/2.5/3/3.5/4% move, attack and cast speed per stack.
	Orbs: Gale Force (gw-gale: at 5 stacks, bow and crossbow attacks shoot +1/+2 arrows, the
	vanilla arrow at half the weapon's damage, assumed), Wind Ward (gw-ward: 1.5/3% less damage
	taken per stack, wind_ward kept on by the module).
-->
<dict>
	<string name="name">.hwp.specs.gathering_winds.name</string>
	<string name="type-name">.skills.type.passive</string>
	<string name="description">.hwp.specs.gathering_winds.desc</string>

	<array name="description-params">
		<array><s>speed</s><s>.hwp.specs.param.speed_per_stack</s><s>2%</s><s>2.5%</s><s>3%</s><s>3.5%</s><s>4%</s></array>
	</array>

	<array name="icon"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>48 0 24 24</vec4></array>

	<string name="id">hwp_ran_gathering_winds</string>
	<array name="tags"><s>passive</s></array>
	<int name="starting-level">1</int>

	<dict name="skill">
		<int name="skill-cost">SKILLCOSTMASTERYLEVEL_1</int>
		<string name="class">Skills::PassiveSkill</string>
		<dict name="binds">
			<int name="gw-lvl">1</int>
			<int name="gw-gale">0</int>
			<float name="gw-ward">0</float>
		</dict>
		<array name="modifiers">
			<array>
				<dict>
					<string name="class">Modifiers::TriggerEffect</string>
					<string name="trigger">kill</string>
					<vec2 name="chance">1 1</vec2>
					<bool name="target-self">true</bool>
					<array name="effects">
						<dict><string name="class">HWPSpecsKillTailwind</string></dict>
					</array>
				</dict>
				<dict>
					<string name="class">Modifiers::SkillTriggerEffect</string>
					<string name="trigger">attack</string>
					<bool name="override-skill-info">true</bool>
					<array name="skill-tags"><s>bow</s><s>crossbow</s></array>
					<vec2 name="chance">1 1</vec2>
					<bool name="target-self">true</bool>
					<array name="effects">
						<dict>
							<string name="class">HWPSpecsGaleForce</string>
							<string name="projectile">players/projectiles/arrow.unit</string>
							<string name="extra-bind">gw-gale</string>
							<int name="spread">10</int>
						</dict>
					</array>
				</dict>
			</array>
		</array>
	</dict>

	<array name="upgrades">
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_2</int>
			<dict name="binds"><int name="gw-lvl">2</int></dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_3</int>
			<dict name="binds"><int name="gw-lvl">3</int></dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_4</int>
			<dict name="binds"><int name="gw-lvl">4</int></dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_5</int>
			<dict name="binds"><int name="gw-lvl">5</int></dict>
		</dict>
	</array>

	<array name="modifier-skills">
		<dict>
			<string name="name">.hwp.specs.gale_force.name</string>
			<string name="description">.hwp.specs.gale_force.desc</string>
			<array name="description-params">
				<array><s>arrows</s><s>.hwp.specs.param.extra_arrows</s><s>+1</s><s>+2</s></array>
			</array>
			<array name="icon"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>144 0 24 24</vec4></array>
			<array name="tags"><s>passive</s></array>
			<string name="id">hwp_ran_gw_gale_force</string>
			<string name="quality">uncommon</string>
			<int name="starting-level">0</int>
			<dict name="skill">
				<dict name="binds"><int name="gw-gale">1</int></dict>
			</dict>
			<array name="upgrades">
				<dict>
					<string name="quality">rare</string>
					<dict name="binds"><int name="gw-gale">2</int></dict>
				</dict>
			</array>
		</dict>
		<dict>
			<string name="name">.hwp.specs.wind_ward.name</string>
			<string name="description">.hwp.specs.wind_ward.desc</string>
			<array name="description-params">
				<array><s>dr</s><s>.hwp.specs.param.dr_per_stack</s><s>1.5%</s><s>3%</s></array>
			</array>
			<array name="icon"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>168 0 24 24</vec4></array>
			<array name="tags"><s>passive</s></array>
			<string name="id">hwp_ran_gw_wind_ward</string>
			<string name="quality">uncommon</string>
			<int name="starting-level">0</int>
			<dict name="skill">
				<dict name="binds"><float name="gw-ward">0.015</float></dict>
			</dict>
			<array name="upgrades">
				<dict>
					<string name="quality">rare</string>
					<dict name="binds"><float name="gw-ward">0.03</float></dict>
				</dict>
			</array>
		</dict>
	</array>
</dict>
