<loader>ActorBuffStackDef::LoadMultiple</loader>
<!--
	Stacks of the 4th specializations (mods/specs). HUD icons: players/hwp/specs/icons.png.
-->
<array>
	<!-- Bannerlord, Shared Provisions: 1% cooldown reduction per stack. The module sets the
	     count every 500 ms from the buffs on the party (Bannerlord.as UpdateProvisions). -->
	<dict>
		<string name="id">provisions</string>
		<string name="name">.hwp.specs.stack.provisions.name</string>
		<string name="description">.hwp.specs.stack.provisions.desc</string>
		<int name="max">100</int>
		<bool name="extrapolate-intensity">true</bool>
		<dict name="buff">
			<bool name="debuff">false</bool>
			<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>224 96 14 14</vec4></array>
			<array name="modifiers">
				<dict>
					<string name="class">Modifiers::BaseSkillModifier</string>
					<vec2 name="cooldown-mul">1 0.99</vec2>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- Aerotheurge, Static Charge: a stack per spell cast and one more for its first crit
	     (Invocation.as HWPSpecsStaticRelease / HWPSpecsStaticCrit), released at 5 by the next
	     spell. 10 s, every new stack resets the timer. -->
	<dict>
		<string name="id">static_charge</string>
		<string name="name">.hwp.specs.stack.static_charge.name</string>
		<string name="description">.hwp.specs.stack.static_charge.desc</string>
		<int name="max">5</int>
		<bool name="display-timer-radius">true</bool>
		<dict name="timer">
			<int name="time">10000</int>
			<int name="add-stack">-999</int>
			<bool name="gain-set">true</bool>
			<bool name="add-set">true</bool>
			<bool name="gain-reset">true</bool>
			<bool name="add-reset">true</bool>
		</dict>
		<dict name="buff">
			<bool name="debuff">false</bool>
			<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>192 24 14 14</vec4></array>
		</dict>
	</dict>
	<!-- Deadeye, Gathering Winds: a stack per 5 kills, each one 4 s on its own (Stormbringer.as
	     g_twExp; this timer, a little longer, only catches a stalled script and shows the
	     newest). The speed is the tailwind_<lvl>_<n> buff (buffs_specs.sval), not the stack. -->
	<dict>
		<string name="id">tailwind</string>
		<string name="name">.hwp.specs.stack.tailwind.name</string>
		<string name="description">.hwp.specs.stack.tailwind.desc</string>
		<int name="max">5</int>
		<bool name="display-timer-radius">true</bool>
		<dict name="timer">
			<int name="time">4100</int>
			<int name="add-stack">-999</int>
			<bool name="gain-set">true</bool>
			<bool name="add-set">true</bool>
			<bool name="sub-set">true</bool>
			<bool name="gain-reset">true</bool>
			<bool name="add-reset">true</bool>
			<bool name="sub-reset">true</bool>
		</dict>
		<dict name="buff">
			<bool name="debuff">false</bool>
			<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>192 0 14 14</vec4></array>
		</dict>
	</dict>
	<!-- Devil Forgemaster, Heresy: a stack per Necrotic Resurrection (1, elite 2, boss 3;
	     Forgemaster.as). No timer: it carries from floor to floor and resets in town. Max 8: a
	     raise below 5 may overshoot (a boss at 4 makes 7). Lowered only by Sacrificial Penance
	     and the Pyre Sacrifice orb. The icon swaps to hud_heresy_5 at 5+ (UpdateForgemaster). -->
	<dict>
		<string name="id">heresy</string>
		<string name="name">.hwp.specs.stack.heresy.name</string>
		<string name="description">.hwp.specs.stack.heresy.desc</string>
		<int name="max">8</int>
		<dict name="buff">
			<bool name="debuff">true</bool>
			<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>192 144 14 14</vec4></array>
		</dict>
	</dict>
	<!-- Generosity, Pelor's Blessing: gained from Lay on Hands, Blessed Strike kills and Conviction
	     (Generosity.as GainBlessing; a 2 s cooldown shared by every source). No timer: it carries
	     from floor to floor; reset by a party player's death, by casting Pelor's Fury and in town.
	     The intensity is the stack count (extrapolate-intensity): HWPGenPentival reads it for
	     Descendent of Pentival. -->
	<dict>
		<string name="id">pelors_blessing</string>
		<string name="name">.hwp.specs.stack.pelors_blessing.name</string>
		<string name="description">.hwp.specs.stack.pelors_blessing.desc</string>
		<int name="max">10</int>
		<bool name="extrapolate-intensity">true</bool>
		<dict name="buff">
			<bool name="debuff">false</bool>
			<array name="hud"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>192 168 14 14</vec4></array>
			<array name="modifiers">
				<dict>
					<string name="class">HWPGenPentival</string>
				</dict>
				<dict>
					<string name="class">HWPGenPentivalLeech</string>
				</dict>
			</array>
		</dict>
	</dict>
</array>
