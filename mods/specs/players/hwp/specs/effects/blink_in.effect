<effect looping="false">
<!-- Arcane's Blink: the arrival where the sorcerer lands (HWPSpecsBlink). The ring collapses
     onto the landing point, a bright flash pops, speckles rush inward and a blue glow lingers.
     Hand-written; the vanilla magic_blink textures and particle units. -->
	<param name="cR" default="0.45" />
	<param name="cG" default="0.55" />
	<param name="cB" default="1" />

	%//the ring collapsing
	<sprite origin="128 128" looping="false" texture="effects/lights/radial_jagged_ring_L.png" material="effects/effects.mats:add"
		scale-x="0.4*(1-t)+0.06"
		scale-y="0.2*(1-t)+0.03"
		pos-y="-4"
		angle="-t*1.5"
		color-r="cR"
		color-g="cG"
		color-b="cB"
		color-a="0.9*saturate(t*3)*(1-pow(t,3))"
		>
		<frame time="350">0 0 256 256</frame>
	</sprite>
	%//the pop
	<sprite origin="128 128" looping="false" texture="effects/lights/lens_flash_L.png" material="effects/effects.mats:add"
		scale-x="0.1+0.25*t"
		scale-y="0.1+0.25*t"
		pos-y="-10"
		angle="-t*pi"
		color-r="1"
		color-g="1"
		color-b="1"
		color-a="1-t"
		>
		<frame time="300">0 0 256 256</frame>
	</sprite>
	<sprite origin="128 128" looping="false" texture="effects/lights/god_ray_radial_point_L.png" material="effects/effects.mats:add"
		scale-x="0.3*(1-t)+0.1"
		scale-y="0.3*(1-t)+0.1"
		pos-y="-10"
		angle="rand(u)*6.28-t*2.5"
		color-r="cR"
		color-g="cG"
		color-b="cB"
		color-a="0.7*(1-t)"
		>
		<frame time="350">0 0 256 256</frame>
	</sprite>

	<light pos-x="0" pos-y="-10">
		<sprite texture="effects/lights/light2_L.png">
			<frame time="450">0 0 128 128</frame>
		</sprite>
		<looping value="false" />
		<length value="450" />
		<cast-shadows value="false" />
		<size value="110-50*t" />
		<color-r value="cR*2*(1-t)" />
		<color-g value="cG*2*(1-t)" />
		<color-b value="cB*2*(1-t)" />
		<color-a value="0.2*(1-t)" />
	</light>

	%//speckles rushing in
	<particle_spawner
		layer="1"
		spawn-rate="140*(1-t)"
		length="250"
		looping="false"
		ttl="rpick(250,450)"
		pos="0;-8;0"
		color-mul="cR*3;cG*3;cB*3;1"
		force-damping="1"
		>
		<behaviors>
			<spread_range radius="rpick(14,26)"/>
			<force_toward pos="0;-8;0" mul="0.35"/>
			<fade_to a="0"/>
		</behaviors>
		<particle src="effects/subeffects/particles_speckles.unit:single_white_add"/>
	</particle_spawner>
	%//a puff of blue smoke settling
	<particle_spawner
		layer="1"
		spawn-rate="80*(1-t)"
		length="300"
		looping="false"
		ttl="rpick(400,800)"
		angle="rpick(-pi,pi)"
		pos="0;-6;0"
		color-mul="cR;cG;cB;0.5"
		rot-speed="rpick(-1.5,1.5)"
		force-damping="6"
		>
		<behaviors>
			<spread_range radius="rpick(1,7)"/>
			<force_dir dir="rpick(-0.6,0.6);rpick(-0.9,-0.2);0"/>
			<fade_to a="0"/>
		</behaviors>
		<particle src="effects/subeffects/particles_grayscale.unit:smoke_dissolve_1_medium"/>
	</particle_spawner>
</effect>
