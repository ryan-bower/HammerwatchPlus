<effect looping="false">
<!-- Arcane's Blink: the vanish at the start point (HWPSpecsBlink, scripts/HWP/Specs/Arcane.as;
     the user, 2026-10-25: Blink needs a visible effect). A blue ring that bursts outward, a
     flash that lifts off the sorcerer, a spinning ray burst, blue smoke and speckles blown out.
     Lights, textures and particle units are the vanilla magic_blink / arcane_explosion_1 ones.
     Hand-written. -->
	<param name="cR" default="0.45" />
	<param name="cG" default="0.55" />
	<param name="cB" default="1" />

	%//the ring bursting outward
	<sprite origin="128 128" looping="false" texture="effects/lights/radial_jagged_ring_L.png" material="effects/effects.mats:add"
		scale-x="0.08+0.32*t"
		scale-y="0.04+0.16*t"
		pos-y="-4"
		angle="t*1.5"
		color-r="cR"
		color-g="cG"
		color-b="cB"
		color-a="0.9*(1-t)"
		>
		<frame time="350">0 0 256 256</frame>
	</sprite>
	%//the flash lifting off
	<sprite origin="128 128" looping="false" texture="effects/lights/lens_flash_L.png" material="effects/effects.mats:add"
		scale-x="0.22*sin(t*pi)"
		scale-y="0.22*sin(t*pi)"
		pos-y="-10-26*t"
		angle="t*pi"
		color-r="1"
		color-g="1"
		color-b="1"
		color-a="saturate(sin(t*pi)*1.5)"
		>
		<frame time="350">0 0 256 256</frame>
	</sprite>
	%//the spinning ray burst
	<sprite origin="128 128" looping="false" texture="effects/lights/god_ray_radial_point_L.png" material="effects/effects.mats:add"
		scale-x="0.12+0.2*t"
		scale-y="0.12+0.2*t"
		pos-y="-10"
		angle="rand(u)*6.28+t*2.5"
		color-r="cR"
		color-g="cG"
		color-b="cB"
		color-a="0.6*(1-t)"
		>
		<frame time="350">0 0 256 256</frame>
	</sprite>

	<light pos-x="0" pos-y="-10">
		<sprite texture="effects/lights/light2_L.png">
			<frame time="350">0 0 128 128</frame>
		</sprite>
		<looping value="false" />
		<length value="350" />
		<cast-shadows value="false" />
		<size value="48+56*t" />
		<color-r value="cR*2*sin(t*pi)" />
		<color-g value="cG*2*sin(t*pi)" />
		<color-b value="cB*2*sin(t*pi)" />
		<color-a value="0.15*(1-t)" />
	</light>

	%//blue smoke blown outward
	<particle_spawner
		layer="1"
		spawn-rate="160*(1-t)"
		length="250"
		looping="false"
		ttl="rpick(400,700)"
		angle="rpick(-pi,pi)"
		pos="0;-8;0"
		color-mul="cR;cG;cB;0.6"
		rot-speed="rpick(-2,2)"
		rot-damping="2"
		force-damping="4"
		>
		<behaviors>
			<spread_range radius="rpick(2,8)"/>
			<force_dir dir="rpick(-1.2,1.2);rpick(-1.2,1.2);0"/>
			<fade_to a="0"/>
		</behaviors>
		<particle src="effects/subeffects/particles_grayscale.unit:smoke_dissolve_1_medium"/>
	</particle_spawner>
	%//speckles
	<particle_spawner
		layer="1"
		spawn-rate="90"
		length="250"
		looping="false"
		ttl="rpick(300,600)"
		pos="0;-8;0"
		color-mul="cR*3;cG*3;cB*3;1"
		curl-speed="3"
		curl-scale="1"
		force-damping="2"
		>
		<behaviors>
			<spread_range radius="rpick(0,6)"/>
			<force_dir dir="rpick(-1.5,1.5);rpick(-1.5,1.5);0"/>
			<fade_to a="0"/>
		</behaviors>
		<particle src="effects/subeffects/particles_speckles.unit:single_white_add"/>
	</particle_spawner>
</effect>
