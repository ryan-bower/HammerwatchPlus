<effect layer="-1">
<!-- Devil Forgemaster: the golden light out of a body during a Sacrificial Penance channel. Pulsed
     every 150 ms by Forgemaster.as UpdatePenanceStance with scale rising 0.3 -> 1.5 over the
     channel, so the overlapping pulses grow brighter and wider as it runs. A gold take on the
     body_glow sparkle over a warm light. -->
	<param name="scale" default="1" />
	<sprite looping="false" origin="24 24" layer="-4" texture="effects/spritesheets/effects.png" material="system/default.mats:default-simple"
			scale-x="0.25*scale"
			scale-y="0.25*scale"
			color-r="1"
			color-g="0.85"
			color-b="0.4"
			color-a="0.3*scale"
			angle="rand(u)*pi*2"
			pos-x="-6+12*rand(u+1)"
			pos-y="-10+8*rand(u+2)"
			>
			<frame time="90" x="365" y="768" w="48" h="48" />
			<frame time="90" x="414" y="768" w="48" h="48" />
			<frame time="90" x="463" y="768" w="48" h="48" />
	</sprite>
	<light>
		<sprite texture="system/default_L.png">
			<frame time="270">0 0 128 128</frame>
		</sprite>
		<looping value="false" />
		<length value="270" />
		<cast-shadows value="false" />
		<shadow-cast-pos-x value="0" />
		<shadow-cast-pos-y value="0" />
		<shadow-cast-pos-jitter value="0 0 0 0" />
		<size value="64" />
		<color-r value="0.9"/>
		<color-g value="0.7"/>
		<color-b value="0.25"/>
		<color-a value="0.0"/>
	</light>
</effect>
