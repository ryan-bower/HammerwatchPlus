<effect looping="false">
<!-- Pelor's Fury strike (mods/specs, Generosity.as): the scepter smite of the priest's quick light
     strike (effects/generic/attacks/scepter_smite.effect), its light shaft scaled by `scale`. -->
<!-- COLORS -->
	<param name="cR" default="0.9" />
    <param name="cG" default="0.6" />
    <param name="cB" default="0.1" />
	<param name="cA" default="1" />
	
<!-- COMMON CALCS -->
	%replace "t_out" "sin(t*pi/2)"
	%replace "t_in" "(t*t)"
	%replace "t_sin" "sin(t*pi)"
	%replace "t_sin_off" "sin(saturate((t-0.4)/0.6)*pi)"
	%replace "t_sin_out" "sin(sin(t*pi/2)*pi)"
	%replace "t_step" "smoothstep(t,0,1)"	
	
<!-- TWEAKS -->
	<param name="lightshaft" default="1" />
	<param name="radius" default="8" />
	<param name="scale" default="1" />
	
<!-- SHOCKWAVE -->
	<sprite looping="false" origin="80 80" texture="players/wizard/effects/arcane_blast_fire.png" material="system/default.mats:bright"
		scale-x="radius / 64 * pow(t,0.15)"
		scale-y="radius / 64 * pow(t,0.15)"
		angle="1*(pi/9*t)"
		color-r="1.5"
		color-g="1.5"
		color-b="3"
		color-a="1-1*t_out"
	>
		<frame time="400">640 0 160 160</frame>
	</sprite>

<!-- RINGS -->	
	<sprite looping="false" origin="80 80" texture="players/wizard/effects/arcane_blast_fire.png" material="system/default.mats:add"
		scale-x="(radius / 64 * pow(it,0.05))*(0.75+0.25*it)"
		scale-y="(radius / 64 * pow(it,0.05))*(0.75+0.25*it)"
		color-a="0.4*it*(1-pow(it,8))"
		angle="1*(pi/9*1)+6.28*rand(i)"
		pos-x="0"
		
		num-sprites="3"
	>
		<frame time="50">0 0 160 160</frame>
		<frame time="80">160 0 160 160</frame>
		<frame time="100">320 0 160 160</frame>
		<frame time="100">0 160 160 160</frame>
		<frame time="100">160 160 160 160</frame>
		<frame time="100">320 160 160 160</frame>
		<frame time="100">480 160 160 160</frame>
	</sprite>

<!-- EXPLOSION START -->
  	<sprite looping="false" origin="80 80" texture="players/wizard/effects/arcane_blast_fire.png" material="system/default.mats:bright-noxray"
		scale-x="radius / 64 * pow(t,0.2)"
		scale-y="radius / 64 * pow(t,0.2)"
		color-a="1-1*pow(t,8)"
		angle="1*rand(u+i)*pi"
	>
		<frame time="100">640 160 160 160</frame>
	</sprite>


<!-- OLD -->
	<sprite origin="44 44" texture="effects/spritesheets/effects.png" material="effects/effects.mats:add"
		angle="(i*pi)+(t*pi)*(1-i*2)"
		pos-y="0"
		scale-x="radius/64+(radius/(48-i*8))*(t)"
		scale-y="radius/64+(radius/(48-i*8))*(t)"
		num-sprites="2"
		color-a="1-pow(t,4)"
		
		color-r="(1-t)+cR*t"
		color-g="(1-t)+cG*t"
		color-b="(1-t)+cB*t"
	>
		<frame time="150" x="586" y="1" w="88" h="88" />
	</sprite>

<!-- LIGHT SHAFT -->	
	<sprite origin="5 44" texture="effects/spritesheets/effects.png" material="effects/effects.mats:add"
		color-a="1-pow(t,4)"
		scale-x="0.5*scale"
		scale-y="(((0.8)*sin(t*pi))+0.8-t*0.8)*scale"
		color-r="(1-t)+cR*t"
		color-g="(1-t)+cG*t"
		color-b="(1-t)+cB*t"
		num-sprites="lightshaft"
	>
		<frame time="50" x="77" y="924" w="10" h="64" />
		<frame time="50" x="67" y="924" w="10" h="64" />
		<frame time="50" x="57" y="924" w="10" h="64" />
		<frame time="30" x="47" y="924" w="10" h="64" />
		<frame time="30" x="37" y="924" w="10" h="64" />
		<frame time="30" x="27" y="924" w="10" h="64" />
	</sprite>
	
	<particle_spawner
		spawn-rate="radius*8"
		length="150"
		angle="rpick(-pi,pi)"
		start="150"
		looping="false"
		ttl="rpick(250,300)"
		pos="0 ; 0; 0"
		color-mul="1;1;1;1"
		curl-speed="3"
		curl-scale="1"
	>
		<behaviors>
			<spread_range radius="rpick(2,radius/2)"/>
			<fade_to a="0" r="cR" g="cG" b="cB" />
			<force_toward pos="0; 2; 0" mul="rpick(-0.5,-0.25)"/>
		</behaviors>
		<particle src="effects/subeffects/particles_speckles.unit:single_white_add"/>
	</particle_spawner>
	
<!-- JAGGED LIGHT -->
	<light> 
		<sprite texture="effects/lights/radial_jagged_ring_L.png">
			<frame time="100">0 0 256 256</frame>
		</sprite>

		<length value="250" />
		
		<looping value="false" />
		
		<cast-shadows value="false" />
		
		<shadow-cAst-pos-x value="0" />
		<shadow-cAst-pos-y value="0" />
		
		<shadow-cAst-pos-jitter value="0 0 0 0" />
		
		<size value="(radius/2)+pow(t,2)*radius*6" />
		<angle value="rand(u)*pi*4" />
		
		<color-r value="(3-t*3)+cR*t*4"/>
		<color-g value="(3-t*3)+cG*t*4"/>
		<color-b value="(3-t*3)+cB*t*4"/>
		<color-a value="0.3*t_sin" />
	</light>

<!-- LIGHT -->	
	<light>
		<sprite texture="effects/lights/light2_L.png">
			<frame time="800">0 0 128 128</frame>
		</sprite>
		<looping value="false" />
		<length value="400"/>
		<cast-shadows value="false" />
		<size value="radius*8" />
		<color-r value="cR*2*t_sin" />
		<color-g value="cG*2*t_sin" />
		<color-b value="cB*2*t_sin" />
		<color-a value="0.1*t_sin"/>
	</light>
	
	<light>
		<sprite texture="effects/lights/light2_L.png">
			<frame time="800">0 0 128 128</frame>
		</sprite>
		<looping value="false" />
		<length value="150" />
		<cast-shadows value="false" />
		<size value="(radius*4)*(1-t)" />
		<color-r value="cR*2*t_sin" />
		<color-g value="cG*2*t_sin" />
		<color-b value="cB*2*t_sin" />
		<color-a value="0.2*t_sin"/>
	</light>
</effect>