<effect looping="true" layer="-5">
<!-- Bannerlord's Battlefield Standard (scripts/HWP/Specs/Bannerlord.as): players/priest/effects/holy_banner.effect in red and gold with the standard's art from fx.png (tools/make_specs_fx.py). planted 0: carried over the bearer's shoulder, a faint ring; 1: planted in the ground. -->
	<param name="radius" default="40" />
	<param name="planted" default="1" />

<!-- LIGHT COLORS -->
	<param name="cR" default="0.9" />
    <param name="cG" default="0.6" />
    <param name="cB" default="0.1" />
	<param name="cA" default="1" />
	
<!-- COMMON CALCS -->
	%replace "tl" "(t+l)"
	%replace "prog_tl" "saturate(t+l)"
	%replace "prog_tl_out" "sin(prog_tl*pi/2)"
	%replace "prog_tl_fast" "saturate((t+l)/0.06)"
	%replace "prog_tl_fast_in" "(prog_tl_fast*prog_tl_fast)"
	%replace "prog_tl_fast_out" "sin(prog_tl_fast*pi/2)"
	%replace "prog_tl_sin" "sin(prog_tl*pi)"
	%replace "t_out" "sin(t*pi/2)"
	%replace "t_in" "(t*t)"
	%replace "t_sin" "sin(t*pi)"
	%replace "t_sin_off" "sin(saturate((t-0.4)/0.6)*pi)"
	%replace "t_sin_out" "sin(sin(t*pi/2)*pi)"
	%replace "t_step" "smoothstep(t,0,1)"

<!-- TWEAK CALCS -->
	%replace "flag_y_offset" "(-30+30*prog_tl_fast_in-18*(1-planted))"
	%replace "flag_x_offset" "(-7*(1-planted))"
	%replace "ring_scale" "(radius/80)*prog_tl_fast_out"

<!-- RING GLOW -->
	<sprite layer="100" looping="true" origin="128 128" texture="actors/bosses/spirits/effects/heal_ring.png" material="effects/effects.mats:add"
		pos-x="0"
		pos-y="0"
		scale-x="ring_scale*0.67"
		scale-y="ring_scale*0.67"
		angle="0"

		color-r="2"
		color-g="0.84"
		color-b="0.24"
		color-a="0.05*prog_tl_fast_out*(0.8+0.2*sin(tl*25))"
		>

		<frame time="base_dur" x="0" y="0" w="256" h="256" />
	</sprite>

<!-- OUTTER RING -->
	<sprite origin="80 80" looping="true" texture="players/priest/effects/consecrated_ground.png" material="system/default.mats:bright-noxray"
		
		angle="0"
		scale-x="ring_scale"
		scale-y="ring_scale"
		
		color-r="3"
		color-g="1.26"
		color-b="0.36"
		color-a="(0.35+0.65*planted)*prog_tl_fast_out"
	>
		<frame time="200">0 0 160 160</frame>
	</sprite>		
		
<!-- RING EFFECT -->
	<sprite origin="64 64" looping="true" texture="players/priest/effects/consecrated_ground.png" material="system/default.mats:bright-noxray"
	
		scale-x="ring_scale"
		scale-y="ring_scale"
		
		color-r="3"
		color-g="1.26"
		color-b="0.36"
		color-a="(0.25+0.45*planted)*prog_tl_fast_out"
	>
		<frame time="50">0 192 128 128</frame>
		<frame time="50">128 192 128 128</frame>
		<frame time="50">256 192 128 128</frame>
		<frame time="50">384 192 128 128</frame>
		<frame time="50">512 192 128 128</frame>
		<frame time="75">640 192 128 128</frame>
		<frame time="75">768 192 128 128</frame>
		<frame time="500">0 0 0 0</frame>
	</sprite>	
	
<!-- FLAG GLOW 1 -->
	<sprite origin="128 128" looping="true" texture="effects/lights/radial_jagged_ring_L.png" material="system/default.mats:add"
		
		pos-x="flag_x_offset"
		pos-y="-20+flag_y_offset"

		angle="2*pi*t"

		scale-x="0.2+0.02*sin(t*2*pi)"
		scale-y="0.2+0.02*sin(t*2*pi)"
		
		color-r="0.6*prog_tl_fast_out"
		color-g="0.252*prog_tl_fast_out"
		color-b="0.072*prog_tl_fast_out"
		color-a="0.2+0.1*sin(t*2*pi)"
	>

		<frame time="1000" x="0" y="0" w="256" h="256" />

	</sprite>

<!-- FLAG GLOW 2 -->
	<sprite origin="128 128" looping="true" texture="effects/lights/radial_jagged_ring_L.png" material="system/default.mats:add"
		
		pos-x="flag_x_offset"
		pos-y="-20+flag_y_offset"

		angle="-2*pi*t"

		scale-x="0.25+0.02*cos(t*2*pi)"
		scale-y="0.25+0.02*cos(t*2*pi)"
		
		color-r="0.8*prog_tl_fast_out"
		color-g="0.336*prog_tl_fast_out"
		color-b="0.096*prog_tl_fast_out"
		color-a="0.15+0.07*cos(t*2*pi)"
	>

		<frame time="1000" x="0" y="0" w="256" h="256" />

	</sprite>

<!-- FLAG -->
	<sprite origin="4 39" looping="true" texture="players/hwp/specs/effects/fx.png" material="system/default.mats:default-noxray"
		pos-x="flag_x_offset"
		pos-y="flag_y_offset"
		color-a="(1-planted)*prog_tl_fast_out"
	>
		<frame time="220">0 72 24 40</frame>
		<frame time="220">24 72 24 40</frame>
	</sprite>

	<sprite origin="4 39" looping="true" texture="players/hwp/specs/effects/fx.png" material="system/default.mats:default-noxray"
		pos-x="flag_x_offset"
		pos-y="flag_y_offset"
		color-a="planted*prog_tl_fast_out"
	>
		<frame time="220">48 72 24 40</frame>
		<frame time="220">72 72 24 40</frame>
	</sprite>

<!-- LENGTH -->
	<sprite origin="0 0" looping="true" texture="players/hwp/specs/effects/fx.png" material="system/default.mats:default-noxray" color-a="0">
		<frame time="4000">0 0 1 1</frame>
	</sprite>

<!-- LIGHT SHAFT -->
	<sprite origin="5 44" looping="false" texture="effects/spritesheets/effects.png" material="effects/effects.mats:add"
		pos-y="-10"
		scale-x="1.2"
		scale-y="1.6*prog_tl_sin+1.6-prog_tl*1.6"
		color-r="(1-prog_tl)+cR*prog_tl"
		color-g="(1-prog_tl)+cG*prog_tl"
		color-b="(1-prog_tl)+cB*prog_tl"
		color-a="(1-pow(prog_tl,4))*2"
	>
		<frame time="50" x="77" y="924" w="10" h="64" />
		<frame time="50" x="67" y="924" w="10" h="64" />
		<frame time="50" x="57" y="924" w="10" h="64" />
		<frame time="30" x="47" y="924" w="10" h="64" />
		<frame time="30" x="37" y="924" w="10" h="64" />
		<frame time="30" x="27" y="924" w="10" h="64" />
	</sprite>

<!-- SPAWN PARTICLES -->
	<particle_spawner
		spawn-rate="radius*8"
		length="150"
		angle="rpick(-pi,pi)"
		start="150"
		looping="false"
		ttl="rpick(250,300)"
		pos="0 ; 0; 0"
		color-mul="1.5;0.63;0.18;1"
		curl-speed="3"
		curl-scale="1"
	>
		<behaviors>
			<spread_range radius="rpick(2,radius/2)"/>
			<fade_to a="0" r="cR" g="cG" b="cB" />
			<force_toward pos="0; 2; 0" mul="rpick(-0.5,-0.25)"/>
		</behaviors>
		<particle src="effects/subeffects/particles_speckles.unit:single_white_add"/>
	</particle_spawner>

<!-- LIGHT -->
	<light pos="0 15"> 
		<sprite texture="system/default_L.png">
			<frame time="100">0 0 128 128</frame>
		</sprite>
		
		<length value="100" />
		
		<looping value="true" />
		
		<cast-shadows value="false" />
		
		<shadow-cast-pos-x value="0" />
		<shadow-cast-pos-y value="0" />
		
		<shadow-cast-pos-jitter value="0 0 0 0" />

		<size value="(1+0.08*sin(pi*t)) * 120 * radius/40" />
		
		<color-r value="2*prog_tl_fast_out" />
		<color-g value="0.84*prog_tl_fast_out" />
		<color-b value="0.24*prog_tl_fast_out" />
		<color-a value="0.015" />
	</light>

</effect>