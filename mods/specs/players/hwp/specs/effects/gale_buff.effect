<effect looping="true" layer="-1" wpos-track="12">
<!-- Winddancer's Protective Gale, on each player who has it: players/ranger/effects/dodge_buff.effect recoloured (tools/make_specs_fx.py) -->
	<trail texture="effects/spritesheets/trail_5.png" material="system/default.mats:bright-noxray">
		<pos-x value="wposx(i)" />
		<pos-y value="-4+wposy(i)" />
		
		<length value="100" />
		<looping value="true" />
		
		<segments value="12" />
		<size value="16-0.5*i" />
		
		<uv-l-x value="(i*2)+(t+l)*-128" />
		<uv-l-y value="0" />
		
		<uv-r-x value="(i*2)+(t+l)*-128" />
		<uv-r-y value="32" />
		
		<color-r value="0.7" />
		<color-g value="1" />
		<color-b value="0.85" />
		<color-a value="((saturate(i*0.25)/2)-i*(1/24))*(1-saturate(t*saturate(l-19)))" />
	</trail>
	
	<sprite looping="true" origin="24 24" layer="-4" texture="effects/spritesheets/effects.png" material="system/default.mats:default-simple"
			scale-x="(0.12+0.2*rand(i+16))+sin((t+l)*pi-i/4)*0.1"
			scale-y="(0.12+0.2*rand(i+16))+sin((t+l)*pi-i/4)*0.1"
			color-a="saturate(t+l)*0.15*(1-saturate((l-2+pow(t,8))))"
			color-r="0.7"
			color-g="1"
			color-b="0.85"
			angle="((pi*2)/4)*i+((t+l)*pi*4)"
			num-sprites="4"
			
			pos-x="(-2+4*rand(8+i))+sin(t*pi)*rand(i+3)*8"
			pos-y="(-2+4*rand(6+i))+sin(t*pi)*rand(i+9)*8"
			>
			<frame time="200" x="365" y="768" w="48" h="48" />
			<frame time="200" x="414" y="768" w="48" h="48" />
			<frame time="200" x="463" y="768" w="48" h="48" />
	</sprite>
	<light>
		<sprite texture="system/default_L.png">
			<frame time="550">0 0 128 128</frame>
		</sprite>
		<looping value="false" />
		<length value="2000" />
		<cast-shadows value="false" />
		<shadow-cast-pos-x value="0" />
		<shadow-cast-pos-y value="0" />
		<shadow-cast-pos-jitter value="0 0 0 0" />
		<size value="75*saturate(t*2+l)" />
		<color-r value="0.28*saturate(t*5)*(1-pow(t,8))"/>
		<color-g value="0.4*saturate(t*5)*(1-pow(t,8))"/>
		<color-b value="0.34*saturate(t*5)*(1-pow(t,8))"/>
		<color-a value="0.0"/>
	</light>
</effect>