%include "players/skills_cost.inc"
<!--
	Second Wind (Winddancer passive). An evade (Sidestep's included: Player.Evade fires the
	evade trigger) releases a gust at the rogue that heals them and the teammates within 80
	by sw-heal, at most once every 4 s (the trigger's timeout). Heal runs where each healed
	player is local (FilterHuskDamage), the trigger is sent on with ModifierTriggerEffect.
	All numbers assumed: heal 20/30/40/50/60, radius 80, 4 s.
	Orbs: Lingering Breeze (sw-breeze: breeze_<lvl>, 2/4/6 health a second for 4 s on everyone
	the gust heals; a timed Heal, not regeneration, which pauses after a hit),
	Shared Breath (sw-share: teammates Protective Gale reaches can release the gust too,
	scripts/HWP/Specs/Winddancer.as; sw-breeze-lvl picks their gust's breeze).
	Sound: picked in the audio picker (art/specs/AUDIO.md).
-->
<dict>
	<string name="name">.hwp.specs.second_wind.name</string>
	<string name="type-name">.skills.type.passive</string>
	<string name="description">.hwp.specs.second_wind.desc</string>

	<array name="description-params">
		<array><s>heal</s><s>.skills.desc.params.heal</s><s>20</s><s>30</s><s>40</s><s>50</s><s>60</s></array>
		<array><s>cooldown</s><s>.skills.desc.params.cooldown</s><s>4s</s></array>
	</array>

	<array name="icon"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>48 72 24 24</vec4></array>

	<string name="id">hwp_rog_second_wind</string>
	<array name="tags"><s>passive</s></array>
	<int name="starting-level">1</int>

	<dict name="skill">
		<int name="skill-cost">SKILLCOSTMASTERYLEVEL_1</int>
		<string name="class">Skills::PassiveSkill</string>
		<dict name="binds">
			<int name="sw-heal">20</int>
			<string name="sw-breeze">null</string>
			<int name="sw-breeze-lvl">0</int>
			<float name="sw-share">0</float>
		</dict>
		<array name="modifiers">
			<array>
				<dict>
					<string name="class">Modifiers::TriggerEffect</string>
					<string name="trigger">evade</string>
					<vec2 name="chance">1 1</vec2>
					<ivec2 name="timeout">4000 4000</ivec2>
					<bool name="target-self">true</bool>
					<array name="effects">
						<dict>
							<string name="class">PlaySound</string>
							<string name="sound">event:/sfx/player/classes/ranger/wind_weaver/wind_weaver_hit</string>
						</dict>
						<dict>
							<string name="class">Explode</string>
							<string name="fx">players/hwp/specs/effects/gust.effect?radius=80</string>
							<int name="radius">80</int>
							<int name="min-radius">80</int>
							<float name="dist-scaling">1000</float>

							<bool name="hit-self">true</bool>
							<bool name="hit-same-team">true</bool>
							<bool name="hit-different-team">false</bool>

							<array name="effects">
								<dict>
									<float name="self-dmg">1</float>
									<float name="team-dmg">1</float>
									<float name="enemy-dmg">0</float>
									<bool name="only-actors">true</bool>
								</dict>
								<dict>
									<string name="class">Heal</string>
									<string name="heal-bind">sw-heal</string>
								</dict>
								<dict>
									<string name="class">ApplyBuff</string>
									<string name="buff-bind">sw-breeze</string>
									<bool name="ignore-intensity">true</bool>
								</dict>
							</array>
						</dict>
					</array>
				</dict>
			</array>
		</array>
	</dict>

	<array name="upgrades">
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_2</int>
			<dict name="binds"><int name="sw-heal">30</int></dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_3</int>
			<dict name="binds"><int name="sw-heal">40</int></dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_4</int>
			<dict name="binds"><int name="sw-heal">50</int></dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_5</int>
			<dict name="binds"><int name="sw-heal">60</int></dict>
		</dict>
	</array>

	<array name="modifier-skills">
		<dict>
			<string name="name">.hwp.specs.lingering_breeze.name</string>
			<string name="description">.hwp.specs.lingering_breeze.desc</string>
			<array name="description-params">
				<array><s>healthregen</s><s>.skills.desc.params.healthregen</s><s>2</s><s>4</s><s>6</s></array>
				<array><s>duration</s><s>.skills.desc.params.duration</s><s>4s</s></array>
			</array>
			<array name="icon"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>144 72 24 24</vec4></array>
			<array name="tags"><s>passive</s></array>
			<string name="id">hwp_rog_sw_lingering_breeze</string>
			<string name="quality">common</string>
			<int name="starting-level">0</int>
			<dict name="skill">
				<dict name="binds">
					<string name="sw-breeze">players/hwp/specs/buffs_specs.sval:breeze_1</string>
					<int name="sw-breeze-lvl">1</int>
				</dict>
			</dict>
			<array name="upgrades">
				<dict>
					<string name="quality">uncommon</string>
					<dict name="binds">
						<string name="sw-breeze">players/hwp/specs/buffs_specs.sval:breeze_2</string>
						<int name="sw-breeze-lvl">2</int>
					</dict>
				</dict>
				<dict>
					<string name="quality">rare</string>
					<dict name="binds">
						<string name="sw-breeze">players/hwp/specs/buffs_specs.sval:breeze_3</string>
						<int name="sw-breeze-lvl">3</int>
					</dict>
				</dict>
			</array>
		</dict>
		<dict>
			<string name="name">.hwp.specs.shared_breath.name</string>
			<string name="description">.hwp.specs.shared_breath.desc</string>
			<array name="icon"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>168 72 24 24</vec4></array>
			<array name="tags"><s>passive</s></array>
			<string name="id">hwp_rog_sw_shared_breath</string>
			<string name="quality">rare</string>
			<int name="starting-level">0</int>
			<dict name="skill">
				<dict name="binds">
					<float name="sw-share">1</float>
				</dict>
			</dict>
		</dict>
	</array>
</dict>
