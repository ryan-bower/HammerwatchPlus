%include "players/skills_cost.inc"
<!--
	Battlefield Standard: shield pulses every 3 seconds in radius 120. Recast throws
	the banner while preserving its remaining lifetime; both origins continue pulsing.
	Rallying Standard shares improved native Killing Spree; Martyr increases allied
	shields but removes the bearer's shield. Legacy perk IDs preserve purchased ranks.
-->
<dict>
	<string name="name">.hwp.specs.battlefield_standard.name</string>
	<string name="type-name">.skills.type.spell</string>
	<string name="description">.hwp.specs.battlefield_standard.desc</string>

	<array name="description-params">
		<array><s>shield</s><s>.hwp.specs.param.banner_shield</s><s>3%</s><s>3.5%</s><s>4%</s><s>4.5%</s><s>5%</s></array>
		<array><s>duration</s><b>t</b><s>.skills.desc.params.duration</s><s>10s</s><s>13s</s><s>15s</s><s>17s</s><s>20s</s></array>
		<array><s>mana-cost</s><s>.skills.desc.params.mana_cost</s><s>40</s></array>
		<array><s>cooldown</s><b>t</b><s>.skills.desc.params.cooldown</s><s>60s</s><s>55s</s><s>50s</s><s>45s</s><s>40s</s></array>
	</array>

	<array name="icon"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>24 96 24 24</vec4></array>

	<string name="id">hwp_war_battlefield_standard</string>
	<string name="type">spell</string>
	<array name="tags"><s>spell</s></array>
	<int name="starting-level">1</int>

	<dict name="skill">
		<int name="skill-cost">SKILLCOSTMASTERYLEVEL_1</int>
		<string name="class">HWPSpecsStandard</string>
		<string name="anim">cast</string>
		<int name="anim-length">600</int>

		<int name="cooldown">60000</int>
		<int name="castpoint">150</int>
		<float name="cast-speed-mul">1</float>
		<float name="move-speed-mul">0.7</float>
		<ivec2 name="move-speed">0 250</ivec2>
		<ivec2 name="blocking">0 250</ivec2>
		<bool name="repeating">false</bool>
		<int name="mana-cost">40</int>
		<dict name="binds">
			<float name="std-shield">0.03</float>
			<int name="std-ttl">10000</int>
			<int name="std-radius">120</int>
			<int name="std-rally">0</int>
			<float name="std-ally-mul">1</float>
			<float name="std-self-mul">1</float>
		</dict>
		<dict name="actions">
			<array name="cast">
				<dict>
					<string name="class">HWPSpecsStandardCast</string>
				</dict>
			</array>
		</dict>

		<array name="timeline">
			<i>150</i><s>cast</s>
		</array>
	</dict>

	<array name="upgrades">
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_2</int>
			<int name="cooldown">55000</int>
			<dict name="binds">
				<float name="std-shield">0.035</float>
				<int name="std-ttl">13000</int>
			</dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_3</int>
			<int name="cooldown">50000</int>
			<dict name="binds">
				<float name="std-shield">0.04</float>
				<int name="std-ttl">15000</int>
			</dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_4</int>
			<int name="cooldown">45000</int>
			<dict name="binds">
				<float name="std-shield">0.045</float>
				<int name="std-ttl">17000</int>
			</dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_5</int>
			<int name="cooldown">40000</int>
			<dict name="binds">
				<float name="std-shield">0.05</float>
				<int name="std-ttl">20000</int>
			</dict>
		</dict>
	</array>

	<array name="modifier-skills">
		<dict>
			<string name="name">.hwp.specs.feared_crest.name</string>
			<string name="type-name">.skills.type.spell.upgrade</string>
			<string name="description">.hwp.specs.feared_crest.desc</string>
			<array name="description-params">
				<array><s>stacks</s><s>.hwp.specs.param.spree_stacks</s><s>1</s><s>2</s><s>3</s></array>
			</array>
			<array name="icon"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>72 96 24 24</vec4></array>
			<string name="id">hwp_war_bs_feared_crest</string>
			<string name="quality">uncommon</string>
			<dict name="skill">
				<dict name="binds">
					<int name="std-rally">1</int>
				</dict>
			</dict>
			<array name="upgrades">
				<dict>
					<string name="quality">uncommon</string>
					<dict name="binds">
						<int name="std-rally">2</int>
					</dict>
				</dict>
				<dict>
					<string name="quality">rare</string>
					<dict name="binds">
						<int name="std-rally">3</int>
					</dict>
				</dict>
			</array>
		</dict>
		<dict>
			<string name="name">.hwp.specs.martyrs_banner.name</string>
			<string name="type-name">.skills.type.spell.upgrade</string>
			<string name="description">.hwp.specs.martyrs_banner.desc</string>
			<array name="description-params">
				<array><s>ally-mul</s><s>.hwp.specs.param.ally_shield</s><s>x1.25</s><s>x1.5</s><s>x1.75</s></array>
			</array>
			<array name="icon"><s>players/hwp/specs/icons.png</s><i>100</i><vec4>96 96 24 24</vec4></array>
			<string name="id">hwp_war_bs_martyrs_banner</string>
			<string name="quality">uncommon</string>
			<dict name="skill">
				<dict name="binds">
					<float name="std-ally-mul">1.25</float>
					<float name="std-self-mul">0</float>
				</dict>
			</dict>
			<array name="upgrades">
				<dict>
					<string name="quality">uncommon</string>
					<dict name="binds">
						<float name="std-ally-mul">1.5</float>
						<float name="std-self-mul">0</float>
					</dict>
				</dict>
				<dict>
					<string name="quality">rare</string>
					<dict name="binds">
						<float name="std-ally-mul">1.75</float>
						<float name="std-self-mul">0</float>
					</dict>
				</dict>
			</array>
		</dict>
	</array>
</dict>
