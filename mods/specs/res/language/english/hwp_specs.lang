	<!-- Bannerlord -->
	<string name="hwp.specs.battlefield_standard.name">Battlefield Standard</string>
	<string name="hwp.specs.battlefield_standard.desc">Raise a Battlefield Standard for %duration%. You and your allies near it take %dr% less damage. Use it again while you carry it to plant it where you stand, for free: the damage reduction doubles and the time left is halved.</string>
	<string name="hwp.specs.feared_crest.name">Feared Crest</string>
	<string name="hwp.specs.feared_crest.desc">Enemies near the Standard suffer %vulnerability%.</string>
	<string name="hwp.specs.martyrs_banner.name">Martyr's Banner</string>
	<string name="hwp.specs.martyrs_banner.desc">The Standard's damage reduction is %ally-mul% on your allies, but you no longer receive it.</string>
	<string name="hwp.specs.righteous_crusade.name">Righteous Crusade</string>
	<string name="hwp.specs.righteous_crusade.desc">Your buffs last %buff-duration% longer, and so do the buffs of allies standing near your Battlefield Standard.</string>
	<string name="hwp.specs.war_drum.name">War Drum</string>
	<string name="hwp.specs.war_drum.desc">Warcry and the Battlefield Standard weaken nearby enemies. Each cast makes the Weakness one step more severe, up to %weakness%.</string>
	<string name="hwp.specs.shared_provisions.name">Shared Provisions</string>
	<string name="hwp.specs.shared_provisions.desc">Gain %cdr% cooldown reduction for every buff on you and your allies, up to 30%.</string>
	<string name="hwp.specs.stack.provisions.name">Shared Provisions</string>
	<string name="hwp.specs.stack.provisions.desc">Cooldown reduction, 1% per stack.</string>

	<!-- Winddancer -->
	<string name="hwp.specs.protective_gale.name">Protective Gale</string>
	<string name="hwp.specs.protective_gale.desc">Call up a gale around you. You and nearby teammates gain %evasion% Evasion for %duration%, and the wind goes with each of you.</string>
	<string name="hwp.specs.lasting_gale.name">Lasting Gale</string>
	<string name="hwp.specs.lasting_gale.desc">Protective Gale lasts %duration%.</string>
	<string name="hwp.specs.tailwind.name">Tailwind</string>
	<string name="hwp.specs.tailwind.desc">Protective Gale also grants %mspeed% Movement Speed.</string>
	<string name="hwp.specs.second_wind.name">Second Wind</string>
	<string name="hwp.specs.second_wind.desc">Evading an attack releases a healing gust that restores %heal% Health to you and nearby teammates. This can happen once every %cooldown%.</string>
	<string name="hwp.specs.lingering_breeze.name">Lingering Breeze</string>
	<string name="hwp.specs.lingering_breeze.desc">Everyone a healing gust touches also recovers %healthregen% Health every second for %duration%.</string>
	<string name="hwp.specs.shared_breath.name">Shared Breath</string>
	<string name="hwp.specs.shared_breath.desc">Teammates under your Protective Gale release your healing gust when they evade an attack.</string>

	<!-- Deadeye (the ids keep stormbringer) -->
	<string name="hwp.specs.electric_circuit.name">Lightning Arrow</string>
	<string name="hwp.specs.electric_circuit.desc">Fire a volley of three arrows in a V that pierce every enemy in their path for %damage% Physical and Lightning damage. Each enemy hit calls lightning down on up to 2 other nearby enemies for %strike% damage. When an arrow reaches its range or hits a wall, it returns to where you fired it from, hitting everything along the way again.</string>
	<string name="hwp.specs.boomerang.name">Boomerang</string>
	<string name="hwp.specs.boomerang.desc">The returning arrow deals %return% increased damage. When it hits an enemy with no other enemies nearby, the lightning strikes that enemy instead.</string>
	<string name="hwp.specs.storm_arrow.name">Storm Arrow</string>
	<string name="hwp.specs.storm_arrow.desc">Each arrow hit calls lightning on %strikes% more enemies, in a %radius% larger radius.</string>
	<string name="hwp.specs.tailwind_catch.name">Tailwind Catch</string>
	<string name="hwp.specs.tailwind_catch.desc">Catching your returning arrow grants a stack of Tailwind (Gathering Winds).</string>
	<string name="hwp.specs.gathering_winds.name">Gathering Winds</string>
	<string name="hwp.specs.gathering_winds.desc">Every 5 kills grants a stack of Tailwind for 4 seconds, up to 5 stacks. Each stack increases your Action Speed (Movement, Skill and Weapon Speed) by %speed%.</string>
	<string name="hwp.specs.gale_force.name">Gale Force</string>
	<string name="hwp.specs.gale_force.desc">At max Tailwind stacks, your Bow and Crossbow skills fire %arrows% additional projectiles.</string>
	<string name="hwp.specs.wind_ward.name">Wind Ward</string>
	<string name="hwp.specs.wind_ward.desc">Each stack of Tailwind reduces the damage you take by %dr%.</string>
	<string name="hwp.specs.stack.tailwind.name">Tailwind</string>
	<string name="hwp.specs.stack.tailwind.desc">More Movement, Skill and Weapon Speed per stack (Gathering Winds).</string>

	<!-- Aerotheurge (the ids keep invocation) -->
	<string name="hwp.specs.tempest_torrent.name">Thunder Orb</string>
	<string name="hwp.specs.tempest_torrent.desc">Launch a slow-moving orb of lightning that passes through enemies for %duration%. Every 0.25 seconds it zaps up to 3 enemies in range for %damage% Lightning damage, preferring enemies it hasn't zapped yet. If it hits a wall, it stops there and keeps zapping until it runs out.</string>
	<string name="hwp.specs.focal_point.name">Focal Point</string>
	<string name="hwp.specs.focal_point.desc">Each consecutive zap on the same enemy deals %per-zap% more damage, stacking up to 10 times.</string>
	<string name="hwp.specs.lightning_rod_orb.name">Lightning Rod</string>
	<string name="hwp.specs.lightning_rod_orb.desc">Tempest Orb zaps %zaps% more enemies per tick and has %range% increased range.</string>
	<string name="hwp.specs.lingering_storm.name">Lingering Storm</string>
	<string name="hwp.specs.lingering_storm.desc">Increases Tempest Orb's duration by %duration%.</string>
	<string name="hwp.specs.thunderclap.name">Thunderclap</string>
	<string name="hwp.specs.thunderclap.desc">When Tempest Orb expires, it bursts, dealing %burst% of its zap damage as Lightning damage to all nearby enemies.</string>
	<string name="hwp.specs.static_charge.name">Static Charge</string>
	<string name="hwp.specs.static_charge.desc">Each spell you cast grants 1 stack of Static Charge, or 2 if it Crits, for 10 seconds; each new stack resets the timer. At 5 stacks, your next spell releases a lightning strike of %damage% damage that splits between up to 3 nearby enemies. If it hits only one enemy, it deals 50% more damage.</string>
	<string name="hwp.specs.charged_font.name">Charged Font</string>
	<string name="hwp.specs.charged_font.desc">Releasing Static Charge restores %mana% of your max Mana.</string>
	<string name="hwp.specs.conduit.name">Conduit</string>
	<string name="hwp.specs.conduit.desc">Each Static Charge increases your Cast Speed by %cast-speed%.</string>
	<string name="hwp.specs.stack.static_charge.name">Static Charge</string>
	<string name="hwp.specs.stack.static_charge.desc">At 5, your next spell releases lightning strikes. Each new stack resets the 10 second timer.</string>
	<!-- Branding -->
	<string name="hwp.specs.pyrebrand.name">Pyrebrand</string>
	<string name="hwp.specs.pyrebrand.desc">Brand the enemy you aim at with a demonic sigil for 6 seconds. %pct% of the damage you deal to it feeds the brand. Use Pyrebrand again, for free, or let the brand run out, and a Hellfire Claw tears up through the victim, dealing %base% Fire damage plus the stored damage to it and the enemies beside it. If the victim dies first, the brand passes to the nearest enemy with its stored damage.</string>
	<string name="hwp.specs.combustion.name">Combustion</string>
	<string name="hwp.specs.combustion.desc">Hellfire Claw consumes all of your Essence, dealing %per-stack% more damage in a %per-stack% larger area for each stack.</string>
	<string name="hwp.specs.proliferation.name">Proliferation</string>
	<string name="hwp.specs.proliferation.desc">When a branded enemy dies, the brand spreads with all of its stored damage to every enemy within %radius%. Brands last half as long.</string>
	<string name="hwp.specs.essence_extraction.name">Essence Extraction</string>
	<string name="hwp.specs.essence_extraction.desc">Your magic weapon attacks now also gain stacks of Essence, once every %cooldown%. Essence gained from Pyrebranded enemies has its effects trigger twice.</string>
	<string name="hwp.specs.essence_empowerment.name">Essence Empowerment</string>
	<string name="hwp.specs.essence_empowerment.desc">Each stack of Essence adds %per-stack% of your Physical damage multiplier to your Fire damage. Hellfire Claw gains this before Combustion consumes the stacks.</string>
	<string name="hwp.specs.released_essence.name">Released Essence</string>
	<string name="hwp.specs.released_essence.desc">An elite or boss killed by Hellfire Claw grants %stacks% stacks of Essence.</string>
	<!-- Arcane -->
	<string name="hwp.specs.blink.name">Blink</string>
	<string name="hwp.specs.blink.desc">Teleport a short distance in the direction you aim, over ledges and stairs, dealing %damage% Pure damage to every enemy within %radius% of where you reappear. If you have a dash charge, Blink spends it to recast your last elemental spell from where you started, even while that spell is on cooldown. The spell's mana is still paid, down to 1 mana, and its cooldown starts over.</string>
	<string name="hwp.specs.void_barrier.name">Void Barrier</string>
	<string name="hwp.specs.void_barrier.desc">For %duration% after you Blink, damage cannot kill you.</string>
	<string name="hwp.specs.far_step.name">Far Step</string>
	<string name="hwp.specs.far_step.desc">Blink carries you %distance% farther.</string>
	<string name="hwp.specs.living_mana.name">Living Mana</string>
	<string name="hwp.specs.living_mana.desc">Your health becomes mana: one pool, shown as one blue bar. Maximum health adds to your maximum mana, and healing, potions and health regeneration restore mana. Damage drains your mana, and running out of it kills you. Spells can only bring you down to 1 mana. The lower your mana, the faster it regenerates, up to %regen% when empty.</string>
	<string name="hwp.specs.arcane_feedback.name">Arcane Feedback</string>
	<string name="hwp.specs.arcane_feedback.desc">Mana lost to enemy damage builds up, to at most %cap%. Your next spell consumes it and deals 0.5% more damage for each point.</string>
	<string name="hwp.specs.mana_conduit.name">Mana Conduit</string>
	<string name="hwp.specs.mana_conduit.desc">%share% of the mana you lose to damage is restored to your teammates, split evenly between them.</string>
	<!-- Devil Forgemaster -->
	<string name="hwp.specs.forgemaster.name">Devil Forgemaster</string>
	<string name="hwp.specs.param.risen_count">Risen at a time:</string>
	<string name="hwp.specs.param.risen_pct">Risen Health and Damage:</string>
	<string name="hwp.specs.param.penance">Heresy removed by Penance:</string>
	<string name="hwp.specs.param.heresy_removed">Heresy removed:</string>
	<string name="hwp.specs.param.weapon_damage">Weapon Damage:</string>
	<string name="hwp.specs.param.body_chance">Intact Body Chance:</string>
	<string name="hwp.specs.param.per_heresy_damage">Summon Damage per Heresy:</string>
	<string name="hwp.specs.param.per_heresy_lunge">Lunge Chance per Heresy:</string>
	<string name="hwp.specs.param.elite_body_chance">Elite Body Chance:</string>
	<string name="hwp.specs.param.boss_body_chance">Boss Body Chance:</string>
	<string name="hwp.specs.necrotic_resurrection.name">Necrotic Resurrection</string>
	<string name="hwp.specs.necrotic_resurrection.desc">Reanimate the intact body you aim at as a loyal summon with %pct% of the enemy's health and damage, up to %count% at a time; the oldest falls past that. Takes 3 seconds, 5 for an elite, 10 for a boss. Risen can't be healed and lose 1% health every 3 seconds (a boss every 9). Each raise adds Heresy: 1 for a normal enemy, 2 for an elite, 3 for a boss; at 5 Heresy you can no longer raise the dead. At max Divine Favor the skill becomes Sacrificial Penance: channel 3 seconds on an intact body to sacrifice it, consuming your Divine Favor and removing %penance% Heresy, 1 more for an elite's body and 2 more for a boss's, for 50 mana and no cooldown.</string>
	<string name="hwp.specs.pyre_sacrifice.name">Pyre Sacrifice</string>
	<string name="hwp.specs.pyre_sacrifice.desc">Using a Pyre also removes %reduce% Heresy. While you have Heresy you can use a Pyre, large or small, even with no curse.</string>
	<string name="hwp.specs.rot_bloom.name">Rot Bloom</string>
	<string name="hwp.specs.rot_bloom.desc">When a risen summon dies, its body bursts, dealing %damage% as Poison damage to enemies within 60.</string>
	<string name="hwp.specs.call_of_heresy.name">Call of Heresy</string>
	<string name="hwp.specs.call_of_heresy.desc">Slain enemies have a %body% chance to fall with their body intact, ready for Necrotic Resurrection. Bodies last 60 seconds. Each stack of Heresy gives your risen %damage% more damage, but adds %lunge% to the chance, rolled once per intact body you come near, that you lunge at it and consume its flesh: 3 seconds during which you can't move, attack or cast, with +50 health regeneration per second.</string>
	<string name="hwp.specs.deeper_depravity.name">Deeper Depravity</string>
	<string name="hwp.specs.deeper_depravity.desc">%elite% chance that an elite leaves an intact body. %boss% chance that a boss does (every boss, at the highest quality): a risen boss keeps its attacks at a fraction of its strength, decays slower and fits the hallways.</string>
	<string name="hwp.specs.ravenous_lunge.name">Ravenous Lunge</string>
	<string name="hwp.specs.ravenous_lunge.desc">Your flesh-eating lunge slams into the enemies around the body for %damage% before you start to eat. At the higher quality it knocks them back.</string>
	<string name="hwp.specs.stack.heresy.name">Heresy</string>
	<string name="hwp.specs.stack.heresy.desc">Each stack makes your risen stronger and a lunge at an intact body likelier. At 5 you can no longer raise the dead. Lowered by Sacrificial Penance and Pyre Sacrifice; resets in town.</string>
</lang>
