<!-- What an in-run fishing hole pays per catch tier (HWP::Fishing::OnCatch on
     the host). Format as in tweak/loot/chests.sval. Spawned by
     HWP::Fishing::SpawnCatchLoot for the catcher alone (Item::LootTable.SpawnLoot
     would drop the gear once per player in the lobby). Keys are not in here: key
     pickups are not netsynced, which a "unit" entry needs, so OnCatch rolls them
     from tweak/hwp/fishing_keys.sval. -->
<loader>Item::LootTable::LoadMultiple</loader>
<array>
	<dict>
		<string name="id">hwp_fishing_run_1</string>
		<array name="pools">
			<dict><array name="drops">
				<i>700</i><a><s>unit</s><s>items/pickups/health_fish.unit</s></a>
				<i>300</i><a><s>unit</s><s>items/pickups/health_meat.unit</s></a>
			</array></dict>
			<dict><array name="drops">
				<i>1000</i><a><s>material</s><s>gold</s><i>10</i><i>25</i></a>
			</array></dict>
		</array>
	</dict>
	<dict>
