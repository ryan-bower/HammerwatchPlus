<!-- A coast fishing spot (interact class HWPFishingSpot: the fishing minigame, a cast costs a
     bait). Spawned locally on every machine along the town's west coast, so it is not netsynced.
     The fish (vanilla pond fish, doodads/terrain/fish.png) swim in the sea to the west; the rod is
     only the interact icon (the one on the sand went on 2026-10-22). -->
<unit slot="doodad" netsync="none">
	<behavior class="HWPLocalNPC">
		<int name="hp">100000</int>
		<bool name="targetable">false</bool>
		<int name="experience-reward">0</int>
		<int name="aggro-range">150</int>
		<int name="max-range">300</int>
		<bool name="must-see-target">true</bool>
		<bool name="no-buffs">true</bool>
		<bool name="hide-health">true</bool>
		<bool name="hide-damage-numbers">true</bool>
		<bool name="hide-damage-flash">true</bool>
		<vec2 name="icon-offset">0 -22</vec2>
		<vec3 name="dialog-offset">0 -20 0</vec3>
		<array name="tags"></array>
		<dict name="interact">
			<string name="class">HWPFishingSpot</string>
			<bool name="in-run">false</bool>
			<int name="break-distance">50</int>
			<array name="icon"><s>items/tradeware/base.png</s><i>100</i><vec4>64 0 16 16</vec4></array>
		</dict>
		<dict name="movement">
			<string name="class">EmptyMovement</string>
		</dict>
		<array name="skills" />
	</behavior>

	<scenes default="spot">
		<scene name="spot">
			<minimap_sprite origin="6 4" layer="400" texture="gui/hwp/map_icons.png" frame="0 0 12 9" />
			<collision>
				<rect sensor="true">-40 -20 64 40</rect>
			</collision>
			<!-- no rod on the sand (the user's call, 2026-10-22): the swimming fish mark the spot, the rod
			     stays as the interact icon -->
			<sprite origin="42 7" texture="doodads/terrain/fish.png" material="doodads/terrain/terrain.mats:fish">
				<frame time="150">0 0 19 20</frame> <frame time="150">19 0 19 20</frame> <frame time="150">38 0 19 20</frame> <frame time="150">57 0 19 20</frame> <frame time="150">76 0 19 20</frame> <frame time="150">0 20 19 20</frame> <frame time="150">19 20 19 20</frame> <frame time="150">38 20 19 20</frame> <frame time="150">57 20 19 20</frame> <frame time="150">76 20 19 20</frame>
			</sprite>
			<sprite origin="58 21" texture="doodads/terrain/fish.png" material="doodads/terrain/terrain.mats:fish">
				<frame time="150">0 0 19 20</frame> <frame time="150">19 0 19 20</frame> <frame time="150">38 0 19 20</frame> <frame time="150">57 0 19 20</frame> <frame time="150">76 0 19 20</frame> <frame time="150">0 20 19 20</frame> <frame time="150">19 20 19 20</frame> <frame time="150">38 20 19 20</frame> <frame time="150">57 20 19 20</frame> <frame time="150">76 20 19 20</frame>
			</sprite>
		</scene>
	</scenes>
</unit>
