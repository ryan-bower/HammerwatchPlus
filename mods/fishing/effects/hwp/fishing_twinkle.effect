<!-- The twinkle over a fishing spot's water. HWP::Fishing::TickTwinkle plays one at a random point
     of each spot's water every couple of seconds, on every machine for itself (PlayEffect's unit is
     netsync none). It is vanilla's ground-item glint (items/material_reflection.effect: the
     effects/lights/flare.png star in the additive items.mats:gold_reflection material, scaled by
     a*sin(t*pi)) played once instead of looping, a little quicker and faintly blue. pos-y lifts the
     star 16 px (FishingModule.as TWINKLE_LIFT) above the effect's position: the script places it
     that much further south, so it sorts after the well whose water it sits in and is not drawn
     under it. a: the size, the script picks 0.3-0.5 (material_reflection's default is 0.75). -->
<effect looping="false">
	<param name="a" default="0.4" />

	<sprite origin="64 64" looping="false" texture="effects/lights/flare.png" material="items/items.mats:gold_reflection"
		pos-y="-16"
		angle="(t+l)*pi*-1"
		scale-x="a*(sin(t*pi))"
		scale-y="a*(sin(t*pi))"
		color-r="0.85"
		color-g="0.95"
		color-b="1"
		color-a="1"
		>
		<frame time="1200">0 0 128 128</frame>
	</sprite>
</effect>
