	<string name="skills.hwp_witch_hunter.tracker.name">Tracker</string>
	<string name="skills.hwp_witch_hunter.tracker.desc">Movement speed up by %speed%.</string>
	<string name="menu.class.hwp_witch_hunter">Witch Hunter</string>
	<string name="menu.class.hwp_witch_hunter.description">The HoH1 crossbow zealot: a hound, a pyre and a burning torch. Masters as Inquisitor (crits and crows), Pyromancer (brands and immolation) or Hunter (a pack of hounds and silver bolts).</string>
	<string name="htitle.hwp_witch_hunter.desc">Grants %num%% Spell Critical Damage, %num-per%% per level.</string>
	<string name="skills.hwp_witch_hunter.mastery_1.name">Inquisitor</string>
