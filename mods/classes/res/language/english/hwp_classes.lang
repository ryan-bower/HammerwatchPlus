	<string name="skills.hwp_witch_hunter.pack.name">Pack</string>
	<string name="skills.hwp_witch_hunter.pack.desc">You can keep %summons% more hounds.</string>
	<string name="skills.hwp_witch_hunter.silver_bolts.name">Silver Bolts</string>
