	<string name="skills.hwp_thief.knives.name">Throwing Knives</string>
	<string name="skills.hwp_thief.knives.desc">Throw a fan of %number% knives for %damage% physical damage each.</string>
	<string name="skills.hwp_thief.smoke.name">Smoke Bomb</string>
	<string name="skills.hwp_thief.smoke.desc">Throw a smoke bomb at the target spot: enemies in a %range% radius are blinded and slowed for %duration%.</string>
	<string name="skills.hwp_thief.sidestep.name">Sidestep</string>
	<string name="skills.hwp_thief.sidestep.desc">You evade %chance% of attacks.</string>
	<string name="skills.hwp_thief.vicious_cuts.name">Vicious Cuts</string>
	<string name="skills.hwp_thief.vicious_cuts.desc">Critical hit chance up by %chance% and critical damage by %damage%.</string>
	<string name="skills.hwp_thief.shadow_strike.name">Shadow Strike</string>
	<string name="skills.hwp_thief.shadow_strike.desc">Leap through the shadows to the target spot, dealing %damage% physical damage and briefly stunning enemies where you land.</string>
	<string name="skills.hwp_thief.backstab.name">Backstab</string>
	<string name="skills.hwp_thief.backstab.desc">Critical hits leave %stacks% stacks of bleeding.</string>
	<string name="skills.hwp_thief.slice.name">Slice and Dice</string>
	<string name="skills.hwp_thief.slice.desc">Work yourself into a frenzy: attack speed up by 30% for %duration%.</string>
	<string name="skills.hwp_thief.caltrops.name">Caltrops</string>
	<string name="skills.hwp_thief.caltrops.desc">Scatter caltrops at the target spot: enemies in a %range% radius take %damage% physical damage, bleed and are slowed.</string>
	<string name="skills.hwp_thief.quick_hands.name">Quick Hands</string>
	<string name="skills.hwp_thief.quick_hands.desc">Attack speed up by %speed%.</string>
	<string name="skills.hwp_thief.cloak.name">Cloak of Shadows</string>
	<string name="skills.hwp_thief.cloak.desc">Melt into the shadows for %duration%: every attack misses you and you move 15% faster.</string>
	<string name="skills.hwp_thief.poisoned_blades.name">Poisoned Blades</string>
	<string name="skills.hwp_thief.poisoned_blades.desc">Hits have a %chance% chance to deal %damage% extra poison damage.</string>
	<string name="skills.hwp_thief.vanish.name">Vanish</string>
	<string name="skills.hwp_thief.vanish.desc">Taking damage has a %chance% chance to cloak you for 2.5 s (at most once every 8 s).</string>
	<string name="menu.class.hwp_thief">Thief</string>
	<string name="menu.class.hwp_thief.description">A HoH1 classic: fast, fragile and always behind you. Throwing knives, a grappling hook and smoke bombs; masters as Assassin (crits and shadow strikes), Trickster (frenzy and caltrops) or Shadow (cloaks and poison).</string>
	<string name="htitle.hwp_thief.desc">Grants %num%% more Gold, %num-per%% per level.</string>
	<string name="skills.hwp_thief.mastery_1.name">Assassin</string>
	<string name="skills.hwp_thief.mastery_2.name">Trickster</string>
	<string name="skills.hwp_thief.mastery_3.name">Shadow</string>
	<string name="skills.hwp_gladiator.net.name">Net</string>
	<string name="skills.hwp_gladiator.net.desc">Cast a weighted net over the target spot: enemies in a %range% radius are immobilized for %duration%.</string>
	<string name="skills.hwp_gladiator.gladius.name">Gladius Throw</string>
	<string name="skills.hwp_gladiator.gladius.desc">Hurl a spinning blade that returns to you, hitting everything on the way for %damage% weapon damage.</string>
	<string name="skills.hwp_gladiator.pit_fighters.name">Pit Fighters</string>
	<string name="skills.hwp_gladiator.pit_fighters.desc">A fellow pit fighter with %health% health follows you and thrusts for %damage% damage. A new one steps in every %cooldown% when the last falls.</string>
	<string name="skills.hwp_gladiator.planned_attack.name">Planned Attack</string>
	<string name="skills.hwp_gladiator.planned_attack.desc">Weapon attacks deal %damage% more damage.</string>
	<string name="skills.hwp_gladiator.riposte.name">Riposte</string>
	<string name="skills.hwp_gladiator.riposte.desc">Enemies that hit you in melee take %damage% physical damage.</string>
	<string name="skills.hwp_gladiator.arena_mastery.name">Arena Mastery</string>
	<string name="skills.hwp_gladiator.arena_mastery.desc">Armor up by %armor% and health by %health%.</string>
	<string name="skills.hwp_gladiator.shield_wall.name">Shield Wall</string>
	<string name="skills.hwp_gladiator.shield_wall.desc">Brace behind your shield: armor and resistance up by 50% for %duration%.</string>
	<string name="skills.hwp_gladiator.beast.name">Arena Beast</string>
	<string name="skills.hwp_gladiator.beast.desc">A war hound with %health% health fights at your side for %damage% damage per bite; a new one arrives every %cooldown% when the last dies.</string>
	<string name="skills.hwp_gladiator.pack_leader.name">Pack Leader</string>
	<string name="skills.hwp_gladiator.pack_leader.desc">You can keep %summons% more beasts.</string>
	<string name="skills.hwp_gladiator.bloodlust.name">Bloodlust</string>
	<string name="skills.hwp_gladiator.bloodlust.desc">Every kill heals you for %heal%.</string>
	<string name="skills.hwp_gladiator.barbed_net.name">Barbed Net</string>
	<string name="skills.hwp_gladiator.barbed_net.desc">A net of hooks: enemies in a %range% radius take %damage% physical damage, bleed and are immobilized.</string>
	<string name="skills.hwp_gladiator.whirl.name">Trident Whirl</string>
	<string name="skills.hwp_gladiator.whirl.desc">Spin your trident around you, hitting everything within %range% for %damage% weapon damage.</string>
	<string name="skills.hwp_gladiator.trident_mastery.name">Trident Mastery</string>
	<string name="skills.hwp_gladiator.trident_mastery.desc">Attacks deal %damage% extra physical damage.</string>
	<string name="menu.class.hwp_gladiator">Gladiator</string>
	<string name="menu.class.hwp_gladiator.description">The HoH1 arena fighter: trident, net and a crowd of pit fighters. Masters as Champion (riposte, armor), Beastmaster (war hounds) or Retiarius (barbed nets and whirling tridents).</string>
	<string name="htitle.hwp_gladiator.desc">Grants %num%% Attack Critical Damage, %num-per%% per level.</string>
	<string name="skills.hwp_gladiator.mastery_1.name">Champion</string>
	<string name="skills.hwp_gladiator.mastery_2.name">Beastmaster</string>
	<string name="skills.hwp_gladiator.mastery_3.name">Retiarius</string>
	<string name="skills.hwp_witch_hunter.torch.name">Searing Torch</string>
	<string name="skills.hwp_witch_hunter.torch.desc">Hits have a %chance% chance to burn for %damage% extra fire damage.</string>
	<string name="skills.hwp_witch_hunter.pyre.name">Pyre</string>
	<string name="skills.hwp_witch_hunter.pyre.desc">Light a pyre with %health% health that burns nearby enemies for %damage% fire damage every second for %duration%.</string>
	<string name="skills.hwp_witch_hunter.hound.name">Hound</string>
	<string name="skills.hwp_witch_hunter.hound.desc">Your hound (%health% health, %damage% damage per bite) hunts with you; a new one comes every %cooldown% when the last falls.</string>
	<string name="skills.hwp_witch_hunter.ward.name">Ward of Branding</string>
	<string name="skills.hwp_witch_hunter.ward.desc">Brand the ground: enemies in a %range% radius take %damage% fire damage and become vulnerable.</string>
	<string name="skills.hwp_witch_hunter.zeal.name">Fanatic Zeal</string>
	<string name="skills.hwp_witch_hunter.zeal.desc">Attack and spell critical chance up by %chance%.</string>
	<string name="skills.hwp_witch_hunter.crows.name">Murder of Crows</string>
	<string name="skills.hwp_witch_hunter.crows.desc">Call down crows on the target spot: enemies in a %range% radius take %damage% physical damage and are blinded.</string>
	<string name="skills.hwp_witch_hunter.judgement.name">Judgement</string>
