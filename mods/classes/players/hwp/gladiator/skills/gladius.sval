			</dict>
		<dict name="actions">
			<array name="cast">
				<!-- the projectile's target is the thrower: the whirling axe's 1200-4500 ms
				     SeekingAng flies it back (the vanilla whirling_axes cast does the same) -->
				<dict>
					<bool name="target-self">true</bool>
				</dict>
				<dict>
					<string name="class">ShootProjectile</string>
					<string name="projectile">players/hwp/gladiator/projectiles/gladius.unit</string>
					<int name="dist">8</int>
				</dict>
				<dict>
					<string name="class">PlaySound</string>
					<string name="sound">event:/sfx/player/attacks/offhand/throwing_knives_throw</string>
				</dict>
			</array>
		</dict>

		<array name="timeline">
			<i>150</i><s>cast</s>
		</array>
	</dict>

