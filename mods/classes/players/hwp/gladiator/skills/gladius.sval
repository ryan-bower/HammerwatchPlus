%include "players/skills_cost.inc"
<dict>
	<string name="name">.skills.hwp_gladiator.gladius.name</string>
	<string name="type-name">.skills.type.spell</string>
	<string name="description">.skills.hwp_gladiator.gladius.desc</string>

	<array name="description-params">
		<array><s>damage</s><s>.skills.desc.params.damage</s><s>120%</s><s>140%</s><s>160%</s><s>180%</s><s>200%</s></array>
		<array><s>mana-cost</s><s>.skills.desc.params.mana_cost</s><s>8</s></array>
		<array><s>cooldown</s><b>t</b><s>.skills.desc.params.cooldown</s><s>3s</s></array>
	</array>

	<array name="icon"><s>players/hwp/gladiator/icons.png</s><i>100</i><vec4>24 0 24 24</vec4></array>

