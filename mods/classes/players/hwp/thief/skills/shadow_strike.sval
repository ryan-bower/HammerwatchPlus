%include "players/skills_cost.inc"
<dict>
	<string name="name">.skills.hwp_thief.shadow_strike.name</string>
	<string name="type-name">.skills.type.spell</string>
	<string name="description">.skills.hwp_thief.shadow_strike.desc</string>

	<array name="description-params">
		<array><s>damage</s><s>.skills.desc.params.damage</s><s>60</s><s>80</s><s>100</s><s>120</s><s>150</s></array>
		<array><s>cooldown</s><b>t</b><s>.skills.desc.params.cooldown</s><s>7s</s></array>
	</array>

	<array name="icon"><s>players/hwp/thief/icons.png</s><i>100</i><vec4>120 0 24 24</vec4></array>

	<string name="id">hwp_thief_shadow_strike</string>
	<string name="type">spell</string>
	<array name="tags"><s>spell</s><s>physical</s></array>
	<int name="starting-level">0</int>

	<dict name="skill">
		<int name="skill-cost">SKILLCOSTMASTERYLEVEL_1</int>
		<string name="class">Skills::PlayerSkillLeap</string>
		<string name="anim">leap</string>
		<int name="anim-length">450</int>
		<string name="leap-snd">event:/sfx/player/classes/warrior/leap/leap</string>
