		<float name="move-speed-mul">0</float>
		<ivec2 name="move-speed">0 150</ivec2>
		<float name="cast-speed-mul">1</float>
		<ivec2 name="blocking">0 150</ivec2>
		<int name="castpoint">80</int>
		<ivec2 name="update-aim">0 80</ivec2>
		<bool name="repeating">false</bool>
		<int name="mana-cost">0</int>
		<int name="radius">40</int>
		<int name="range">180</int>
		<int name="range-min">40</int>
		<bool name="raycast-to-target">true</bool>
		<int name="leap-time">450</int>
		<float name="height">22</float>
		<bool name="height-distance-mul">false</bool>
		<string name="land-fx">effects/generic/other/spawn_smoke_puff.effect</string>
			<dict name="binds">
				<int name="strike-dmg">60</int>
			</dict>
		<array name="land-effects">
			<dict>
				<string name="class">Explode</string>
				<int name="radius">40</int>
				<int name="min-radius">8</int>
				<float name="dist-scaling">1000</float>
				<bool name="hit-self">false</bool>
				<bool name="hit-same-team">false</bool>
				<bool name="hit-different-team">true</bool>
				<array name="effects">
					<dict>
						<bool name="only-actors">true</bool>
					</dict>
					<dict>
						<string name="class">Damage</string>
						<string name="physical-bind">strike-dmg</string>
					</dict>
					<dict>
						<string name="class">ApplyBuff</string>
						<string name="buff">tweak/buffs/status_effects.sval:stun_minor</string>
						<float name="chance">1.0</float>
					</dict>
				</array>
			</dict>
			<dict>
				<string name="class">PlaySound</string>
				<string name="sound">event:/sfx/player/attacks/mainhand/spear_thrust_hit</string>
			</dict>
		</array>
	</dict>

	<array name="upgrades">
