<svals>
	<!-- GameLab-only measurement fixture. Native skill modifier, one selected skill,
	     no damage/trigger shortcuts. The command bounds its lifetime and restores it. -->
	<dict name="qa_skill_crit">
		<bool name="debuff">false</bool>
		<int name="duration">60000</int>
		<array name="modifiers">
			<dict>
				<string name="class">GameLab::QASkillCrit</string>
			</dict>
			<dict>
				<string name="class">GameLab::QASpellCrit</string>
			</dict>
		</array>
	</dict>
</svals>
