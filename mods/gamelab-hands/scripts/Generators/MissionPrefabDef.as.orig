class MissionPrefabDef : SVO
{
	SValue@ m_unloadedData;

	Prefab@ m_prefab;
	ivec2 m_gridOffset;
	ivec2 m_gridSz;
	array<uint8>@ m_gridPattern;
	array<uint8>@ m_gridCommand;

	array<ivec3> m_junctionsUp;
	array<ivec3> m_junctionsDown;
	array<ivec3> m_junctionsLeft;
	array<ivec3> m_junctionsRight;


	MissionPrefabDef@ m_parent;
	array<MissionPrefabDef@> m_variations;


	uint32 m_set;
	int m_maxNum;
	float m_numBoost;
	vec2 m_posJitter;
	array<PlacedPrefabs@> m_placedPrefabs;
	ConditionalList@ m_conditionals;


	uint m_currGenNumId;
	int m_currNum;
	bool m_foundNoPlacement;

	int m_rollChance;
	string m_flagRun;
	bool m_runUnique;
	string m_runUniqueFlag;
	bool m_runUniqueJustLevel;

	uint m_scalarCDRun;
	float m_scalarCDRunValue;


	bool CanGet()
	{
		UnpackGrid();
		
		if (m_currGenNumId != g_genNumId)
		{
			m_currGenNumId = g_genNumId;
			m_currNum = 0;
			m_foundNoPlacement = false;
		}
		
		if (m_foundNoPlacement)
			return false;
		
		bool usable = (m_maxNum < 0 || m_currNum < m_maxNum);
		
		if (usable && m_runUnique && g_flags.IsSet(m_runUniqueFlag))
			usable = false;
		
		if (usable && !CheckGlobalConditionals(m_conditionals))
			usable = false;
		
		for (uint i = 0; i < m_variations.length(); i++)
		{
			if (m_currGenNumId != g_genNumId)
			{
				m_currGenNumId = g_genNumId;
				m_currNum = 0;
				m_foundNoPlacement = false;
			}
			
			if (!(m_variations[i].m_maxNum < 0 || m_variations[i].m_currNum < m_variations[i].m_maxNum))
				continue;
			
			if (!usable && !CheckGlobalConditionals(m_variations[i].m_conditionals))
				continue;
			
			if (!usable && m_runUnique && g_flags.IsSet(m_variations[i].m_runUniqueFlag))
				continue;
			
			usable = true;
		}
		
		return usable;
	}

	MissionPrefabDef@ UsePrefab()
	{
		UnpackGrid();
		
		array<MissionPrefabDef@> possible;
		
		if ((m_maxNum < 0 || m_currNum < m_maxNum) && CheckGlobalConditionals(m_conditionals) && (!m_runUnique || !g_flags.IsSet(m_runUniqueFlag)))
			possible.insertLast(this);
		
		for (uint i = 0; i < m_variations.length(); i++)
		{
			if (!(m_variations[i].m_maxNum < 0 || m_variations[i].m_currNum < m_variations[i].m_maxNum))
				continue;
			
			if (!CheckGlobalConditionals(m_variations[i].m_conditionals))
				continue;
			
			if (m_runUnique && g_flags.IsSet(m_variations[i].m_runUniqueFlag))
				continue;
			
			possible.insertLast(m_variations[i]);
		}
		
		if (possible.length() <= 0)
			return null;
		
		auto picked = possible[randi(possible.length())];
		picked.UnpackGrid();
		
		if (!picked.m_flagRun.isEmpty())
		{
			auto flagRunHash = HashString(picked.m_flagRun);
			bool found = false;
			for (uint i = 0; i < g_dungeonGenRunFlags.length(); i++)
			{
				if (g_dungeonGenRunFlags[i] == flagRunHash)
				{
					found = true;
					break;
				}
			}
			
			if (!found)
			{
				g_dungeonGenRunFlags.insertLast(flagRunHash);
				g_dungeonGenRunFlagNames.insertLast(picked.m_flagRun);
			}
		}
		
		if (m_runUnique)
		{
			if (m_runUniqueJustLevel)
				g_dungeonGenFlags.insertLast(HashString(m_runUniqueFlag));
			else
			{
				g_dungeonGenRunFlags.insertLast(HashString(m_runUniqueFlag));
				g_dungeonGenRunFlagNames.insertLast(m_runUniqueFlag);
			}
		}
		
		if (m_scalarCDRun != 0)
		{
			g_dungeonGenCDScalars.insertLast(m_scalarCDRun);
			g_dungeonGenCDScalarValues.insertLast(m_scalarCDRunValue);
		}
		
		picked.m_currNum++;
		return picked;
	}

	MissionPrefabDef(SValue& params)
	{
	}
	
	bool SVO_Init_Post(SValue& params) 
	{
		UnitPtr u;
		
		@m_prefab = Resources::GetPrefab(m_id);
		
		if (m_prefab is null)
		{
			PrintError("Failed to open prefab '" + m_id + "'");
			return false;
		}
		
		@m_conditionals = LoadConditionals(u, params);
		
		m_maxNum = GetParamInt(u, params, "max-num", false, -1);
		m_numBoost = GetParamFloat(u, params, "num-boost", false, 1);
		m_posJitter = GetParamVec2(u, params, "pos-jitter", false, vec2(0,0));
		
		
		auto placedPfbs = GetParamArray(u, params, "placed-prefabs", false);
		if (placedPfbs !is null)
		{
			for (uint i = 0; i < placedPfbs.length(); i += 2)
			{
				PlacedPrefabs pPfb;
				pPfb.m_id = HashString(placedPfbs[i].GetString());
				pPfb.m_pos = placedPfbs[i + 1].GetIVector2();
				m_placedPrefabs.insertLast(pPfb);
			}
		}
		
		m_rollChance = GetParamInt(u, params, "roll-chance", false, 100);
		m_flagRun = GetParamString(u, params, "flag-run", false);
		m_runUniqueFlag = GetParamString(u, params, "run-unique-flag", false);
		
		if (m_runUniqueFlag.isEmpty())
		{
			m_runUniqueFlag = m_id;
			m_runUnique = GetParamBool(u, params, "run-unique", false);
		}
		else
			m_runUnique = true;
		
		if (m_runUnique)
			m_runUniqueJustLevel = GetParamBool(u, params, "run-unique-just-level", false);
		
		auto scalarCDRun = GetParamString(u, params, "scalar-cd-run", false);
		if (!scalarCDRun.isEmpty())
		{
			m_scalarCDRun = HashString(scalarCDRun);
			m_scalarCDRunValue = GetParamFloat(u, params, "scalar-cd-run-value", true);
		}
		
		auto parentId = GetParamString(u, params, "parent", false);
		@m_parent = MissionPrefabDef::Get(parentId);
		if (m_parent is null)
		{
			if (!parentId.isEmpty())
			{
				PrintError("Can't find parent '"+parentId+"' for '"+m_id+"'");
				return false;
			}
			
			auto setStr = GetParamString(u, params, "theme", false);
			if (setStr.isEmpty())
				setStr = GetParamString(u, params, "set", false);
			
			m_set = HashString(setStr);
		}
		
		if ((m_parent is null) || (params.GetDictionaryEntry("grid-size") !is null))
		{
			m_gridOffset = GetParamIVec2(u, params, "grid-pos") * -1;
			m_gridSz = GetParamIVec2(u, params, "grid-size");
			
			//UnpackGrid();
			@m_unloadedData = params;
			
			auto junctions = GetParamArray(u, params, "junctions", false);
			if (junctions !is null)
			{
				auto jUp = junctions[0].GetArray();
				for (uint i = 0; i < jUp.length(); i++)
					m_junctionsUp.insertLast(jUp[i].GetIVector3());
				auto jDn = junctions[1].GetArray();
				for (uint i = 0; i < jDn.length(); i++)
					m_junctionsDown.insertLast(jDn[i].GetIVector3());
				auto jLf = junctions[2].GetArray();
				for (uint i = 0; i < jLf.length(); i++)
					m_junctionsLeft.insertLast(jLf[i].GetIVector3());
				auto jRg = junctions[3].GetArray();
				for (uint i = 0; i < jRg.length(); i++)
					m_junctionsRight.insertLast(jRg[i].GetIVector3());
				
				
				for (uint i = 0; i < m_junctionsUp.length(); i++)
					m_junctionsUp[i].x += int(m_junctionsUp[i].z / 2.0f - 0.5f);
				for (uint i = 0; i < m_junctionsDown.length(); i++)
					m_junctionsDown[i].x += int(m_junctionsDown[i].z / 2.0f - 0.5f);
				
				for (uint i = 0; i < m_junctionsLeft.length(); i++)
					m_junctionsLeft[i].y += m_junctionsLeft[i].z / 2 - 2;
				for (uint i = 0; i < m_junctionsRight.length(); i++)
					m_junctionsRight[i].y += m_junctionsRight[i].z / 2 - 2;
				
				
				/*
				// Bugfix??
				for (uint i = 0; i < m_junctionsUp.length(); i++)
					m_junctionsUp[i].x += 1;
				for (uint i = 0; i < m_junctionsDown.length(); i++)
					m_junctionsDown[i].x += 1;
				*/
			}
			
			
		}
		else if (m_parent !is null)
		{
			m_gridOffset = m_parent.m_gridOffset;
			m_gridSz = m_parent.m_gridSz;
			@m_gridPattern = m_parent.m_gridPattern;
			@m_gridCommand = m_parent.m_gridCommand;
			
			m_junctionsUp = m_parent.m_junctionsUp;
			m_junctionsDown = m_parent.m_junctionsDown;
			m_junctionsLeft = m_parent.m_junctionsLeft;
			m_junctionsRight = m_parent.m_junctionsRight;
		}
		
		if (m_parent !is null)
		{
			m_parent.m_variations.insertLast(this);
		}
		
		return true;
	}
	
	void UnpackGrid()
	{
		if (m_parent !is null && m_parent.m_unloadedData !is null)
			m_parent.UnpackGrid();
		
		if (m_parent !is null && m_gridPattern is null)
		{
			@m_gridPattern = m_parent.m_gridPattern;
			@m_gridCommand = m_parent.m_gridCommand;
		}
		
		if (m_unloadedData is null)
			return;
		
		%PROFILE_SCOPE UnpackGridInMissionPrefab
		
		UnitPtr u;
		
		array<uint8>@ packed;
		@packed = GetParamByteArray(u, m_unloadedData, "grid-pattern-rle", false);
		if (packed !is null)
			@m_gridPattern = UnpackRLECompressed(packed);
		else
			@m_gridPattern = GetParamByteArray(u, m_unloadedData, "grid-pattern", false);
		
		
		@packed = GetParamByteArray(u, m_unloadedData, "grid-command-rle", false);
		if (packed !is null)
			@m_gridCommand = UnpackRLECompressed(packed);
		else
			@m_gridCommand = GetParamByteArray(u, m_unloadedData, "grid-command", false);
		
		@m_unloadedData = null;
	}
}

namespace MissionPrefabDef
{
	array<MissionPrefabDef@> GetPossiblePrefabs(uint set)
	{
		array<MissionPrefabDef@> ret;
		for (uint i = 0; i < MissionPrefabDef::Instances.length(); i++)
		{
			if (MissionPrefabDef::Instances[i].m_set != set)
				continue;
			
			if (MissionPrefabDef::Instances[i].CanGet())
				ret.insertAt(randi(ret.length()), MissionPrefabDef::Instances[i]);
		}
		return ret;
	}

	int RollIndex(array<MissionPrefabDef@>@ prefabs)
	{
		int numPfbs = prefabs.length();
		if (numPfbs <= 0)
			return -1;
		
		int totChance = 0;
		for (int i = 0; i < numPfbs; i++)
			totChance += prefabs[i].m_rollChance;
		
		int r = randi(totChance);
		for (int i = 0; i < numPfbs; i++)
		{
			r -= prefabs[i].m_rollChance;
			if (r < 0)
				return i;
		}
		
		return randi(numPfbs);
	}
}