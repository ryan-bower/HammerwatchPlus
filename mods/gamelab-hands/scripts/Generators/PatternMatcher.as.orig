enum Pattern
{
	Nothing		= 1,
	Floor		= 2,
	NotFloor	= 3,
	Breakable	= 4,
	Wall		= 5,
	NotWall		= 6,
	Walkable	= 7,
	NotWalkable	= 8,
	Cliff		= 9,
	Anything	= 10,
	Red 		= 11,
	Blue 		= 12,
	Yellow 		= 13
}

enum PatternCommand
{
	Ignore,
	Reserve,
	ReserveWall,
	ReserveFloor,
	ReserveCliff,
	PlaceWall,
	PlaceFloor,
	Wall,
	Floor,
	Cliff,
	Red,
	Blue,
	Yellow
}


namespace PatternMatcher
{
