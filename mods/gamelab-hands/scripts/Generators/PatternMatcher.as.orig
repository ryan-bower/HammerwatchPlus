	// The OPT_OPT_FindAllPatterns method needs to be compiled into engine code. As of right now (12/05/26), the engine one does
	// not serve the Red, Blue and Yellow Patterns/Cells
	array<ivec2>@ FindAllPatterns(CellGrid@ grid, array<uint8>@ pattern, ivec2 patternSz, bool findReserved = false)
	{
		%PROFILE_SCOPE FindAllPatterns
		
		array<ivec2>@ matches;
%if !EDITOR
		@matches = OPT_FindAllPatterns(pattern, grid.m_grid, grid.m_gridConsumed, ivec2(grid.m_width, grid.m_height), patternSz, findReserved);
%else
		@matches = array<ivec2>();
		
		int sHeight = grid.m_height - patternSz.y - 1;
		int sWidth = grid.m_width - patternSz.x - 1;
		
		auto@ gridD = grid.m_grid;
		auto@ gridConsumed = grid.m_gridConsumed;
		
		
		for (int y = 1; y < sHeight; y++)
		{
			for (int x = 1; x < sWidth; x++)
			{
				bool match = true;
				for (int px = 0; px < patternSz.x; px++)
				{
					for (int py = 0; py < patternSz.y; py++)
					{
						auto cell = gridD[x + px][y + py];
						
						switch (pattern[py * patternSz.x + px])
						{
						case Pattern::Nothing:
							if (cell != Cell::Nothing)
								match = false;
							break;
						
						case Pattern::Wall:
							if (cell != Cell::Wall && cell != Cell::PlaceWall)
								match = false;
							break;
							
						case Pattern::NotWall:
							if (cell == Cell::Wall || cell == Cell::PlaceWall)
								match = false;
							break;
							
						case Pattern::Breakable:
							if (cell != Cell::Breakables)
								match = false;
							break;
							
						case Pattern::Floor:
							if (cell != Cell::Floor && cell != Cell::PlaceFloor)
								match = false;
							break;
							
						case Pattern::NotFloor:
							if (cell == Cell::Floor || cell == Cell::PlaceFloor)
								match = false;
							break;
							
						case Pattern::Cliff:
							if (cell != Cell::Cliff)
								match = false;
							break;
							
						case Pattern::Walkable:
							if (!(cell == Cell::Floor || cell == Cell::Breakables || cell == Cell::PlaceFloor))
								match = false;
							break;
							
						case Pattern::NotWalkable:
							if (cell == Cell::Floor || cell == Cell::Breakables || cell == Cell::PlaceFloor)
								match = false;
							break;

						case Pattern::Red:
							if (cell != Cell::Red)
								match = false;
							break;

						case Pattern::Blue:
							if (cell != Cell::Blue)
								match = false;
							break;

						case Pattern::Yellow:
							if (cell != Cell::Yellow)
								match = false;
							break;
						}
						
						if (match && !findReserved && gridConsumed[x + px][y + py])
							match = false;
						
						if (!match)
							break;
					}
					
					if (!match)
						break;
				}
				
				if (match)
					matches.insertLast(ivec2(x, y));
			}
		}
%endif
		
		return matches;
	}

	void ExecutePrefabCommands(CellGrid@ grid, ivec2 pos, array<uint8>@ commands, ivec2 patternSz)
	{
		%PROFILE_SCOPE ExecutePrefabCommands
		
		for (int y = 0; y < patternSz.y; y++)
		{
			for (int x = 0; x < patternSz.x; x++)
			{
				auto cmd = PatternCommand(commands[y * patternSz.x + x]);
				if (cmd == PatternCommand::Ignore)
					continue;
				
				switch (cmd)
				{
				case PatternCommand::Reserve:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Reserved);
					grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				case PatternCommand::ReserveWall:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Wall);
					grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				case PatternCommand::ReserveFloor:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Floor);
					grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				case PatternCommand::ReserveCliff:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Cliff);
					grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				case PatternCommand::Wall:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Wall);
					break;
				case PatternCommand::PlaceWall:
					grid.SetCell(pos.x + x, pos.y + y, Cell::PlaceWall);
					grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				case PatternCommand::PlaceFloor:
					grid.SetCell(pos.x + x, pos.y + y, Cell::PlaceFloor);
					grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				case PatternCommand::Floor:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Floor);
					break;
				case PatternCommand::Cliff:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Cliff);
					break;
				case PatternCommand::Red:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Red);
					grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				case PatternCommand::Blue:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Blue);
					grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				case PatternCommand::Yellow:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Yellow);
					grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				/*
				case PatternCommand::PlaceCliff:
					grid.SetCell(pos.x + x, pos.y + y, Cell::PlaceCliff);
					grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				*/
				}
			}
		}
	}

	void CopyPrefabPattern(CellGrid@ grid, ivec2 pos, array<uint8>@ pattern, array<uint8>@ commands, ivec2 patternSz)
	{
		%PROFILE_SCOPE CopyPrefabPattern
		
		for (int y = 0; y < patternSz.y; y++)
		{
			for (int x = 0; x < patternSz.x; x++)
			{
				auto ptrn = Pattern(pattern[y * patternSz.x + x]);
				auto cmd = PatternCommand(commands[y * patternSz.x + x]);
				
				bool isReserve = false;
				switch (cmd)
				{
				case PatternCommand::Reserve:
				case PatternCommand::ReserveWall:
				case PatternCommand::ReserveFloor:
				case PatternCommand::ReserveCliff:
					grid.SetConsumed(pos.x + x, pos.y + y);
					isReserve = true;
					break;
				case PatternCommand::Wall:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Wall);
					break;
				case PatternCommand::PlaceWall:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Wall);
					//grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				case PatternCommand::PlaceFloor:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Floor);
					//grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				case PatternCommand::Floor:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Floor);
					break;
				/*
				case PatternCommand::PlaceCliff:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Cliff);
					//grid.SetConsumed(pos.x + x, pos.y + y);
					break;
				*/
				case PatternCommand::Cliff:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Cliff);
					break;
				case PatternCommand::Red:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Red);
					break;
				case PatternCommand::Blue:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Blue);
					break;
				case PatternCommand::Yellow:
					grid.SetCell(pos.x + x, pos.y + y, Cell::Yellow);
					break;
				}
				
				if (ptrn == Pattern::Wall)
					grid.SetCell(pos.x + x, pos.y + y, Cell::Wall);
				if (ptrn == Pattern::Cliff)
					grid.SetCell(pos.x + x, pos.y + y, Cell::Cliff);
				else if (ptrn == Pattern::Walkable || isReserve)
					grid.SetCell(pos.x + x, pos.y + y, Cell::Floor);
			}
		}
	}

}