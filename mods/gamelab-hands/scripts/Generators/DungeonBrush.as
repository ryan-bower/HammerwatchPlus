	void PlacePaddingColor(Scene@ scene, BaseBrushTiles@  bt)
	{
		if (m_ignorePaddingColor)
			return;
	
		int tilesz = 1024;
	
		int w = int(ceil(m_width / (tilesz / 16.0f)));
		int h = int(ceil(m_height / (tilesz / 16.0f)));
	
		
		for (int x = -1; x < (w + 1); x++)
		{
			bt.c1024.Produce(scene, vec3(tilesz * x + m_posOffset.x, m_posOffset.y - 24, 0));
			bt.c1024.Produce(scene, vec3(tilesz * x + m_posOffset.x, m_height * 16 + m_posOffset.y + tilesz - 40, 0));
		}
		
		for (int y = 0; y < h; y++)
		{
			bt.c1024.Produce(scene, vec3(m_posOffset.x - tilesz + 8, tilesz * y + m_posOffset.y + tilesz - 24, 0));
			bt.c1024.Produce(scene, vec3(m_posOffset.x + m_width * 16 - 8, tilesz * y + m_posOffset.y + tilesz - 24, 0));
		}
	}
	
