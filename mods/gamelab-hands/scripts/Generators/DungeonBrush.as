		m_ignorePaddingColor = GetParamBool(u, params, "ignore-pad-color", false, false);
		
		
		auto paintingArr = GetParamArray(u, params, "painting", false);
		uint numPainting = (paintingArr !is null) ? paintingArr.length() : 0;
		for (uint i = 0; i < numPainting; i++)
		{
			auto painter = cast<DungeonBrush::IPainter>(InstantiateClass(GetParamString(u, paintingArr[i], "class", true), u, paintingArr[i]));
			if (painter !is null)
				m_painting.insertLast(painter);
		}
		
		
		auto breakablesArr = GetParamArray(u, params, "breakables", false);
		uint numBreakables = (breakablesArr !is null) ? breakablesArr.length() : 0;
		for (uint i = 0; i < numBreakables; i += 3)
		{
			int chance = breakablesArr[i+0].GetInteger();
			auto unitProd = Resources::GetUnitProducer(breakablesArr[i+1].GetString());
			
			if (unitProd is null)
				continue;
			
			if (breakablesArr[i+2].GetType() == SValueType::Integer)
				m_breakables.insertLast(SizedUnitFillEntry(chance, unitProd, breakablesArr[i+2].GetInteger()));
			else if (breakablesArr[i+2].GetType() == SValueType::IVector2)
				m_breakables.insertLast(SizedUnitFillEntry(chance, unitProd, breakablesArr[i+2].GetIVector2()));
		}
		
		m_totBreakableChance = 0;
		for (uint i = 0; i < m_breakables.length(); i++)
			m_totBreakableChance += m_breakables[i].m_chance;
	}

