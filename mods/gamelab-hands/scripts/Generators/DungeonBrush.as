	void FillBreakablesZone(int x, int y, int w, int h)
	{
		//print("FillBreakablesZone " + ivec4(x, y, w, h));
	
		int xPos = 0;
		int yPos = 0;
		int largestHThisRow = 0;
		
		int numFails = 0;
		while (numFails < 5)
		{
			SizedUnitFillEntry@ breakable = null;
			
			int r = GameLab::GenRandi(m_totBreakableChance);
			for (uint j = 0; j < m_breakables.length(); j++)
			{
				r -= m_breakables[j].m_chance;
				if (r < 0)
				{
					//print("Got breakable "+j+", (" + m_totBreakableChance + ")");
					@breakable = m_breakables[j];
					break;
				}
			}
			
			if (breakable is null || (yPos + breakable.m_height) > h)
			{
				numFails++;
				continue;
			}
			
			if ((xPos + breakable.m_width) > w)
			{
				yPos += largestHThisRow;
				xPos = 0;
				largestHThisRow = 0;
			}
			
			if (breakable.m_height > largestHThisRow)
				largestHThisRow = breakable.m_height + GameLab::GenRandi(2);
			
			if (breakable.m_prod !is null)
			{
				float yOffset = breakable.m_height / 2 + (largestHThisRow - breakable.m_height) * GameLab::GenRandf();
				auto pos = vec3(x + xPos + breakable.m_width / 2 + GameLab::GenRandi(-1, 1), y + yPos + yOffset, 0);
				breakable.m_prod.Produce(g_scene, pos);
				//print("Adding breakable, w: " + breakable.m_width + ", h: " + breakable.m_height);
			}
			
			xPos += breakable.m_width;
			//print("At pos " + xPos + ", " + yPos);
		}
	}
	
	void PlaceEnemySpots(Scene@ scene, DungeonEnemyPlacer@ enemyPlacer)
	{
		if (enemyPlacer is null)
			return;
		
		PreloaderYield();
		
		for (int y = 0; y < m_height; y++)
		{
			for (int x = 0; x < m_width; x++)
			{
				if (m_gridConsumed[x][y])
					continue;
				
				auto cell = m_grid[x][y];
				if(cell != Cell::Floor)
					continue;
				
				ivec3 center = FindFloorCenter(x, y);
				if (center.z <= enemyPlacer.m_autoSpotMinRadius)
					continue;
				
				if (GameLab::GenRandf() >= enemyPlacer.m_autoSpotChance)
					continue;
				
				PlaceEnemyPlacement(scene, enemyPlacer, center);
			}
		}
	}
	
	void PlaceEnemyPlacement(Scene@ scene, DungeonEnemyPlacer@ enemyPlacer, ivec3 center)
	{
		PreloaderYield();
		
		int px = center.x;
		int py = center.y;
		int totd = 0;
		
		for (int d = 0; d <= center.z; d++)
		{
			int startx = max(0, px - d);
			int starty = max(0, py - d);
			int endx = min(m_width - 1, px + d);
			int endy = min(m_height - 1, py + d);
			
			for (int x = startx; x < endx; x++)
			{
				for (int y = starty; y < endy; y++)
				{
					auto cell = m_grid[x][y];
					if(cell != Cell::Floor || m_gridConsumed[x][y])
					{
						totd = d;
						d = center.z + 100;
						x = px + d + 100;
						y = py + d + 100;
						break;
					}
				}
			}
		}
		
		int minx = max(0, px - totd);
		int miny = max(0, py - totd);
		int maxx = min(m_width - 1, px + totd);
		int maxy = min(m_height - 1, py + totd);
		
		for (int x = minx; x < maxx; x++)
			for (int y = miny; y < maxy; y++)
				m_gridConsumed[x][y] = true;
		
		if (totd <= enemyPlacer.m_autoSpotMinRadius)
			return;
		
		vec2 pos(16 * center.x + m_posOffset.x, 16 * center.y + m_posOffset.y);
		auto script = scene.PlaceWorldScript("EnemyPlacement", pos);
		if (script !is null)
		{
			script.SetParamString("Type", "few");
			script.SetParamInt("Spread", (totd + 1) * 16 / 2 - 4, false);
			script.SetParamBool("Generated", true);
		}
	}
	
	ivec3 FindFloorCenter(int px, int py)
	{
		const int maxSteps = 8;
		ivec3 ret;
		
		{
			int minx = 0;
			int maxx = 0;
			
			for (uint i = 0; i < maxSteps; i++)
			{
				minx = px - i;
				if (minx <= 0 || minx >= (m_width - 1) || m_gridConsumed[minx][py] || m_grid[minx][py] != Cell::Floor)
					break;
			}
			
			for (uint i = 0; i < maxSteps; i++)
			{
				maxx = px + i;
				if (maxx <= 0 || maxx >= (m_width - 1) || m_gridConsumed[maxx][py] || m_grid[maxx][py] != Cell::Floor)
					break;
			}
			
			ret.z = maxx - minx;
			
			ret.x = GameLab::GenRollRound((maxx - minx) / 2.0f) + minx;
			px = ret.x;
		}
		
		{
			int miny = 0;
			int maxy = 0;
			
			for (uint i = 0; i < maxSteps; i++)
			{
				miny = py - i;
				if (miny <= 0 || miny >= (m_height - 1) || m_gridConsumed[px][miny] || m_grid[px][miny] != Cell::Floor)
					break;
			}
			
			for (uint i = 0; i < maxSteps; i++)
			{
				maxy = py + i;
				if (maxy <= 0 || maxy >= (m_height - 1) || m_gridConsumed[px][maxy] || m_grid[px][maxy] != Cell::Floor)
					break;
			}
			
			ret.z = min(ret.z, maxy - miny);
			ret.y = GameLab::GenRollRound((maxy - miny) / 2.0f) + miny;
		}
		
		return ret;
	}
	
	void RemoveNearbySame(array<DungeonBrushDeco@>@ deco, int dist)
	{
		PreloaderYield();
		dist = dist * dist;
		
		while(true)
		{
			bool removed = false;
			for (uint i = 0; i < deco.length(); i++)
			{
				for (uint j = 0; j < deco.length(); j++)
				{
					if (i == j)
						continue;
					
					if (deco[i].m_type !is deco[j].m_type)
						continue;
					
					if (distsq(deco[i].m_pos, deco[j].m_pos) > dist)
						continue;
					
					if (GameLab::GenRandi(2) == 0)
						deco.removeAt(i--);
					else
						deco.removeAt(j);
					
					removed = true;
					break;
				}
			}
			
			if (!removed)
				break;
		}
	}
	
	
