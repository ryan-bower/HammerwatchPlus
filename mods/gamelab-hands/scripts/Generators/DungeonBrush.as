	void SpawnDeco(array<DungeonBrushDeco@>@ deco)
	{
		PreloaderYield();
		
		for (uint i = 0; i < deco.length(); i++)
			deco[i].m_type.Produce(g_scene, deco[i].m_pos);
		
		deco.removeRange(0, deco.length());
	}
