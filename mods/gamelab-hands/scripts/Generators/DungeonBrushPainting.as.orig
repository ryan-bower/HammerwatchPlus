namespace DungeonBrush
{
	interface IPainter
	{
		void Paint(Scene@ scene, DungeonBrush@ brush);
	}

	class FillAll : IPainter
	{
		Tileset@ m_tileset;
		int m_padding;
		ConditionalList@ m_conditionals;
		
		FillAll(UnitPtr u, SValue& params)
		{
			@m_tileset = Resources::GetTileset(GetParamString(u, params, "tileset", true));
			m_padding = GetParamInt(u, params, "padding", false, 400);
			@m_conditionals = LoadConditionals(u, params);
		}
		
		void Paint(Scene@ scene, DungeonBrush@ brush)
		{
			if (!CheckGlobalConditionals(m_conditionals))
				return;
			
			print("DungeonBrush::FillAll");
			%PROFILE_SCOPE DungeonBrush::FillAll
			
			scene.PaintTileset(m_tileset, vec4(brush.m_posOffset.x - m_padding, brush.m_posOffset.y - m_padding, brush.m_width * 16 + m_padding * 2, brush.m_height * 16 + m_padding * 2));
		}
	}

	class SpreadSpots : IPainter
	{
		Tileset@ m_tileset;
		float m_chance;
		ivec2 m_size;
		bool m_ignoreReserved;
		bool m_nearWalls;
		array<UnitProducer@> m_units;
		array<int> m_unitChances;
		int m_totUnitChance;
		ivec2 m_numUnits;
		ConditionalList@ m_conditionals;
		
		SpreadSpots(UnitPtr u, SValue& params)
		{
			@m_tileset = Resources::GetTileset(GetParamString(u, params, "tileset", true));
			m_chance = GetParamFloat(u, params, "chance", false, 0.33f);
			m_size = GetParamIVec2(u, params, "size", false, ivec2(8, 32));
			m_ignoreReserved = GetParamBool(u, params, "ignore-reserved", false, true);
			m_nearWalls = GetParamBool(u, params, "near-walls", false, false);
			@m_conditionals = LoadConditionals(u, params);
			
			auto unitsArr = GetParamArray(u, params, "units", false);
			if (unitsArr !is null)
			{
				m_numUnits = GetParamIVec2(u, params, "num-units", false, ivec2(0, 3));
				for (uint i = 0; i < unitsArr.length(); i += 2)
				{
					auto chance = unitsArr[i].GetInteger();
					if (chance <= 0)
						continue;
					
					m_units.insertLast(Resources::GetUnitProducer(unitsArr[i+1].GetString()));
					m_unitChances.insertLast(chance);
					m_totUnitChance += chance;
				}
			}
		}
		
		void Paint(Scene@ scene, DungeonBrush@ brush)
		{
			if (!CheckGlobalConditionals(m_conditionals))
				return;
			
			print("DungeonBrush::SpreadSpots");
			%PROFILE_SCOPE DungeonBrush::SpreadSpots
			
			int w = brush.m_width;
			int h = brush.m_height;
			
			for (int y = 0; y < h; y++)
			{
				for (int x = 0; x < w; x++)
				{
					if (m_ignoreReserved && brush.m_gridConsumed[x][y])
						continue;
					
					auto cell = brush.m_grid[x][y];
					if(cell == Cell::Floor || cell == Cell::Breakables)
					{
						float chance = m_chance;
						
						if (m_nearWalls)
						{
							int wl = 0;
							if (brush.IsWall(x, y - 1)) wl++;
							if (brush.IsWall(x - 1, y - 1)) wl++;
							if (brush.IsWall(x + 1, y - 1)) wl++;
							if (brush.IsWall(x - 1, y)) wl++;
							if (brush.IsWall(x + 1, y)) wl++;
							if (brush.IsWall(x - 1, y + 1)) wl++;
							if (brush.IsWall(x + 1, y + 1)) wl++;
							chance *= wl / 4.0f;
						}
						
						if (randf() > chance)
							continue;
						
						float sizeRand = randf();
						int size = Modifiers::lerp(m_size, sizeRand);
						
						vec2 pos(16 * x + brush.m_posOffset.x + 8, 16 * y + brush.m_posOffset.y + 8);
						
						if (m_tileset !is null)
							scene.PaintTileset(m_tileset, pos, size);
						
						if (m_totUnitChance > 0)
						{
							auto numToSpawn = Modifiers::lerp(m_numUnits, sizeRand);
							for (int i = 0; i < numToSpawn; i++)
							{
								int r = randi(m_totUnitChance);
								for (uint j = 0; j < m_unitChances.length(); j++)
								{
									r -= m_unitChances[j];
									if (r < 0)
									{
										if (m_units[j] !is null)
											m_units[j].Produce(g_scene, xyz(pos + randdir(false) * (size - 5)));
										break;
									}
								}
							}
						}
					}
				}
			}
		}
	}

	class DrawWallTrim : IPainter
	{
		Tileset@ m_tileset;
		float m_chance;
		ConditionalList@ m_conditionals;
		
		DrawWallTrim(UnitPtr u, SValue& params)
		{
			@m_tileset = Resources::GetTileset(GetParamString(u, params, "tileset", true));
			m_chance = GetParamFloat(u, params, "chance", false, 1.0f);
			@m_conditionals = LoadConditionals(u, params);
		}
		
		void Paint(Scene@ scene, DungeonBrush@ brush)
		{
			if (!CheckGlobalConditionals(m_conditionals))
				return;
			
			print("DungeonBrush::DrawWallTrim");
			%PROFILE_SCOPE DungeonBrush::DrawWallTrim
			
			int w = brush.m_width;
			int h = brush.m_height;
			float offX = brush.m_posOffset.x + 8;
			float offY = brush.m_posOffset.y + 8;

			if (m_tileset.GetTileSize() == 8)
			{
				for (int y = 0; y < h; y++)
				{
					for (int x = 0; x < w; x++)
					{
						if (brush.m_gridConsumed[x][y])
							continue;
						
						auto cell = brush.m_grid[x][y];
						if(cell != Cell::Floor)
							continue;
						
						vec2 pos = vec2(16 * x + offX, 16 * y + offY);
						
						if (brush.IsWall(x, y - 1))
						{
							if (randf() <= m_chance)
								scene.PaintTileset(m_tileset, pos + vec2(-4, -4), 8);
							if (randf() <= m_chance)
								scene.PaintTileset(m_tileset, pos + vec2(4, -4), 8);
						}
						
						if (brush.IsWall(x, y + 1))
						{
							if (randf() <= m_chance)
								scene.PaintTileset(m_tileset, pos + vec2(-4, 4), 8);
							if (randf() <= m_chance)
								scene.PaintTileset(m_tileset, pos + vec2(4, 4), 8);
						}
						
						if (brush.IsWall(x - 1, y))
						{
							if (randf() <= m_chance)
								scene.PaintTileset(m_tileset, pos + vec2(-4, -4), 8);
							if (randf() <= m_chance)
								scene.PaintTileset(m_tileset, pos + vec2(-4, 4), 8);
						}
						
						if (brush.IsWall(x + 1, y))
						{
							if (randf() <= m_chance)
								scene.PaintTileset(m_tileset, pos + vec2(4, -4), 8);
							if (randf() <= m_chance)
								scene.PaintTileset(m_tileset, pos + vec2(4, 4), 8);
						}
						
						if (brush.IsWall(x - 1, y - 1) && randf() <= m_chance)
							scene.PaintTileset(m_tileset, pos + vec2(-4, -4), 8);
						if (brush.IsWall(x + 1, y - 1) && randf() <= m_chance)
							scene.PaintTileset(m_tileset, pos + vec2(4, -4), 8);
						if (brush.IsWall(x - 1, y + 1) && randf() <= m_chance)
							scene.PaintTileset(m_tileset, pos + vec2(-4, 4), 8);
						if (brush.IsWall(x + 1, y + 1) && randf() <= m_chance)
							scene.PaintTileset(m_tileset, pos + vec2(4, 4), 8);
					}
				}
			}
			else if (m_tileset.GetTileSize() == 16)
			{
				for (int y = 0; y < h; y++)
				{
					for (int x = 0; x < w; x++)
					{
						if (brush.m_gridConsumed[x][y])
							continue;
						
						auto cell = brush.m_grid[x][y];
						if(cell != Cell::Floor)
							continue;
						
						if ((randf() <= m_chance) && (
							brush.IsWall(x, y - 1) ||
							brush.IsWall(x, y + 1) ||
							brush.IsWall(x - 1, y) ||
							brush.IsWall(x + 1, y) ||
							brush.IsWall(x - 1, y - 1) ||
							brush.IsWall(x + 1, y - 1) ||
							brush.IsWall(x - 1, y + 1) ||
							brush.IsWall(x + 1, y + 1)))
						{
							vec2 pos = vec2(16 * x + offX, 16 * y + offY);
							scene.PaintTileset(m_tileset, pos, 16);
						}
					}
				}
			}
		}
	}


	class SpreadUnits : IPainter
	{
		float m_chance;
		vec2 m_scatter;
		int m_unitMinDist;
		bool m_ignoreReserved;
		bool m_nearWalls;
		array<UnitProducer@> m_units;
		array<int> m_unitChances;
		int m_totUnitChance;
		ivec2 m_numUnits;
		ConditionalList@ m_conditionals;
		
		SpreadUnits(UnitPtr u, SValue& params)
		{
			m_chance = GetParamFloat(u, params, "chance", false, 0.33f);
			m_scatter = GetParamVec2(u, params, "scatter", false, vec2(8, 8));
			m_ignoreReserved = GetParamBool(u, params, "ignore-reserved", false, true);
			m_nearWalls = GetParamBool(u, params, "near-walls", false, false);
			@m_conditionals = LoadConditionals(u, params);
			
			m_unitMinDist = GetParamInt(u, params, "min-dist", false, 0);
			auto unitsArr = GetParamArray(u, params, "units", false);
			if (unitsArr !is null)
			{
				m_numUnits = GetParamIVec2(u, params, "num-units", false, ivec2(0, 3));
				for (uint i = 0; i < unitsArr.length(); i += 2)
				{
					auto chance = unitsArr[i].GetInteger();
					if (chance <= 0)
						continue;
					
					m_units.insertLast(Resources::GetUnitProducer(unitsArr[i+1].GetString()));
					m_unitChances.insertLast(chance);
					m_totUnitChance += chance;
				}
			}
		}
		
		void Paint(Scene@ scene, DungeonBrush@ brush)
		{
			if (!CheckGlobalConditionals(m_conditionals))
				return;
			
			print("DungeonBrush::SpreadUnits");
			%PROFILE_SCOPE DungeonBrush::SpreadUnits
			
			int w = brush.m_width;
			int h = brush.m_height;
			
			array<DungeonBrushDeco@> spawnedUnits;
			
			for (int y = 0; y < h; y++)
			{
				for (int x = 0; x < w; x++)
				{
					if (m_ignoreReserved && brush.m_gridConsumed[x][y])
						continue;
					
					auto cell = brush.m_grid[x][y];
					if(cell == Cell::Floor || cell == Cell::Breakables)
					{
						float chance = m_chance;
						
						if (m_nearWalls)
						{
							int wl = 0;
							if (brush.IsWall(x, y - 1)) wl++;
							if (brush.IsWall(x - 1, y - 1)) wl++;
							if (brush.IsWall(x + 1, y - 1)) wl++;
							if (brush.IsWall(x - 1, y)) wl++;
							if (brush.IsWall(x + 1, y)) wl++;
							if (brush.IsWall(x - 1, y + 1)) wl++;
							if (brush.IsWall(x + 1, y + 1)) wl++;
							chance *= wl / 4.0f;
						}
						
						if (randf() > chance)
							continue;
						
						vec2 pos(16 * x + brush.m_posOffset.x + 8, 16 * y + brush.m_posOffset.y + 8);
						
						if (m_totUnitChance > 0)
						{
							auto numToSpawn = Modifiers::lerp(m_numUnits, randf());
							for (int i = 0; i < numToSpawn; i++)
							{
								int r = randi(m_totUnitChance);
								for (uint j = 0; j < m_unitChances.length(); j++)
								{
									r -= m_unitChances[j];
									if (r < 0)
									{
										if (m_units[j] !is null)
											spawnedUnits.insertLast(DungeonBrushDeco(m_units[j], xyz(pos + randdir(false) * m_scatter)));
										break;
									}
								}
							}
						}
					}
				}
			}
			
			if (m_unitMinDist > 0)
				brush.RemoveNearby(spawnedUnits, m_unitMinDist);
			
			brush.SpawnDeco(spawnedUnits);
		}
	}

}
