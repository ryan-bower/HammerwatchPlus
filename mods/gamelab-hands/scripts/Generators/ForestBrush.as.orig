class ForestBrush : DungeonBrush
{
	void Initialize(int width, int height, vec2 posOffset) override
	{
		@m_grid = array<array<Cell>>(width, array<Cell>(height, Cell::Floor));
		@m_gridConsumed = array<array<bool>>(width, array<bool>(height, false));
		@m_pointsOfInterest = array<DungeonPointOfInterest>();
		
		m_width = width;
		m_height = height;
		m_posOffset = posOffset;
		
		
		m_posOffset.x = int(m_posOffset.x / 64.0) * 64.0;
		m_posOffset.y = int(m_posOffset.y / 64.0) * 64.0;
		
		
		m_dbgImageOutNum = 1;
		m_dbgImageOutId = randi(9999999);
	}


	void Build(Scene@ scene) override
	{
		SpawnPointsOfInterest(scene);

		for (uint i = 0; i < m_painting.length(); i++)
			m_painting[i].Paint(scene, this);

		DoLighting(scene);
	}
}
