class DungeonGenCarveContext
{
	DungeonBrush@ brush;
	PrefabPlacement@ pfbPlacer;
	array<ivec3> junctions;
	array<ivec4> rooms;
}

class DungeonGenerationCarveInitial : DungeonGenerationCommands
{
	float m_density;
	int m_padding;
	float m_roomChance;
	float m_roomPfbChance;
	float m_startPfbChance;
	float m_furthestJunctionChance;

	ivec2 m_roomWidth;
	ivec2 m_roomHeight;

	ivec2 m_pathWidth;
	ivec2 m_pathHeight;

	ivec2 m_pathLenX;
	ivec2 m_pathLenY;

	string m_startPfbSet;
	string m_roomPfbSet;


	void LoadParams(array<SValue@>@ params) override
	{
		DungeonGenerationCommands::LoadParams(params);
		
		UnitPtr u;

		m_density = GetParamFloat(u, params, "density", false, 1.0f);
		m_padding = GetParamInt(u, params, "padding", false, 14);
		m_roomChance = GetParamFloat(u, params, "room-chance", false, 0.1f);
		m_roomPfbChance = GetParamFloat(u, params, "room-prefab-chance", false, 0.1f);
		m_startPfbChance = GetParamFloat(u, params, "start-prefab-chance", false, 1.0f);
		m_furthestJunctionChance = GetParamFloat(u, params, "furthest-junction-chance", false, 0.0f);

		m_roomWidth = GetParamIVec2(u, params, "room-width", false, ivec2(6, 12));
		m_roomHeight = GetParamIVec2(u, params, "room-height", false, ivec2(5, 10));

		m_pathWidth = GetParamIVec2(u, params, "path-width", false, ivec2(2, 2));
		m_pathHeight = GetParamIVec2(u, params, "path-height", false, ivec2(4, 4));

		m_pathLenX = GetParamIVec2(u, params, "path-length-hori", false, ivec2(5, 5));
		m_pathLenY = GetParamIVec2(u, params, "path-length-vert", false, ivec2(8, 8));

		m_startPfbSet = GetParamString(u, params, "start-prefab", false);
		m_roomPfbSet = GetParamString(u, params, "room-prefab", false);

	}

	int PickJunction(DungeonGenCarveContext@ ctx)
	{
		int numJunctions = ctx.junctions.length();
		if (ctx.junctions.length() <= 0)
			return -1;
		
		if (randf() < m_furthestJunctionChance)
		{
			int midX = ctx.brush.m_width / 2;
			int midY = ctx.brush.m_height / 2;
			
			int bestD = -1;
			int bestJ = -1;
			
			for (int i = 0; i < numJunctions; i++)
			{
				int dx = ctx.junctions[i].x - midX;
				int dy = ctx.junctions[i].y - midY;
				int d = dx * dx + dy * dy;
				
				if (d > bestD)
				{
					bestD = d;
					bestJ = i;
				}
			}
			
			return bestJ;
		}
		
		return randi(numJunctions);
	}

	bool Execute(DungeonBrush@ brush, PrefabPlacement@ pfbPlacer) override
	{
		print("DungeonGenerationCarveInitial");
		%PROFILE_SCOPE DungeonGenerationCarveInitial

		int w = brush.m_width;
		int h = brush.m_height;


		int padX = m_roomWidth.y + m_padding;
		int padY = m_roomHeight.y + m_padding;

		DungeonGenCarveContext ctx;
		@ctx.brush = brush;
		@ctx.pfbPlacer = pfbPlacer;

		float pm = MakeInitialState(ctx, w, h);
		
		int attempts = 0;
		int plots = int((w - m_padding * 2) * (h - m_padding * 2) * m_density / 42 * pm);
		while (plots > 0)
		{
			if (attempts > 250)
				return true;

			int j = PickJunction(ctx);
			if (j < 0)
				return true;

			auto junction = ctx.junctions[j];

			int d = junction.z;
			/*
			if (d % 2 == 0)
				d = (d + ((randf() < 0.5f) ? 2 : 3)) % 4;
			else
				d = (d + ((randf() < 0.5f) ? 1 : 2)) % 4;
			*/

			ivec2 from(junction.x, junction.y);
			ivec2 to = from;
			switch (d)
			{
				case 0: to.y -= Modifiers::lerp(m_pathLenY, randf()); break;
				case 1: to.y += Modifiers::lerp(m_pathLenY, randf()); break;
				case 2: to.x -= Modifiers::lerp(m_pathLenX, randf()); break;
				case 3: to.x += Modifiers::lerp(m_pathLenX, randf()); break;
			}
			
			if (to.x < padX || to.y < padY || to.x >= w - padX || to.y >= h - padY)
			{
				attempts++;
				continue;
			}
			/*
			if (brush.GetCell(to.x, to.y) == Cell::Floor || ctx.brush.IsConsumed(to.x, to.y))
			{
				attempts++;
				continue;
			}
			*/
			bool close = false;
			ivec2 midPt = (from + to) / 2;
			for (uint r = 0; r < ctx.rooms.length(); r++)
			{
				auto room = ctx.rooms[r];
				if (IsInside(room, to) || IsInside(room, midPt))
				{
					close = true;
					break;
				}
			}
			
			if (close)
			{
				attempts++;
				continue;
			}
			
			int thickness = 1;
			if (d <= 1)
				thickness = Modifiers::lerp(m_pathWidth, randf());
			else
				thickness = Modifiers::lerp(m_pathHeight, randf());
			
			ivec2 fromLn = from;
			ivec2 toLn = to;
			
			if (d == 3)
				fromLn += ivec2(-thickness/2, 0);
			if (d == 2)
				toLn += ivec2(-thickness/2, 0);
			
			if (brush.IsLineConsumed(fromLn, toLn, thickness))
			{
				attempts++;
				continue;
			}
			
			bool madeRoom = false;
			if (randf() < m_roomPfbChance && TryMakePrefabRoom(ctx, m_roomPfbSet, to, d))
				madeRoom = true;
			
			if (!madeRoom && randf() < m_roomChance && TryMakeRoom(ctx, to, Modifiers::lerp(m_roomWidth, randf()), Modifiers::lerp(m_roomHeight, randf())))
				madeRoom = true;
			
			if (madeRoom)
				brush.OutputDebugImage();
			
			plots--;
			if (!brush.PlotLineUntilConsumed(fromLn, toLn, thickness, Cell::Floor))
			{
				print("Failed to plot required line.");
				return false;
			}
			
			AddJunction(ctx, ivec3(to.x, to.y, d));
			
			brush.OutputDebugImage();
			ctx.junctions.removeAt(j);
		}

		return true;
	}

	void AddJunction(DungeonGenCarveContext@ ctx, ivec3 junc)
	{
		if (junc.z % 2 == 0)
		{
			ctx.junctions.insertLast(ivec3(junc.x, junc.y, (junc.z + 2) % 4));
			ctx.junctions.insertLast(ivec3(junc.x, junc.y, (junc.z + 3) % 4));
		}
		else
		{
			ctx.junctions.insertLast(ivec3(junc.x, junc.y, (junc.z + 1) % 4));
			ctx.junctions.insertLast(ivec3(junc.x, junc.y, (junc.z + 2) % 4));
		}
	}

	bool IsInside(ivec4 room, ivec2 pos) { return (pos.x >= room.x && pos.x <= room.z && pos.y >= room.y && pos.y <= room.w); }


	bool TryMakePrefabRoom(DungeonGenCarveContext@ ctx, const string &in pfbSet, ivec2 pos, int junctionDir)
	{
		if (pfbSet.isEmpty())
			return false;
		
		auto foundPrefabs = MissionPrefabDef::GetPossiblePrefabs(HashString(pfbSet));
		
		ivec2 pfbTopLeft;
		MissionPrefabDef@ pfbPlace = null;
		
		int irnd = randi(foundPrefabs.length());
		for (uint i = 0; i < foundPrefabs.length(); i++)
		{
			if (i > 10 || pfbPlace !is null)
				break;
			
			auto prefab = foundPrefabs[MissionPrefabDef::RollIndex(foundPrefabs)];
			
			array<ivec3>@ roomJunctions = null;
			switch (junctionDir)
			{
				case 0: @roomJunctions = prefab.m_junctionsDown; break;
				case 1: @roomJunctions = prefab.m_junctionsUp; break;
				case 2: @roomJunctions = prefab.m_junctionsRight; break;
				case 3: @roomJunctions = prefab.m_junctionsLeft; break;
			}
			
			if (roomJunctions is null)
				continue;
			
			for (uint j = 0; j < roomJunctions.length(); j++) // TODO: "Shuffle" order
			{
				ivec2 topLeft(pos.x - roomJunctions[j].x, pos.y - roomJunctions[j].y);
				ivec2 botRight(topLeft.x + prefab.m_gridSz.x, topLeft.y + prefab.m_gridSz.y);
				
				if (!ctx.brush.IsRectFreeType(topLeft - ivec2(1,1), botRight + ivec2(1,1), Cell::Wall))
					continue;
				/*
				if (!CheckPaths(ctx, pfbTopLeft, prefab.m_junctionsUp, 0, ivec2(0, -m_pathLenY.x)))
				{
					print("Failed check path up, d: " + junctionDir);
					continue;
				}
				if (!CheckPaths(ctx, pfbTopLeft, prefab.m_junctionsDown, 1, ivec2(0, m_pathLenY.x)))
				{
					print("Failed check path down, d: " + junctionDir);
					continue;
				}
				if (!CheckPaths(ctx, pfbTopLeft, prefab.m_junctionsLeft, 2, ivec2(-m_pathLenX.x, 0)))
				{
					print("Failed check path left, d: " + junctionDir);
					continue;
				}
				if (!CheckPaths(ctx, pfbTopLeft, prefab.m_junctionsRight, 3, ivec2(m_pathLenX.x, 0)))
				{
					print("Failed check path right, d: " + junctionDir);
					continue;
				}
				*/
				pfbTopLeft = topLeft;
				@pfbPlace = prefab;
				break;
			}
		}
		
		if (pfbPlace is null)
			return false;
		
		//ctx.pfbPlacer.PlacePrefabAt(pfbPlace.UsePrefab(), ivec2(pfbTopLeft.x, pfbTopLeft.y));
		
		@pfbPlace = pfbPlace.UsePrefab();
		
		PatternMatcher::ExecutePrefabCommands(ctx.brush, pfbTopLeft, pfbPlace.m_gridCommand, pfbPlace.m_gridSz);
		ctx.brush.AddPointOfInterest(pfbPlace, pfbTopLeft.x + pfbPlace.m_gridOffset.x, pfbTopLeft.y + pfbPlace.m_gridOffset.y);
		
		ctx.brush.OutputDebugImage();
		
		PlotPaths(ctx, pfbTopLeft, pfbPlace.m_junctionsUp, 0, ivec2(0, -m_pathLenY.x));
		PlotPaths(ctx, pfbTopLeft, pfbPlace.m_junctionsDown, 1, ivec2(0, m_pathLenY.x));
		PlotPaths(ctx, pfbTopLeft, pfbPlace.m_junctionsLeft, 2, ivec2(-m_pathLenX.x, 0));
		PlotPaths(ctx, pfbTopLeft, pfbPlace.m_junctionsRight, 3, ivec2(m_pathLenX.x, 0));
		
		pfbTopLeft += pfbPlace.m_gridOffset;
		ctx.rooms.insertLast(ivec4(pfbTopLeft.x, pfbTopLeft.y, pfbTopLeft.x + pfbPlace.m_gridSz.x, pfbTopLeft.y + pfbPlace.m_gridSz.y));
		
		return true;
	}


	bool TryMakeRoom(DungeonGenCarveContext@ ctx, ivec2 pos, int w, int h, bool force = false)
	{
		ivec2 tl(pos.x - (w / 2), pos.y - (h / 2));
		ivec2 br(pos.x + (w - w / 2), pos.y + (h - h / 2));
		
		ivec2 tr(br.x, tl.y);
		ivec2 bl(tl.x, br.y);
		
		if (ctx.brush.IsConsumed(tl.x, tl.y) ||
			ctx.brush.IsConsumed(br.x, br.y) ||
			ctx.brush.IsConsumed(tr.x, tr.y) ||
			ctx.brush.IsConsumed(bl.x, bl.y))
			return false;
		
		if (!force)
		{
			if (!ctx.brush.IsRectFreeType(tl, br, Cell::Wall))
				return false;
		}
		
		ctx.rooms.insertLast(ivec4(tl.x, tl.y, br.x, br.y));
		
		ctx.brush.PlotRect(tl, br, Cell::Floor);
		
		AddJunction(ctx, ivec3(tl.x + 2, tl.y + 2, 0));
		AddJunction(ctx, ivec3(tl.x + 2, br.y - 2, 2));
		AddJunction(ctx, ivec3(br.x - 2, tl.y + 2, 1));
		AddJunction(ctx, ivec3(br.x - 2, br.y - 2, 4));
		
		return true;
	}
	
	bool CheckPaths(DungeonGenCarveContext@ ctx, ivec2 pos, array<ivec3>@ junctionsToAdd, int d, ivec2 dir)
	{
		for (uint i = 0; i < junctionsToAdd.length(); i++)
		{
			ivec2 from(junctionsToAdd[i].x + pos.x, junctionsToAdd[i].y + pos.y);
			ivec2 to = from + dir;
			if (ctx.brush.IsLineConsumed(from, to, 1))
				return false;
		}
		return true;
	}
	
	bool PlotPaths(DungeonGenCarveContext@ ctx, ivec2 pos, array<ivec3>@ junctionsToAdd, int d, ivec2 dir)
	{
		for (uint i = 0; i < junctionsToAdd.length(); i++)
		{
			ivec2 from(junctionsToAdd[i].x + pos.x, junctionsToAdd[i].y + pos.y);
			ivec2 to = from + dir;
			
			//if (to.x < m_padding || to.y < m_padding || from.x < m_padding || from.y < m_padding)
			//	continue;
			
			//if (to.x >= (ctx.brush.m_width - m_padding) || to.y >= (ctx.brush.m_height - m_padding) || from.x >= (ctx.brush.m_width - m_padding) || from.y >= (ctx.brush.m_height - m_padding))
			//	continue;
			
			//if (ctx.brush.IsLineConsumed(from, to, junctionsToAdd[i].z))
			//	continue;
			
			if (ctx.brush.PlotLineUntilConsumed(from, to, junctionsToAdd[i].z, Cell::Floor))
				AddJunction(ctx, ivec3(to.x, to.y, d));
		}
		return true;
	}

	float MakeInitialState(DungeonGenCarveContext@ ctx, int w, int h)
	{
		if (!m_startPfbSet.isEmpty() && randf() < m_startPfbChance)
		{
			auto startPrefabs = MissionPrefabDef::GetPossiblePrefabs(HashString(m_startPfbSet));
			if (startPrefabs.length() > 0)
			{
				auto room = startPrefabs[MissionPrefabDef::RollIndex(startPrefabs)].UsePrefab();
				auto placePos = ivec2(w / 2, h / 2) - room.m_gridOffset;
				
				print("  Placing initial state prefab: " + room.m_id);
				
				PlotPaths(ctx, placePos, room.m_junctionsUp, 0, ivec2(0, -m_pathLenY.x));
				PlotPaths(ctx, placePos, room.m_junctionsDown, 1, ivec2(0, m_pathLenY.x));
				PlotPaths(ctx, placePos, room.m_junctionsLeft, 2, ivec2(-m_pathLenX.x, 0));
				PlotPaths(ctx, placePos, room.m_junctionsRight, 3, ivec2(m_pathLenX.x, 0));
				
				ctx.pfbPlacer.PlacePrefabAt(room, placePos);
				
				placePos += room.m_gridOffset;
				ctx.rooms.insertLast(ivec4(placePos.x, placePos.y, placePos.x + room.m_gridSz.x, placePos.y + room.m_gridSz.y));
				ctx.brush.OutputDebugImage();

				return 1.f;
			}
		}

		TryMakeRoom(ctx, ivec2(w / 2, h / 2), 12, 14);
		ctx.brush.OutputDebugImage();
		return 1.f;
	}
}



