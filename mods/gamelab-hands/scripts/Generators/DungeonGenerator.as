	int ReserveCliff(array<array<uint8>>@ gridTaken, int x, int y, bool fill)
	{
		int w = m_brush.m_width;
		int h = m_brush.m_height;
	
		array<ivec2> delta = { ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1) };
	
		array<ivec2> queue;
		queue.insertLast(ivec2(x, y));
		gridTaken[x][y] = 0;

		bool valid = true;
		int num = 0;
		while(!queue.isEmpty())
		{
			auto pt = queue[0];
			queue.removeAt(0);
			
			for (int i = 0; i < 4; i++)
			{
				ivec2 p = pt + delta[i];
				
				if (p.x < 0 || p.x >= w || p.y < 0 || p.y >= h || m_brush.IsConsumed(p.x, p.y))
				{
					valid = false;
					continue;
				}
				
				if (gridTaken[p.x][p.y] != 0)
					continue;

				if (m_brush.GetCell(p.x, p.y) != Cell::Wall)
					continue;
				
				if (valid && !fill)
				{
					if (m_brush.GetCell(p.x, p.y - 1) != Cell::Wall && (m_brush.GetCell(p.x, p.y + 1) != Cell::Wall   ))//|| m_brush.GetCell(p.x, p.y + 2) != Cell::Wall))
						valid = false;
					else if (m_brush.GetCell(p.x - 1, p.y) != Cell::Wall && m_brush.GetCell(p.x + 1, p.y) != Cell::Wall)
						valid = false;
				}
				
				queue.insertLast(p);
				gridTaken[p.x][p.y] = 1;
				num++;
				
				if (fill)
					m_brush.SetCell(p.x, p.y, Cell::Cliff);
			}
		}
		
		return valid ? num : -1;
	}

	void MakeCliffs(int maxNum, int maxSize)
	{
		if (maxNum <= 0)
			return;
	
		int w = m_brush.m_width;
		int h = m_brush.m_height;
	
		auto gridTaken = array<array<uint8>>(w, array<uint8>(h, 0));
		array<ivec2> cliffGroups;
		
		for (int y = 0; y < h; y++)
		{
			for (int x = 0; x < w; x++)
			{
				if (gridTaken[x][y] != 0)
					continue;
			
				Cell cell = m_brush.GetCell(x, y);
				if (cell == Cell::Wall && !m_brush.IsConsumed(x, y))
				{
					int size = ReserveCliff(gridTaken, x, y, false);
					if (size > 10 && size < maxSize)
						cliffGroups.insertLast(ivec2(x, y));
				}
			}
		}
		
		gridTaken = array<array<uint8>>(w, array<uint8>(h, 0));
		while(maxNum-- > 0 && cliffGroups.length() > 0)
		{
			int idx = GameLab::GenRandi(cliffGroups.length());
			auto pt = cliffGroups[idx];
			cliffGroups.removeAt(idx);
			
			ReserveCliff(gridTaken, pt.x, pt.y, true);
		}
	}

	void PlaceCrateBreakables(int w, int h)
	{
		for (int y = 0; y < h; y++)
		{
			for (int x = 0; x < w; x++)
			{
				if (BlocksBreakable(x, y))
					continue;
				
				if (BlocksBreakable(x, y + 1))
					continue;
				
				if (BlocksBreakable(x, y + 2))
					continue;
				
				if (BlocksBreakable(x, y + 3))
					continue;
				
				if (m_brush.GetCell(x, y -1) == Cell::Floor)
					continue;

				bool noWall = true;
				int chance = 10;
				if (m_brush.GetCell(x, y -1) == Cell::Wall)
				{
					chance += 30;
					noWall = false;
				}
				else if (m_brush.GetCell(x, y -1) == Cell::Breakables)
					chance += 10;
					
				if (m_brush.GetCell(x -1, y) == Cell::Wall)
				{
					chance += 25;
					noWall = false;
				}
				else if (m_brush.GetCell(x -1, y) == Cell::Breakables)
					chance += 20;
					
				if (m_brush.GetCell(x +1, y) == Cell::Wall)
				{
					chance += 25;
					noWall = false;
				}
				else if (m_brush.GetCell(x +1, y) == Cell::Breakables)
					chance += 20;
				
				if (noWall)
					chance -= 15;
				
				if (GameLab::GenRandi(100) < chance)
					m_brush.SetCell(x, y, Cell::Breakables);
			}
		}
	}

	bool BlocksBreakable(int x, int y)
	{
		if (m_brush.IsConsumed(x, y))
			return true;
	
		auto cell = m_brush.GetCell(x, y);
		return (cell != Cell::Floor && cell != Cell::Breakables);
	}

	bool InitializeGeneration() { return true; }
	bool BeginGeneration(PrefabPlacement@ placer) { return true; }

	void Generate(SValue@ save) override
	{
		auto missionGm = cast<MissionGameModeBase>(g_gameMode);
		
		while (true)
		{
			g_dungeonGenFlags.removeRange(0, g_dungeonGenFlags.length());
			g_dungeonGenRunFlags.removeRange(0, g_dungeonGenRunFlags.length());
			g_dungeonGenRunFlagNames.removeRange(0, g_dungeonGenRunFlagNames.length());
			g_dungeonGenCDScalars.removeRange(0, g_dungeonGenCDScalars.length());
			g_dungeonGenCDScalarValues.removeRange(0, g_dungeonGenCDScalarValues.length());
			
			if (missionGm !is null)
			{
				for (uint i = 0; i < missionGm.m_missionLevel.m_levelFlags.length(); i++)
					g_dungeonGenFlags.insertLast(HashString(missionGm.m_missionLevel.m_levelFlags[i]));
			}
			
			g_genNumId = GameLab::GenRandi();
			print("Generating level...");
			
			PreloaderYield();
			
			if (!InitializeGeneration())
			{
				PrintError("Failed generation initialization");
				continue;
			}
			
			int w = m_size.x / 16;
			int h = m_size.y / 16;
			
			PreloaderYield();
			
			m_brush.Initialize(w, h, vec2(-m_size.x / 2, -m_size.y / 2));
			PrefabPlacement placer(m_brush);
			
			PreloaderYield();
			
			if (!BeginGeneration(placer))
			{
				PrintError("Failed generation startup");
				continue;
			}
			
			print("Running generation commands");
			
			bool failed = false;
			for (uint i = 0; i < m_genCommands.length(); i++)
			{
				PreloaderYield();
				
				if (GameLab::GenRandf() > m_genCommands[i].m_execChance)
					continue;
				if (!CheckGlobalConditionals(m_genCommands[i].m_conditionals))
					continue;
				
				if (!m_genCommands[i].Execute(m_brush, placer))
				{
					failed = true;
					break;
				}
				
				m_brush.OutputDebugImage();
			}
			
			if (failed)
			{
				PrintWarning("Failed generation commands, retrying from scratch");
				continue;
			}
			
			print("Finished generation commands");
			
			PreloaderYield();
			
			PlaceBreakables();
			
			PreloaderYield();
			
			m_brush.GenerateNothingness();
			
			break;
		}
		
		PreloaderYield();
		
		print("Brush build");
		m_brush.Build(g_scene);
		
		PreloaderYield();
		
		print("Placing enemy spots");
		m_brush.PlaceEnemySpots(g_scene, m_enemyPlacer);
	}
	
	void PlaceBreakables()
	{
		print("Placing breakables");
		
		int w = m_size.x / 16;
		int h = m_size.y / 16;
		
		PlaceCrateBreakables(w, h);
	}

