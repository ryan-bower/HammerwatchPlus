		m_allowMinibosses = GetParamBool(owner, params, "minibosses", false, false);
		
		m_densityMul = GetParamVec2(owner, params, "density", false, vec2(1.0f, 1.0f));
		
		
		
		auto schemeArr = GetParamArray(owner, params, "schemes", false);
		if (schemeArr !is null)
		{
			for (uint i = 0; i < schemeArr.length(); i += 2)
			{
				auto scheme = EnemyPlacementScheme::Get(schemeArr[i+1].GetString());
				if (scheme is null)
					continue;
				
				m_schemeChances.insertLast(schemeArr[i].GetInteger());
				m_schemeNames.insertLast(scheme);
				
			}
		}
	}

	EnemyPlacementScheme@ GetEnemyScheme(WorldScript::EnemyPlacement@ placement, float &out budget)
	{
		//float space = pow(placement.Spread / 16.0f, 2.0f) * PI;
		float space = pow((placement.Spread + 8) / 16.0f, 1.5f) * PI;
		float baseBudget = Modifiers::lerp(m_densityMul, GameLab::GenRandf()) * placement.Density * space;
		
		
		int schemeChanceSum = 0;
		for (uint i = 0; i < m_schemeNames.length(); i++)
		{
			m_schemeNames[i].m_tmpInUse = false;
			
			if (baseBudget < m_schemeNames[i].m_minBudget || baseBudget > m_schemeNames[i].m_maxBudget)
				continue;
			
			if (placement.m_tagInt != 0 && (placement.m_tagInt & m_schemeNames[i].m_tags) == 0)
				continue;
			
			if (!CheckGlobalConditionals(m_schemeNames[i].m_conditionals))
				continue;
			
			m_schemeNames[i].m_tmpInUse = true;
			schemeChanceSum += m_schemeChances[i];
		}
		
		
		int r = GameLab::GenRandi(schemeChanceSum);
		for (uint i = 0; i < m_schemeChances.length(); i++)
		{
			if (!m_schemeNames[i].m_tmpInUse)
				continue;
			
			r -= m_schemeChances[i];
			if (r < 0)
			{
				budget = max(2.0f, baseBudget * Modifiers::lerp(m_schemeNames[i].m_density, GameLab::GenRandf()));
				return m_schemeNames[i];
			}
		}
		
		budget = 0;
		return null;
	}

