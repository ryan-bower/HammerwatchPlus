	DungeonEnemyPlacer(UnitPtr owner, array<SValue@>@ params)
	{
		m_autoSpotMinRadius = GetParamInt(owner, params, "auto-spot-min-radius", false, 2);
		m_autoSpotChance = GetParamFloat(owner, params, "auto-spot-chance", false, 1.0f);
