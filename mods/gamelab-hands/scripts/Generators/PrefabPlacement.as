	void CopyPrefabTo(MissionPrefabDef@ prefabDef, ivec2 pos)
	{
		//print("    Placing prefab: " + prefabDef.m_id + ", to: " + pos);
		PatternMatcher::CopyPrefabPattern(m_grid, pos, prefabDef.m_gridPattern, prefabDef.m_gridCommand, prefabDef.m_gridSz);
		m_grid.AddPointOfInterest(prefabDef, pos.x + prefabDef.m_gridOffset.x, pos.y + prefabDef.m_gridOffset.y);
		
