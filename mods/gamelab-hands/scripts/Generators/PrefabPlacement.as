	int PlacePrefabs(uint set, int maxAmount, float numBoost = 1.0f, int typeMinLimit = 100)
	{
		if (maxAmount < 1)
			return -1;
		
		auto missionPrefabs = MissionPrefabDef::GetPossiblePrefabs(set);
		if (missionPrefabs.length() < 1)
			return -1;
		
		print("  Placing " + missionPrefabs.length() + " prefab types");
		
		int attempts = 100;
		int numPlaced = 0;
		while (numPlaced < maxAmount && missionPrefabs.length() > 0 && attempts-- > 0)
		{
			int tn = MissionPrefabDef::RollIndex(missionPrefabs);
			auto type = missionPrefabs[tn];
			missionPrefabs.removeAt(tn);
			
			auto found = PatternMatcher::FindAllPatterns(m_grid, type.m_gridPattern, type.m_gridSz);
			int numFound = found.length();
			if (numFound <= 0)
				type.m_foundNoPlacement = true;
			
			int maxPerType = max(typeMinLimit, int(numFound / max(2, missionPrefabs.length()) / 3.5f * numBoost * type.m_numBoost));
			
			int maxDistSqX = (type.m_gridSz.x + 2) * (type.m_gridSz.x + 2);
			int maxDistSqY = (type.m_gridSz.y + 2) * (type.m_gridSz.y + 2);
			
			int num = 0;
			for (; num < maxPerType && numPlaced < maxAmount; num++)
			{
				if (found.length() <= 0)
					break;
				
				auto toPlace = type.UsePrefab();
				if (toPlace is null)
					break;
				
				auto pos = found[GameLab::GenRandi(found.length())];
				
				PatternMatcher::ExecutePrefabCommands(m_grid, pos, toPlace.m_gridCommand, toPlace.m_gridSz);
				m_grid.AddPointOfInterest(toPlace, pos.x + toPlace.m_gridOffset.x, pos.y + toPlace.m_gridOffset.y);
				numPlaced++;
				
				%PROFILE_SCOPE FindOverlappingPrefabs
				for (uint i = 0; i < found.length();)
				{
					ivec2 d = found[i] - pos;
					if ((d.x * d.x) < maxDistSqX && (d.y * d.y) < maxDistSqY)
						found.removeAt(i);
					else
						i++;
				}
			}
			
			print("    Found " + numFound + ", placed " + num + ", for " + type.m_id);
		}
		
		print("  Total placed: " + numPlaced);
		return numPlaced;
	}

	array<ivec2> GetPossiblePrefabPositions(uint set, MissionPrefabDef@ &out type)
	{
		array<ivec2> ret;
		
