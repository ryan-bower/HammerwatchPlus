namespace WorldScript
{
	[WorldScript color="255 255 102" icon="system/icons.png;352;32;32;32"]
	class SecretFound
	{
		SValue@ ServerExecute()
		{
			%STAT Add secrets-found 1 GetLocalPlayerRecord()
			return null;
		}

		void ClientExecute(SValue@ val)
		{
			ServerExecute();
		}
	}
}
