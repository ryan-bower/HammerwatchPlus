<gui>
	<sprites>
		%include "gui/scalablebutton_sprites.inc"
		%include "gui/panel_decoration.inc"
		%include "gui/closebutton_sprites.inc"
		%include "gui/scrollbar_sprites.inc"
	</sprites>

	<doc>
		<group>
			<panel width="360" height="300" anchor="0.5 0.5" style="standard">
				<panel anchor="0.5 0" width="340" height="22" offset="0 0" style="character_pick_top">
					<text id="title" text=".hwp.laststats.title" color="#ed9331" font="title" align="center" anchor="0.5 0.5" width="280" offset="0 1" />
				</panel>

				<spritebutton id="close-btn" nav-pos="4 0" spriteset="close" anchor="1 0" offset="-1 1" func="close" />

				<!-- search -->
				<rect width="340" height="18" anchor="0.5 0" offset="0 27" spriteset="gui/sprite_rect.sval:rounded">
					<text id="search-hint" text=".hwp.laststats.search" anchor="0 0.5" offset="6 0" font="text" color="#808080" />
					<textinput id="search" nav-pos="0 1" textlimit="32" anchor="0 0.5" offset="6 0" textoffset="0 1" width="300" height="14" font="gui/fonts/hw8.fnt" check-reserved-characters="true" func-edit="search" func="search" func-cancel="search-clear" />
					<scalebutton id="search-clear" nav-pos="2 1" spriteset="scalebutton-regular" width="22" height="16" anchor="1 0.5" offset="-2 0" func="search-clear" text="x" font="gui/fonts/arial11.fnt" />
				</rect>

				<text id="subtitle" text="" color="#ffd27f" font="text" align="center" anchor="0.5 0" offset="0 49" width="340" />
				<!-- one coloured name per player -->
				<group id="legend" anchor="0.5 0" offset="0 61" width="340" height="12">
				</group>

				<!-- stat list -->
				<rect width="340" height="218" anchor="0.5 0" offset="0 76" spriteset="gui/sprite_rect.sval:rounded">
					<scrollbar nav-pos="1 2" id="stat-group" spriteset="angular-scrollbar" width="330" height="210" anchor="0.5 0.5" offset="0 0" bar-offset="5 0" flow="vbox" >
					</scrollbar>
					<text id="empty" text=".hwp.laststats.empty" color="#aaaaaa" font="text" align="center" anchor="0.5 0.5" width="300" visible="false" />
					<text id="nomatch" text=".hwp.laststats.nomatch" color="#aaaaaa" font="text" align="center" anchor="0.5 0.5" width="300" visible="false" />
				</rect>

				<!-- templates (cloned by HWPLastStatsMenu) -->
				<text id="legend-template" anchor="0 0" offset="0 0" text="Player" font="text" visible="false" />
				<text id="stat-category-template" anchor="0 0" offset="3 0" text="combat" font="title" visible="false" />
				<panel id="stat-separator" width="310" height="2" style="separator" visible="false" />
				<group id="stat-row-template" width="316" height="24" offset="5 1" visible="false" >
					<rect id="stat-bg" width="314" height="11" anchor="0 0" offset="0 0" color="#7f7f7f7f" visible="false" />
					<text id="stat-title" anchor="0 0" offset="3 0" text="experience gained" font="text" />
					<group id="bar-template" width="316" height="11" anchor="0 0" offset="0 12" visible="false" >
						<text id="bar-name" anchor="0 0" offset="8 0" width="80" text="Player" font="text" color="#aaaaaa" />
						<rect id="bar" width="1" height="8" anchor="0 0" offset="92 1" color="#ffffffff" />
						<text id="bar-value" anchor="0 0" offset="96 0" text="0" font="text" />
					</group>
				</group>
			</panel>
		</group>
	</doc>
</gui>
