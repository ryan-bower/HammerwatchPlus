<loader order="1">PlayerClass::LoadMultiple</loader>

<!-- Test Warden: a clone of ranger_nature, written by tools/devarena/clone_spec.py. Stats are the
     parent's SharedStats block (players/ranger/class_ranger.sval); keep them in sync. -->
%defblock SharedStats
	<int name="base-str">6</int>
	<int name="base-dex">10</int>
	<int name="base-int">4</int>
	<int name="base-foc">4</int>
	<int name="base-vit">6</int>
	<int name="level-str">0</int>
	<int name="level-dex">0</int>
	<int name="level-int">0</int>
	<int name="level-foc">0</int>
	<int name="level-vit">0</int>
	<int name="dex-spellpwr">2</int>
	
	<int name="base-health">120</int>
	<int name="base-mana">80</int>
	<int name="level-health">4</int>
	<int name="level-mana">3</int>
	
	<float name="base-health-regen">1</float>
	<float name="base-mana-regen">1</float>
	<float name="level-health-regen">0</float>
	<float name="level-mana-regen">0</float>
	
	<int name="base-armor">5</int>
	<int name="base-fire-res">0</int>
	<int name="base-ice-res">0</int>
	<int name="base-lightning-res">0</int>
	<int name="base-poison-res">5</int>
	
	<float name="level-armor">0.3</float>
