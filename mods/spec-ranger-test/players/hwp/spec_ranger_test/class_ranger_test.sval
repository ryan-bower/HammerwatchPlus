	<float name="level-ice-res">0.2</float>
	<float name="level-lightning-res">0.2</float>
	<float name="level-poison-res">0.3</float>
	
	<string name="panel-style">ranger</string>
	<string name="panel-color-tint">#e0e0e0ff</string>
	<string name="portrait-class">ranger</string>
	<string name="title">title_ranger</string>

	<array name="waypoint">
		<string>gui/icons.png</string>
		<int>100</int><vec4>167 242 14 14</vec4>
	</array>

	<array name="starting-equipment">
		<string>chest_dex_t1a</string>
		<string>feet_dex_t1a</string>
		
