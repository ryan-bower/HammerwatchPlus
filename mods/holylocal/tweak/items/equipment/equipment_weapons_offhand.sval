			<string>mods_weapon_shield</string>
		</array>
		
		<string name="skill">attack_offhand_shield_bash</string>
		<string name="skill-epic">attack_offhand_shield_bash_epic</string>

		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::ArmorAdd</string>
				<ivec2 name="armor">5 15</ivec2>
			</dict>
