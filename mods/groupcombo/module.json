    "applies": "now",
    "settings": [
      {
        "key": "groupcombo.orb.permille",
        "type": "int",
        "default": 1,
        "values": [
          0,
          1,
          2,
          5,
          10
        ],
        "labels": [
          "Off",
          "0.1%",
          "0.2%",
          "0.5%",
          "1%"
        ],
        "title": "Combo orb chance",
