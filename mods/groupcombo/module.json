      {
        "key": "groupcombo.orb.max_permille",
        "type": "int",
        "default": 10,
        "values": [
          5,
          10,
          20,
          50
        ],
        "labels": [
          "0.5%",
          "1%",
          "2%",
          "5%"
        ],
        "title": "Orb chance cap",
        "about": "The most the breaker's Luck can raise the combo orb chance to."
