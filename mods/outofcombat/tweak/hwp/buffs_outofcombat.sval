<!-- The out of combat speed boost. The outofcombat module adds it locally (husk, not
     networked) to the local player while they have not hit an enemy for a while, sets
     its speed-mul from outofcombat.speed and its description in code, and resets its
     timer to a few seconds every frame, so it never runs out while the boost is on; a
     hit sets the timer to 0. The long duration here is only what the HUD and bufftips
     read (display-timer-radius off), so they show no countdown. The icon is the vanilla shrine speed
     blessing's (tweak/buffs/shrine_buffs.sval, speed). -->
<svals>
	<dict name="hwp_outofcombat">
		<string name="name">.hwp.outofcombat.buff</string>
		<string name="description">.hwp.outofcombat.buff</string>
		<array name="effect-icon"><s>items/icons_consumables.png</s><i>100</i><vec4>225 297 14 14</vec4></array>
		<array name="hud"><s>items/icons_consumables.png</s><i>100</i><vec4>225 297 14 14</vec4></array>
		<bool name="debuff">false</bool>
		<bool name="hide-hud-text">true</bool>
		<bool name="display-timer-radius">false</bool>
		<bool name="ignore-buff-scaling">true</bool>
		<int name="duration">86400000</int>
		<float name="speed-mul">2</float>
	</dict>
</svals>
