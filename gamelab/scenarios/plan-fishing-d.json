{
  "name": "plan-fishing-d",
  "about": "Natural trap elapsed-time accounting only:3 traps,20+ game minutes, exact trap contents equal reported natural catches. Zero is valid and retains positive collection/visual scope as unobserved; no debug replacement. Positive samples additionally inspect full units/icons and native walk-up. Read coverage dispositions; aggregate PASS does not imply a positive natural payout.",
  "fixture": "town-paladin",
  "mods": [
    "hwplib",
    "hwplib-luck",
    "hwplib-classui",
    "mapicons",
    "abyss",
    "architect",
    "bufftips",
    "campaign",
    "chatlinks",
    "classes",
    "colors",
    "deathrecap",
    "droptrade",
    "farming",
    "firearms",
    "fishing",
    "gambler",
    "groupcombo",
    "keys",
    "laststats",
    "legacy",
    "maps",
    "mercenary",
    "pets",
    "puzzles",
    "specs",
    "stash",
    "strongbox",
    "summons",
    "valuables",
    "wavemode",
    "weapons",
    "weaponswap"
  ],
  "timeout": 600,
  "steps": [
    {
      "do": "console",
      "line": "e_cheats 1"
    },
    {
      "do": "console",
      "line": "show_chat"
    },
    {
      "do": "sleep",
      "seconds": 1
    },
    {
      "do": "bot",
      "bot": "plan_fishing",
      "kwargs": {
        "sections": "traps_run",
        "required_flags": [
          "traps_owned",
          "traps_run_counts",
          "traps_resolved",
          "traps_cap_3",
          "traps_natural_conserved"
        ]
      },
      "name": "traps over a run",
      "expect": {
        "traps_owned": true,
        "traps_run_counts": true,
        "traps_resolved": true,
        "traps_cap_3": true,
        "traps_natural_conserved": true,
        "ok": true
      }
    },
    {
      "do": "bot",
      "bot": "plan_fishing",
      "kwargs": {
        "sections": "traps_walk_if_natural",
        "required_flags": [
          "trap_observation_accounted"
        ]
      },
      "name": "walk up to a full trap",
      "expect": {
        "trap_observation_accounted": true,
        "ok": true
      }
    },
    {
      "do": "log_clean"
    }
  ]
}
