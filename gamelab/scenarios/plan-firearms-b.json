{
 "name": "plan-firearms-b",
 "about": "Test plan through the plan_firearms bot: the Demolitionist (the Rocket Launcher, its Fat Boy, Magic Missile and Quad orbs, Ordinance Hoarder's charges) and Assault, and the Engineer (Deploy Turret, its orbs, My Turret!).",
 "fixture": "town-paladin",
 "mods": [
   "core",
   "abyss",
   "architect",
   "bufftips",
   "campaign",
   "chatlinks",
   "classes",
   "colors",
   "deathrecap",
   "droptrade",
   "farming",
   "firearms",
   "fishing",
   "gambler",
   "groupcombo",
   "keys",
   "laststats",
   "legacy",
   "maps",
   "mercenary",
   "pets",
   "puzzles",
   "specs",
   "stash",
   "strongbox",
   "summons",
   "valuables",
   "wavemode",
   "weapons",
   "weaponswap"
 ],
 "timeout": 600,
 "steps": [
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "show_chat"
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "bot",
   "bot": "plan_firearms",
   "kwargs": {
    "sections": "firearms_demolitionist"
   },
   "name": "firearms demolitionist",
   "expect": {
    "rpg_casts": true,
    "rpg_cost": true,
    "fatboy_blinds": true,
    "magic_missile_two_hits": true,
    "quad_four_missiles": true,
    "hoarder_passive": true,
    "hoarder_banks_charge": true,
    "hoarder_icon_counts_all": true,
    "hoarder_spends_charge": true,
    "demo_own_buttons": true
   }
  },
  {
   "do": "shot",
   "name": "firearms-demolitionist"
  },
  {
   "do": "bot",
   "bot": "plan_firearms",
   "kwargs": {
    "sections": "firearms_assault"
   },
   "name": "assault skills",
   "expect": {
    "adrenaline_passive": true,
    "burst_casts": true,
    "burst_cost": true,
    "assault_own_buttons": true,
    "adrenaline_on_kill": true,
    "burst_two_shells": true,
    "burst_close_range": true,
    "triple_barrel_three": true,
    "dragons_breath_ground": true
   }
  },
  {
   "do": "bot",
   "bot": "plan_firearms",
   "kwargs": {
    "sections": "firearms_engineer"
   },
   "name": "engineer skills",
   "expect": {
    "turret_casts": true,
    "turret_where_aimed": true,
    "turret_cost": true,
    "turret_decays": true,
    "turret_shoots": true,
    "turret_one_at_a_time": true,
    "second_turret_two": true,
    "reinforced_turret_hp": true,
    "myturret_passive": true,
    "myturret_boosts": true,
    "belt_feed_chance": true,
    "myturret_repairs": true,
    "myturret_only_near": true,
    "myturret_glows": true,
    "engineer_own_buttons": true
   }
  },
  {
   "do": "log_clean"
  }
 ]
}
