   "kwargs": {
    "sections": "invocation"
   },
   "name": "invocation",
   "expect": {
    "inv_char": true,
    "inv_learned": true,
    "inv_tt_cast": true,
    "inv_tt_spread": true,
    "inv_orb_binds": true,
    "inv_sc_cast": true,
    "inv_sc_timer": true,
    "inv_conduit": true,
    "inv_release": true,
    "inv_static_channel": true,
    "inv_tt_orbs": true
   }
  },
  {
   "do": "bot",
   "bot": "plan_specs",
   "kwargs": {
    "sections": "stormbringer"
   },
   "name": "stormbringer",
   "expect": {
    "storm_char": true,
    "storm_learned": true,
    "storm_ec_cast": true,
    "storm_ec_hits": true,
    "storm_ec_return": true,
