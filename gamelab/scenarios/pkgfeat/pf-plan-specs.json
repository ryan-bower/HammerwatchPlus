{
 "name": "pf-plan-specs",
 "about": "plan-specs against the built packages classes, specs instead of the mods' source folders (tools/generate/make_package_scenarios.py). Legacy multi-spec test plan through plan_specs in an emptied Bandit Keep floor at level 20. Deadeye checks Lightning Arrow, kill-earned Tailwind, speed, Gale Force, Wind Ward and Tailwind Catch. Tailwind gains and every ranger kill refresh all stacks for 6 seconds, including at the five-stack cap; staggered-gain, kill-refresh and cap-refresh expiry are checked. Other spec sections retain historical assertions and need review against their current reworks.",
 "fixture": "town-paladin",
 "timeout": 720,
 "steps": [
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "show_chat"
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "bot",
   "bot": "plan_specs",
   "kwargs": {
    "sections": "winddancer"
   },
   "name": "winddancer",
   "expect": {
    "wind_char": true,
    "wind_learned": true,
    "wind_pg_cast": true,
    "wind_pg_buff": true,
    "wind_evade_chance": true,
    "wind_sw_heal": true,
    "wind_sw_timeout": true,
    "wind_orb_binds": true,
    "wind_lasting_gale": true,
    "wind_tailwind": true,
    "wind_lingering_breeze": true,
    "wind_share_not_self": true
   }
  },
  {
   "do": "bot",
   "bot": "plan_specs",
   "kwargs": {
    "sections": "bannerlord"
   },
   "name": "bannerlord",
   "expect": {
    "banner_char": true,
    "banner_learned": true,
    "banner_raise": true,
    "banner_dr_intensity": true,
    "banner_feared_crest": true,
    "banner_war_drum": true,
    "banner_provisions": true,
    "banner_plant": true,
    "banner_plant_free": true,
    "banner_plant_doubled": true
   }
  },
  {
