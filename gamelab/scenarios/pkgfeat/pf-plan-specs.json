    "storm_gw_kill_refresh": true,
    "storm_gale_force": true,
    "storm_wind_ward": true,
    "storm_catch": true
   }
  },
  {
   "do": "bot",
   "bot": "plan_specs",
   "kwargs": {
    "sections": "branding"
   },
   "name": "branding",
   "expect": {
    "brand_char": true,
    "brand_learned": true,
    "brand_cast": true,
    "brand_ready": true,
    "brand_feed": true,
    "brand_claw": true,
    "brand_refund": true,
    "brand_expire": true,
    "brand_transfer": true,
    "brand_lone_cd": true,
    "brand_orb_binds": true,
