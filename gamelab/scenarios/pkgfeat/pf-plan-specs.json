   "bot": "plan_specs",
   "kwargs": {
    "sections": "arcane"
   },
   "name": "arcane",
   "expect": {
    "arc_char": true,
    "arc_learned": true,
    "arc_max_mana": true,
    "arc_hp_mirror": true,
    "arc_heal_converts": true,
    "arc_loss_drains": true,
    "arc_hit_drains": true,
    "arc_floor": true,
    "arc_blink": true,
    "arc_blink_damage": true,
