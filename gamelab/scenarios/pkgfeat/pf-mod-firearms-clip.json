{
 "name": "pf-mod-firearms-clip",
 "about": "mod-firearms-clip against the built package firearms instead of the mods' source folders (tools/make_package_scenarios.py). The clip (the starting Service Pistol: 10): full when a new character spawns in the village and on a run's first floor; the count carried to the next floor (no refill); hwp firearms empty leaves it at 0 with no reload, and pulling the trigger then starts the reload; Reload costs no mana.",
 "fixture": "town-paladin",
 "timeout": 420,
 "steps": [
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "gl",
   "verb": "char",
   "args": [
    "hwp_firearms",
    "Clip"
   ]
  },
  {
   "do": "wait_phase",
   "phase": "town",
   "timeout": 60
  },
  {
   "do": "sleep",
   "seconds": 2
  },
  {
   "do": "log_has",
   "name": "town spawn: full clip",
   "pattern": "\\[HWP:firearms\\] clip filled 10/10 \\(had 0, level town\\)",
   "timeout": 10
  },
  {
   "do": "console",
   "line": "hwp firearms"
  },
  {
   "do": "sleep",
   "seconds": 0.5
  },
  {
   "do": "log_capture",
   "pattern": "Firearms Specialist: class hwp_firearms, weapon [^,]+, clip (?P<clip>\\d+)/(?P<max>\\d+), mana (?P<mana>\\d+)/(?P<mmax>\\d+)",
   "save_as": "town_full",
   "timeout": 5
  },
  {
   "do": "gl",
   "verb": "input",
   "args": [
    "2000",
    "0",
    "0",
    "1",
    "0",
    "main"
   ]
  },
  {
   "do": "sleep",
   "seconds": 2.5
  },
  {
   "do": "console",
   "line": "hwp firearms"
  },
  {
   "do": "sleep",
   "seconds": 0.5
  },
  {
   "do": "log_capture",
   "pattern": "Firearms Specialist: class hwp_firearms, weapon [^,]+, clip (?P<clip>\\d+)/(?P<max>\\d+), mana (?P<mana>\\d+)/(?P<mmax>\\d+)",
   "save_as": "town_shot",
   "timeout": 5
  },
  {
   "do": "console",
   "line": "hwp firearms empty"
  },
  {
   "do": "sleep",
   "seconds": 0.5
  },
  {
   "do": "console",
   "line": "hwp firearms"
  },
  {
   "do": "sleep",
   "seconds": 0.5
  },
  {
   "do": "log_capture",
   "pattern": "Firearms Specialist: class hwp_firearms, weapon [^,]+, clip (?P<clip>\\d+)/(?P<max>\\d+), mana (?P<mana>\\d+)/(?P<mmax>\\d+)",
