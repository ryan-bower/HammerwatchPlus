   "timeout": 5
  },
  {
   "do": "sleep",
   "seconds": 2
  },
  {
   "do": "console",
   "line": "hwp firearms"
  },
  {
   "do": "sleep",
   "seconds": 0.5
  },
  {
   "do": "log_capture",
   "name": "an emptied clip stays empty (no reload by itself)",
   "pattern": "clip (?P<clip>\\d+)/10, mana",
   "save_as": "town_empty_wait",
   "timeout": 1
  },
  {
   "do": "gl",
   "verb": "input",
   "args": [
    "300",
    "0",
    "0",
    "1",
    "0",
    "main"
   ]
  },
  {
   "do": "log_has",
   "name": "trigger on an empty clip starts the reload",
