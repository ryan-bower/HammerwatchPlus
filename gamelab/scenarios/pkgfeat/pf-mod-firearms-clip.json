  {
   "do": "sleep",
   "seconds": 2.5
  },
  {
   "do": "console",
   "line": "hwp firearms"
  },
  {
   "do": "sleep",
   "seconds": 0.5
  },
  {
   "do": "log_capture",
   "pattern": "Firearms Specialist: class hwp_firearms, weapon [^,]+, clip (?P<clip>\\d+)/(?P<max>\\d+), mana (?P<mana>\\d+)/(?P<mmax>\\d+)",
   "save_as": "town_reloaded",
   "timeout": 5
  },
  {
   "do": "gl",
   "verb": "givestacks",
   "args": [
    "players/hwp/firearms/stacks_firearms.sval:clip",
    "-3"
   ],
   "name": "Reload won't start on a full clip: spend 3 rounds first"
  },
  {
   "do": "gl",
   "verb": "castat",
   "args": [
    "hwp_fs_reload",
    "1",
    "0",
    "nocd"
   ]
  },
  {
   "do": "sleep",
   "seconds": 2.5
  },
  {
   "do": "console",
   "line": "hwp firearms"
  },
  {
   "do": "sleep",
   "seconds": 0.5
