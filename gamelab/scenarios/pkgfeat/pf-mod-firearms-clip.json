   "args": [
    "dark_citadel",
    "0"
   ]
  },
  {
   "do": "wait_phase",
   "phase": "mission",
   "timeout": 150
  },
  {
   "do": "sleep",
   "seconds": 4
  },
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "hwp god"
  },
  {
   "do": "log_has",
   "name": "first floor of a run: full clip",
   "pattern": "\\[HWP:firearms\\] clip filled 10/10 \\(had \\d+, level 1\\)",
   "timeout": 10
  },
  {
   "do": "gl",
   "verb": "input",
   "args": [
    "2500",
    "0",
    "0",
    "1",
    "0",
    "main"
   ]
  },
  {
   "do": "sleep",
   "seconds": 3
  },
  {
   "do": "console",
   "line": "hwp firearms"
  },
  {
   "do": "sleep",
   "seconds": 0.5
  },
  {
   "do": "log_capture",
   "pattern": "Firearms Specialist: class hwp_firearms, weapon [^,]+, clip (?P<clip>\\d+)/(?P<max>\\d+), mana (?P<mana>\\d+)/(?P<mmax>\\d+)",
