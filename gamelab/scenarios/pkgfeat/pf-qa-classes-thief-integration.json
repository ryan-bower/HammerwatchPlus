{
 "name": "pf-qa-classes-thief-integration",
 "about": "qa-classes-thief-integration against the built packages classes, qol instead of the mods' source folders (tools/make_package_scenarios.py). Parked HoH1 class: level5 base-kit lab setup, save/reload, two ordinary1x god-off HoH2 floor exits with real rewards, summon readback, then separately controlled lethal Player.Damage and real DeadMenu/town/save/reload. Does not prove boss/co-op.",
 "fixture": "town-paladin",
 "timeout": 1200,
 "steps": [
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "show_chat"
  },
  {
   "do": "bot",
   "bot": "qa_class_integration",
   "kwargs": {
    "cls": "hwp_thief",
    "section": "prepare"
   },
   "expect": {
    "prepared": true,
    "class_record": true,
    "base_ranks": true,
    "starting_weapon": true,
    "god_off": true
   }
  },
  {
   "do": "restart",
   "readback": {
    "phase": "town",
    "player.class": "hwp_thief",
    "player.name": "QAThiefRun",
    "player.level": 5,
    "player.dead": false
   }
  },
  {
   "do": "bot",
   "bot": "qa_class_integration",
   "kwargs": {
    "cls": "hwp_thief",
    "section": "verify"
   },
   "expect": {
    "verified": true,
    "class_record": true,
    "base_ranks": true,
    "starting_weapon": true
   }
  },
  {
   "do": "bot",
   "bot": "qa_class_integration",
   "kwargs": {
    "cls": "hwp_thief",
    "section": "ordinary",
    "floors": 2,
    "budget_s": 180
   },
   "expect": {
    "ordinary_god_off": true,
    "ordinary_floors": true,
    "ordinary_class_survives": true,
    "ordinary_rewards": true
   }
  },
  {
   "do": "bot",
   "bot": "qa_class_integration",
   "kwargs": {
    "cls": "hwp_thief",
    "section": "death"
   },
   "expect": {
    "death_damage_path": true,
    "death_town_return": true
   }
  },
  {
   "do": "restart",
   "readback": {
    "phase": "town",
    "player.class": "hwp_thief",
    "player.name": "QAThiefRun",
    "player.level": 5,
    "player.dead": false
   }
  },
  {
   "do": "bot",
   "bot": "qa_class_integration",
   "kwargs": {
    "cls": "hwp_thief",
    "section": "verify"
   },
   "expect": {
    "verified": true,
    "class_record": true,
    "base_ranks": true,
    "starting_weapon": true
   }
  },
  {
   "do": "log_clean",
   "allow": [
    "Resource name hash conflict in package 'mods/(HWP-[a-z0-9]+|HammerwatchPlus-All)\\.bin' for file "
   ]
  }
 ],
 "packages": [
  "classes",
  "qol"
 ]
}
