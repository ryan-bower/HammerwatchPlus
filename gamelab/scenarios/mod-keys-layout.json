{
 "name": "mod-keys-layout",
 "about": "Issue #19: keys follow the key's position on any keyboard layout, and are named as the player's keyboard labels them. Shim input sends the SDL key events another layout would (the key at Q typing 'a', as on AZERTY). Happy paths: a mod key bound at Q is named A, and every row on that key (drop key) says A too; a key that types nothing keeps the label already learned; an F-key keeps its own name; binding the default resets it; the item action key rebinds; the Game keys group lists the game's own binds, rebinds Skill 1 (keyboard keys replaced and saved to controls.cfg), rebinds half of the move axis, and search finds its rows; typing in the search names a key. Error paths: Shift held gives no label, Esc cancels a capture (mod and game key) and keeps the key, a closed group hides its rows. controls.cfg is GameLab's own and is put back after the run (writes_controls).",
 "fixture": "town-paladin",
 "mods": ["hwplib", "hwplib-luck", "hwplib-classui", "weaponswap", "droptrade"],
 "shim_input": true,
 "writes_controls": true,
 "timeout": 240,
 "steps": [
  {"do": "gl", "verb": "state", "expect": {"phase": "town"}},
  {"do": "gl", "verb": "controls", "save_as": "controls0", "expect": {"ok": true, "map": "kbm", "truncated": false}},
  {"do": "gl", "verb": "menu", "args": ["character"]},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-swapkey"], "name": "default swap key", "expect": {"tab": "HWPOptionsTab", "shown": true, "texts": "Swap weapons | X"}},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-dropkey"], "name": "default drop key", "expect": {"shown": true, "texts": "Drop item key | Q"}},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-actionkey"], "name": "default item action key", "expect": {"shown": true, "texts": "Item action key | E"}},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-swapkey", "hwp-opt", "swapkey"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "key", "key": "q", "typed": "a", "hold": 0.2},
  {"do": "sleep", "seconds": 0.3},
  {"do": "log_has", "pattern": "\\[HWP:options\\] key 20 is labelled A on this keyboard", "timeout": 5, "name": "AZERTY: the key at Q learned as A"},
  {"do": "log_has", "pattern": "\\[HWP:options\\] swapkey key set to 20 \\(A\\), typed \"a\"", "timeout": 5},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-swapkey"], "name": "the swap key is named A", "expect": {"texts": "Swap weapons | A"}},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-dropkey"], "name": "the drop key, also scancode 20, is named A too", "expect": {"texts": "Drop item key | A"}},
  {"do": "shot", "name": "azerty_labels"},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-swapkey", "hwp-opt", "swapkey"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "key", "key": "q", "hold": 0.2},
  {"do": "sleep", "seconds": 0.3},
  {"do": "log_has", "pattern": "(?m)\\[HWP:options\\] swapkey key set to 20 \\(A\\)\\r?$", "timeout": 5, "name": "a press that typed nothing (a dead key) keeps the learned label"},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-swapkey", "hwp-opt", "swapkey"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "key", "key": "shift+w", "typed": "Z", "hold": 0.2},
  {"do": "sleep", "seconds": 0.3},
  {"do": "log_has", "pattern": "(?m)\\[HWP:options\\] swapkey key set to 26 \\(W\\)\\r?$", "timeout": 5, "name": "Shift held: bound, no label taken from the shifted character"},
  {"do": "log_lacks", "pattern": "key 26 is labelled", "name": "Shift held: nothing learned"},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-swapkey", "hwp-opt", "swapkey"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "key", "key": "f5", "hold": 0.2},
  {"do": "sleep", "seconds": 0.3},
  {"do": "log_has", "pattern": "\\[HWP:options\\] swapkey key set to 62 \\(F5\\)", "timeout": 5},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-swapkey"], "name": "an F-key keeps its own name", "expect": {"texts": "Swap weapons | F5"}},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-swapkey", "hwp-opt", "swapkey"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "key", "key": "escape", "hold": 0.1},
  {"do": "sleep", "seconds": 0.3},
  {"do": "log_has", "pattern": "\\[HWP:options\\] swapkey key capture cancelled", "timeout": 5},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-swapkey"], "name": "Esc cancelled: the menu stays, the key is kept", "expect": {"tab": "HWPOptionsTab", "shown": true, "texts": "Swap weapons | F5"}},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-swapkey", "hwp-opt", "swapkey"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "key", "key": "x", "typed": "x", "hold": 0.2},
  {"do": "sleep", "seconds": 0.3},
  {"do": "log_has", "pattern": "\\[HWP:options\\] swapkey key set to 27 \\(X\\)", "timeout": 5},
  {"do": "log_lacks", "pattern": "key 27 is labelled", "name": "a key typing its US name stores no label"},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-swapkey"], "name": "back on the default", "expect": {"texts": "Swap weapons | X"}},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-actionkey", "hwp-opt", "actionkey"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "key", "key": "r", "typed": "r", "hold": 0.2},
  {"do": "sleep", "seconds": 0.3},
  {"do": "log_has", "pattern": "\\[HWP:options\\] actionkey key set to 21 \\(R\\)", "timeout": 5},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-actionkey"], "name": "the item action key rebinds", "expect": {"texts": "Item action key | R"}},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-actionkey", "hwp-opt", "actionkey"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "key", "key": "e", "typed": "e", "hold": 0.2},
  {"do": "sleep", "seconds": 0.3},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-actionkey"], "name": "the item action key back on E", "expect": {"texts": "Item action key | E"}},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-pkg-gamekeys"], "name": "the Game keys group, closed", "expect": {"shown": true, "texts": "+ Game keys | 27 keys"}},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-game-skill1"], "name": "a closed group hides its rows", "expect": {"shown": false}},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-pkg-gamekeys", "hwp-open", "gamekeys"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "log_has", "pattern": "\\[HWP:options\\] package gamekeys opened", "timeout": 5},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-pkg-gamekeys"], "expect": {"texts": "- Game keys | 27 keys"}},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-game-skill1"], "name": "Skill 1 shows both keyboard keys, Q by its learned label", "expect": {"shown": true, "texts": {"match": "^Skill 1 \\| (1 / A|A / 1)$"}}},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-game-move-up"], "expect": {"shown": true, "texts": {"match": "^Move up \\| "}}},
  {"do": "shot", "name": "game_keys"},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-game-skill2", "hwp-opt", "game-skill2"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "key", "key": "escape", "hold": 0.1},
  {"do": "sleep", "seconds": 0.3},
  {"do": "log_has", "pattern": "\\[HWP:options\\] game-skill2 key capture cancelled", "timeout": 5},
  {"do": "log_lacks", "pattern": "\\[HWP:gamekeys\\] Skill2 bound", "name": "Esc on a game key: nothing rebound"},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-game-skill1", "hwp-opt", "game-skill1"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "key", "key": "t", "typed": "t", "hold": 0.2},
  {"do": "sleep", "seconds": 0.4},
  {"do": "log_has", "pattern": "\\[HWP:gamekeys\\] Skill1 bound to 23 \\(T\\), 2 keyboard key\\(s\\) replaced; now T", "timeout": 5, "name": "Skill 1's keyboard keys replaced by T"},
  {"do": "log_has", "pattern": "\\[HWP:options\\] game-skill1 key set to 23 \\(T\\)", "timeout": 5},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-game-skill1"], "expect": {"texts": "Skill 1 | T"}},
  {"do": "gl", "verb": "controls", "save_as": "controls1", "expect": {"ok": true, "map": "kbm"}},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-game-move-up", "hwp-opt", "game-move-up"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "key", "key": "i", "typed": "i", "hold": 0.2},
  {"do": "sleep", "seconds": 0.4},
  {"do": "log_has", "pattern": "\\[HWP:gamekeys\\] move_y axis1 bound to 12 \\(I\\), \\d+ keyboard key\\(s\\) replaced; now I", "timeout": 5, "name": "half of an axis rebinds"},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-game-move-down"], "name": "the other half of the axis is untouched", "expect": {"texts": "Move down | S"}},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "search", "!click"], "expect": {"ok": true}, "name": "press the search field"},
  {"do": "sleep", "seconds": 0.8},
  {"do": "text", "text": "skill"},
  {"do": "sleep", "seconds": 0.4},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-game-skill2"], "name": "search finds a game key", "expect": {"shown": true}},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-swapkey"], "name": "search hides the rest", "expect": {"shown": false}},
  {"do": "key", "key": "d", "typed": "y", "hold": 0.2},
  {"do": "sleep", "seconds": 0.4},
  {"do": "log_has", "pattern": "\\[HWP:options\\] key 7 is labelled Y on this keyboard", "timeout": 5, "name": "typing in a text box names the key"},
  {"do": "key", "key": "escape", "hold": 0.1},
  {"do": "sleep", "seconds": 0.4},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-game-move-right"], "name": "the learned label shows on the game key", "expect": {"shown": true, "texts": "Move right | Y"}},

  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-pkg-gamekeys", "hwp-close", "gamekeys"]},
  {"do": "sleep", "seconds": 0.3},
  {"do": "gl", "verb": "menu", "args": ["hwp_options", "-", "hwp-opt-game-skill1"], "name": "closed again: rows hidden", "expect": {"shown": false}},
  {"do": "key", "key": "escape", "hold": 0.1},
  {"do": "sleep", "seconds": 0.5},
  {"do": "log_clean"}
 ]
}
