{
 "name": "mod-keys-play",
 "about": "The Game keys rows rebind the game's own keyboard binds, and the new keys work in play. In a mission, the Plus tab rebinds primary attack to K (named by a second posted press), off-hand to L, skill 1 to U, dash to J and move up to O (Esc skips naming). Then, with the Dev Arena input log: left and right click still attack (mouse buttons kept), K/L attack, U and mouse 4 use skill 1, J dashes, O moves up and S still moves down; the old keys 1, Q, Space and W do nothing. Keys are posted window messages (no shim), as Windows delivers them. controls.cfg is GameLab's own and is put back after the run (writes_controls). Run: python -m gamelab run mod-keys-play --mode lab.",
 "fixture": "town-paladin",
 "mods": [
  "hwplib",
  "devarena"
 ],
 "writes_controls": true,
 "timeout": 600,
 "steps": [
  {
   "do": "gl",
   "verb": "mission",
   "args": [
    "dark_citadel",
    13,
    "seed=4242",
    "ngp=0"
   ],
   "expect": {
    "ok": true
   },
   "name": "setup: dark_citadel floor 13"
  },
  {
   "do": "wait_phase",
   "phase": "mission",
   "timeout": 120
  },
  {
   "do": "sleep",
   "seconds": 3
  },
  {
   "do": "gl",
   "verb": "cull",
   "args": [
    "all"
   ],
   "expect": {
    "ok": true
   },
   "name": "setup: clear the floor (cheat)"
  },
  {
   "do": "gl",
   "verb": "controls",
   "save_as": "controls0",
   "expect": {
    "ok": true,
    "map": "kbm",
    "truncated": false
   }
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "character"
   ]
  },
  {
   "do": "sleep",
   "seconds": 0.5
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-pkg-gamekeys",
    "hwp-open",
    "gamekeys"
   ]
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:options\\] package gamekeys opened",
   "timeout": 5
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-game-attack",
    "hwp-opt",
    "game-attack"
   ]
  },
  {
   "do": "sleep",
   "seconds": 0.3
  },
  {
   "do": "key",
   "key": "k",
   "hold": 0.2
  },
  {
   "do": "sleep",
   "seconds": 0.4
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:gamekeys\\] MainHandAttack bound to 14 \\(K\\)",
   "timeout": 5,
   "name": "attack rebound to K"
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:options\\] game-attack naming key 14",
   "timeout": 5
  },
  {
   "do": "key",
   "key": "k",
   "hold": 0.3
  },
  {
   "do": "sleep",
   "seconds": 0.4
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:options\\] key 14 is labelled K on this keyboard",
   "timeout": 5,
   "name": "naming K with a posted key press (Windows' own text event)"
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-game-attack"
   ],
   "expect": {
    "shown": true,
    "texts": {
     "match": "\\| K$"
    }
   }
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
