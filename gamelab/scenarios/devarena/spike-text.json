{
 "name": "spike-text",
 "about": "SUPERSEDED by tuner-dock (fixed window px from before the dock layout and dock-id clicks; kept as the spike record, expected to fail now). Spike 5 (docs/devarena/SPEC.md build order): typed text into the dock without a window. A click on the dock's field arms text input the way the in-game chat does (ControlBindings.ExpectTextInput) and sets the window manager's input lock; the field reads the frame's TextInputControlEvents. Typed characters land in the field, and so do bound keys pressed while typing (a key press arrives as its text event too: d, m and i typed 'dmi'); GameLab's own inbox frames (gl probes sent mid-edit) do not; bound keys (d move, m map, i player menu) do nothing while typing; Backspace edits; Enter submits; Escape cancels the edit without opening the pause menu; afterwards the keys move the player again. The field is the row under the freeze button, ~px (528, 36) at 640x360.",
 "fixture": "mission-ranger",
 "mods": ["hwplib", "devarena"],
 "timeout": 300,
 "steps": [
  {"do": "gl", "verb": "mission", "args": ["dark_citadel", 13, "seed=4242", "ngp=0"], "expect": {"ok": true}, "name": "setup: dark_citadel floor 13"},
  {"do": "wait_phase", "phase": "mission", "timeout": 120},
  {"do": "sleep", "seconds": 3},
  {"do": "gl", "verb": "cull", "args": ["all"], "expect": {"ok": true}, "name": "setup: clear the floor (cheat)"},
  {"do": "key", "key": "f1", "name": "F1 opens the dock"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "open": true, "typing": false, "text": "", "expecting": false}, "name": "dock open, field idle"},
  {"do": "click", "x": 528, "y": 36, "verify": false, "click_anyway": true, "name": "click the field"},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "lastButton": "field", "typing": true, "expecting": true, "locked": true}, "name": "the click armed text input"},
  {"do": "hover", "x": 100, "y": 180, "verify": false, "name": "pointer off the dock while typing"},
  {"do": "gl", "verb": "state", "expect": {"ok": true}, "save_as": "p0", "name": "player position before typing"},
  {"do": "text", "text": "fire", "name": "type 'fire'"},
  {"do": "key", "key": "d", "hold": 0.6, "name": "hold D (move right) while typing"},
  {"do": "key", "key": "m", "name": "press M (map) while typing"},
  {"do": "key", "key": "i", "name": "press I (player menu) while typing"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "typing": true, "text": "firedmi", "focus": 2}, "name": "the text landed, bound keys typed their letters, the gl probes did not, the dock holds focus off the dock"},
  {"do": "gl", "verb": "state", "expect": {"ok": true}, "save_as": "p1", "name": "player position after typing"},
  {"do": "compare", "a": "p0", "b": "p1", "same": ["player.x", "player.y"], "name": "D did not move the player while typing"},
  {"do": "gl", "verb": "ui", "expect": {"ok": true, "windows": []}, "name": "M and I opened no window"},
  {"do": "key", "key": "backspace", "name": "Backspace"},
  {"do": "sleep", "seconds": 0.3},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "text": "firedm"}, "name": "Backspace removed one character"},
  {"do": "key", "key": "enter", "name": "Enter"},
  {"do": "sleep", "seconds": 0.3},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "typing": false, "submits": 1, "text": "firedm", "expecting": false, "locked": false}, "name": "Enter submitted and disarmed text input"},
  {"do": "gl", "verb": "ui", "expect": {"ok": true, "windows": []}, "name": "Enter opened nothing"},
  {"do": "click", "x": 528, "y": 36, "verify": false, "click_anyway": true, "name": "click the field again"},
  {"do": "text", "text": "xyz", "name": "type 'xyz'"},
  {"do": "sleep", "seconds": 0.3},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "typing": true, "text": "firedmxyz"}, "name": "second edit appends"},
  {"do": "key", "key": "escape", "name": "Escape"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "typing": false, "cancels": 1, "text": "firedm", "locked": false, "open": true}, "name": "Escape dropped the edit and left the dock open"},
  {"do": "gl", "verb": "ui", "expect": {"ok": true, "windows": []}, "name": "Escape did not open the pause menu"},
  {"do": "hover", "x": 100, "y": 180, "verify": false, "name": "pointer off the dock"},
  {"do": "sleep", "seconds": 0.3},
  {"do": "gl", "verb": "state", "expect": {"ok": true}, "save_as": "p2", "name": "player position before moving"},
  {"do": "gl", "verb": "input", "args": [600, 1, 0], "expect": {"ok": true}, "name": "hold right 600 ms"},
  {"do": "sleep", "seconds": 1},
  {"do": "gl", "verb": "state", "expect": {"ok": true}, "save_as": "p3", "name": "player position after moving"},
  {"do": "compare", "a": "p2", "b": "p3", "differ": ["player.x"], "name": "after typing, the player moves again"},
  {"do": "shot", "name": "dock-field"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] field submit 'firedm'", "timeout": 5},
  {"do": "log_clean"}
 ]
}
