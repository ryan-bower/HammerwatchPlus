{
 "name": "hp4-compose",
 "about": "HP4 (docs/devarena/SPEC.md, happy paths; Decided 25): ranger_nature/mid, F1, the Compose tab. Entangle's slot becomes a projectile skill: marked_arrow with a fan and a burst on cast, fire damage, the marked status, named by typing. CHECK is clean, Apply makes v1 in slot B and it goes live under the new name. F4, bench A (vanilla) vs B (composed) 3 pulls of 5 s: the composed slot deals damage. Back on Compose, Revert puts the slot back. Buttons are aimed by id (gl da-dock).",
 "fixture": "mission-ranger",
 "mods": ["hwplib", "devarena"],
 "timeout": 600,
 "steps": [
  {"do": "gl", "verb": "mission", "args": ["dark_citadel", 13, "seed=4242", "ngp=0"], "expect": {"ok": true}, "name": "setup: dark_citadel floor 13"},
  {"do": "wait_phase", "phase": "mission", "timeout": 120},
  {"do": "sleep", "seconds": 3},
  {"do": "gl", "verb": "cull", "args": ["all"], "expect": {"ok": true}, "name": "setup: clear the floor (cheat)"},
  {"do": "mark", "name": "preset"},
  {"do": "gl", "verb": "da-preset", "args": ["ranger_nature/mid"], "expect": {"ok": true}, "name": "setup: ranger_nature/mid"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout ranger_nature/mid (ok|mismatch)", "since": "preset", "timeout": 15, "name": "mid applied"},

  {"do": "key", "key": "f1", "name": "F1"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "click", "dock": "tab-compose", "verify": false, "name": "the Compose tab"},
  {"do": "gl", "verb": "da-compose", "expect": {"ok": true, "catalog": true, "projectiles": 4, "templates": 2, "snippets": 2}, "name": "the catalog loaded"},
  {"do": "click", "dock": "cmpslot|nature_entangle", "verify": false, "name": "slot: Entangle"},
  {"do": "click", "dock": "cmpt|projectile", "verify": false, "name": "start: projectile"},
  {"do": "gl", "verb": "da-compose", "expect": {"ok": true, "slot": "nature_entangle", "errors.0": "pick a projectile"}, "name": "CHECK asks for a projectile"},
  {"do": "click", "dock": "cmpp|marked_arrow", "verify": false, "name": "shoots: marked_arrow"},
  {"do": "click", "dock": "cmpc|fan", "verify": false, "name": "on cast: fan"},
  {"do": "click", "dock": "cmpc|burst", "verify": false, "name": "on cast: burst"},
  {"do": "click", "dock": "cmpdt|fire", "verify": false, "name": "damage: fire"},
  {"do": "click", "dock": "cmpst|marked", "verify": false, "name": "status: marked"},
  {"do": "click", "dock": "cmpf|n", "verify": false, "name": "the name field"},
  {"do": "text", "text": "Thorn Volley", "name": "type Thorn Volley"},
  {"do": "key", "key": "enter", "name": "Enter"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-compose", "expect": {"ok": true, "draft": "t=projectile;p=marked_arrow;c=fan,burst;s=;dt=fire;st=marked;n=Thorn Volley;src=;cp=;cd=;mc=;dmg=", "errors": []}, "name": "the draft, CHECK clean"},
  {"do": "shot", "name": "compose-draft"},

  {"do": "mark", "name": "apply"},
  {"do": "click", "dock": "cmp-apply", "verify": false, "name": "Apply"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] compose-dict nature_entangle \\{.*\"class\":\"Skills::PlayerSkillDirectional\".*\"fire-bind\":\"burst-dmg\"\\},\\{\"class\":\"ApplyBuff\"","since": "apply", "timeout": 10, "name": "the dict was built"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] live v1 ", "since": "apply", "timeout": 10, "name": "v1 is live"},
  {"do": "gl", "verb": "da-compose", "expect": {"ok": true, "name": "Thorn Volley", "class": "Skills::PlayerSkillDirectional", "applied": 1, "clicks": 1}, "name": "the live slot is Thorn Volley"},
  {"do": "gl", "verb": "da-tune", "expect": {"ok": true, "a": 0, "b": 1, "slot": "B"}, "name": "v1 in slot B, vanilla in A"},
  {"do": "shot", "name": "compose-applied"},

  {"do": "click", "dock": "tab-bench", "verify": false, "name": "the Bench tab"},
  {"do": "mark", "name": "in"},
  {"do": "key", "key": "f4", "name": "F4: into the room"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] golem room in", "since": "in", "timeout": 5, "name": "in the room"},
  {"do": "click", "dock": "bsrc|versions", "verify": false, "name": "vs: versions"},
  {"do": "click", "dock": "bmode|bot", "verify": false, "name": "driver: bot"},
  {"do": "click", "dock": "bwhich|A+B", "verify": false, "name": "slots: A+B"},
  {"do": "click", "dock": "bpulls|3", "verify": false, "name": "3 pulls"},
  {"do": "click", "dock": "bsecs|5s", "verify": false, "name": "5 s"},
  {"do": "mark", "name": "bench"},
  {"do": "click", "dock": "bstart", "verify": false, "name": "Start bench"},
  {"do": "gl", "verb": "pointer", "args": ["320", "130", "move"], "expect": {"ok": true}, "name": "setup: the mouse off the dock"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] bench-result \\{\"bench\":1,", "since": "bench", "timeout": 180, "name": "the bench finished"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] bench-result \\{\"bench\":1,.*\"B\":\\{.*\\[\"nature_entangle\",[1-9]", "since": "bench", "timeout": 2, "name": "B: the composed slot dealt damage"},
  {"do": "bench_csv", "since": "bench", "min_rows": 6, "name": "CSV: 6 rows, stats agree"},
  {"do": "shot", "name": "compose-bench"},

  {"do": "click", "dock": "tab-compose", "verify": false, "name": "back to Compose"},
  {"do": "mark", "name": "revert"},
  {"do": "click", "dock": "cmp-revert", "verify": false, "name": "Revert slot"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] live v2 \\(0 edits\\)", "since": "revert", "timeout": 10, "name": "v2 (no edits) is live"},
  {"do": "gl", "verb": "da-compose", "expect": {"ok": true, "onSlot": ""}, "save_as": "reverted", "name": "the slot is vanilla again"},
  {"do": "log_lacks", "pattern": "\\[HWP:devarena\\].*(error|ERR|apply failed|rejected)", "name": "no devarena errors"}
 ]
}
