{
 "name": "spike-rebuild",
 "about": "Spike 1 (docs/devarena/SPEC.md build order): live skill rebuild. Patch Entangle's base cooldown 20000->3000 and its level-5 area-dmg bind 60->99 by copy-on-write into PlayerSkillDef.m_levelParams, rebuild with PlayerBase.LoadSkills, read both back on the live skill (fields on the Skill object, the bind through FetchData), then cast twice and measure the gap between cast starts.",
 "fixture": "mission-ranger",
 "mods": [
  "hwplib",
  "devarena"
 ],
 "timeout": 400,
 "steps": [
  {
   "do": "gl",
   "verb": "mission",
   "args": [
    "dark_citadel",
    13,
    "seed=4242",
    "ngp=0"
   ],
   "expect": {
    "ok": true,
    "seed": 4242
   }
  },
  {
   "do": "wait_phase",
   "phase": "mission",
   "timeout": 120
  },
  {
   "do": "sleep",
   "seconds": 3
  },
  {
   "do": "gl",
   "verb": "cull",
   "args": [
    "all"
   ],
   "expect": {
    "ok": true
   }
  },
  {
   "do": "gl",
   "verb": "da-skill",
   "args": [
    "nature_entangle",
    "area-dmg,area-ttl"
   ],
   "save_as": "before",
   "name": "before",
   "expect": {
    "ok": true,
    "level": 5,
    "cooldown": 20000,
    "castpoint": 150,
    "binds.area-dmg": "60",
    "rebuilds": 0,
    "slot": 1
   }
  },
  {
   "do": "gl",
   "verb": "da-set",
   "args": [
    "nature_entangle",
    0,
    "cooldown",
    3000
   ],
   "expect": {
    "ok": true,
    "applied": true
   }
  },
  {
   "do": "gl",
   "verb": "da-set",
   "args": [
    "nature_entangle",
    4,
    "binds.area-dmg",
    99
   ],
   "expect": {
    "ok": true,
    "applied": true
   }
  },
  {
   "do": "gl",
   "verb": "da-skill",
   "args": [
    "nature_entangle",
    "area-dmg,area-ttl"
   ],
   "save_as": "after",
   "name": "after",
   "expect": {
    "ok": true,
    "cooldown": 3000,
    "castpoint": 150,
    "binds.area-dmg": "99",
    "binds.area-ttl": "11000",
    "rebuilds": 2,
    "applied": 2,
    "cooldownC": 0
   }
  },
  {
   "do": "gl",
   "verb": "input",
   "args": [
    300,
    0,
    0,
    1,
    0,
    "skill2"
   ],
   "expect": {
    "ok": true
   }
  },
  {
   "do": "sleep",
   "seconds": 1.5
  },
  {
   "do": "gl",
   "verb": "da-skill",
   "args": [
    "nature_entangle",
    "area-dmg,area-ttl"
   ],
   "save_as": "cast1",
   "name": "cast1",
   "expect": {
    "ok": true,
    "casts": 1,
    "cooldownC": {
     "between": [
      500,
      3000
     ]
    }
   }
  },
  {
   "do": "sleep",
   "seconds": 2.5
  },
  {
   "do": "gl",
   "verb": "input",
   "args": [
    300,
    0,
    0,
    1,
    0,
    "skill2"
   ],
   "expect": {
    "ok": true
   }
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "gl",
   "verb": "da-skill",
   "args": [
    "nature_entangle",
    "area-dmg,area-ttl"
   ],
   "save_as": "cast2",
   "name": "cast2",
   "expect": {
    "ok": true,
    "casts": 2,
    "lastGap": {
     "between": [
      3600,
      6000
     ]
    },
    "cooldown": 3000
   }
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:devarena\\] applied nature_entangle\\[0\\]\\.cooldown=3000"
  },
  {
   "do": "log_lacks",
   "pattern": "\\[HWP:devarena\\] (rejected|apply failed)"
  },
  {
   "do": "log_clean"
  }
 ]
}
