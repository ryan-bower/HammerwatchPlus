    "all"
   ],
   "expect": {
    "ok": true
   },
   "name": "setup: clear the floor (cheat)"
  },
  {
   "do": "mark",
   "name": "preset"
  },
  {
   "do": "gl",
   "verb": "da-preset",
   "args": [
    "ranger_nature/mid"
   ],
   "expect": {
    "ok": true
   },
   "name": "setup: ranger_nature/mid"
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:devarena\\] loadout ranger_nature/mid ok",
