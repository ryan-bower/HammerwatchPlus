{
 "name": "hp5-relaunch",
 "about": "HP5 relaunch (docs/devarena/SPEC.md happy paths; Decided 26): ranger_nature/mid on dark_citadel floor 13; the golem set to footman elite NG+1 4M; Entangle's REFS area-unit edited to the poison area through the Tune tab, so the footer shows needs relaunch and [Relaunch]; the player walks off the start and the Golem tab is left open. [Relaunch] saves and logs; the runner syncs the override file from the log, quits and boots the saved session (no fixture readback). The mod re-enters the same floor with the same seed by itself and puts the player back: the preset, the A/B slots (v1 in B), the area-unit, the golem settings, the position and the dock on the Golem tab all come back.",
 "fixture": "mission-ranger",
 "mods": ["core", "devarena"],
 "timeout": 600,
 "steps": [
  {"do": "gl", "verb": "mission", "args": ["dark_citadel", 13, "seed=4242", "ngp=0"], "expect": {"ok": true}, "name": "setup: dark_citadel floor 13"},
  {"do": "wait_phase", "phase": "mission", "timeout": 120},
  {"do": "sleep", "seconds": 3},
  {"do": "gl", "verb": "cull", "args": ["all"], "expect": {"ok": true}, "name": "setup: clear the floor (cheat)"},
  {"do": "mark", "name": "preset"},
  {"do": "gl", "verb": "da-preset", "args": ["ranger_nature/mid"], "expect": {"ok": true}, "name": "setup: ranger_nature/mid"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout ranger_nature/mid ok", "since": "preset", "timeout": 15, "name": "mid applied"},

  {"do": "key", "key": "f1", "name": "F1"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "click", "dock": "tab-golem", "verify": false, "name": "the Golem tab"},
  {"do": "click", "dock": "gprof|footman elite", "verify": false, "name": "profile: footman elite"},
  {"do": "click", "dock": "gngp|+", "verify": false, "name": "NG+ 1"},
  {"do": "click", "dock": "gpool|4M", "verify": false, "name": "pool 4M"},
  {"do": "gl", "verb": "da-arena", "expect": {"ok": true, "golem.profile": "footman elite", "golem.ngp": 1, "golem.pool": 4000000}, "name": "golem settings set"},

  {"do": "click", "dock": "tab-tune", "verify": false, "name": "the Tune tab"},
  {"do": "click", "dock": "skill|nature_entangle", "verify": false, "name": "the Entangle chip"},
  {"do": "click", "dock": "filter", "verify": false, "name": "the Tune filter (REFS sits below the fold, the dock stops above the HUD)"},
  {"do": "text", "text": "area-unit", "name": "filter area-unit"},
  {"do": "key", "key": "enter", "name": "Enter"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "click", "dock": "ref|binds.area-unit", "verify": false, "name": "the area-unit REFS field"},
  {"do": "text", "text": "players/ranger/units/entangle_area_poison.unit", "name": "type the poison area"},
  {"do": "key", "key": "enter", "name": "release: Enter"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-tune", "args": ["nature_entangle", "binds.area-unit"], "save_as": "tuned",
   "expect": {"ok": true, "versions": 1, "live": 1, "slot": "B", "b": 1, "needsRelaunch": true, "values.0": "players/ranger/units/entangle_area_poison.unit"}, "name": "v1 live in B, needs relaunch"},
  {"do": "gl", "verb": "da-dock", "args": ["relaunch"], "expect": {"ok": true, "open": true, "buttons.relaunch.0": {"between": [1, 99999]}}, "name": "[Relaunch] is in the footer"},
  {"do": "shot", "name": "hp5-needs-relaunch"},

  {"do": "click", "dock": "tab-golem", "verify": false, "name": "back to the Golem tab"},
  {"do": "gl", "verb": "pointer", "args": ["320", "130", "move"], "expect": {"ok": true}, "name": "setup: the mouse off the dock"},
  {"do": "gl", "verb": "input", "args": [700, 1, 0], "expect": {"ok": true}, "name": "walk east off the start"},
  {"do": "sleep", "seconds": 1.2},
  {"do": "gl", "verb": "da-arena", "save_as": "before", "expect": {"ok": true, "preset": "ranger_nature/mid"}, "name": "before: the position"},
  {"do": "mark", "name": "press"},
  {"do": "click", "dock": "relaunch", "verify": false, "name": "[Relaunch]"},
  {"do": "relaunch", "since": "press", "timeout": 15, "name": "relaunch requested"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] override file: 1 versions, live v1, A v0, B v1, slot B", "timeout": 60, "name": "the override file came back at boot: v1 in B"},

  {"do": "log_has", "pattern": "\\[HWP:devarena\\] relaunch entering levels/\\S+ floor 13 seed 4242", "timeout": 90, "name": "the mod re-enters floor 13, seed 4242"},
  {"do": "wait_phase", "phase": "mission", "timeout": 120},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] relaunch restored \\{\"preset\":\"ranger_nature/mid\",\"tab\":\"golem\",\"dock\":true", "timeout": 60, "name": "restored: preset, tab, dock"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] relaunch restored .*\"fromStart\":([4-9]\\d|\\d{3,})\\} trinkets ([1-9]\\d*)/\\2\\b", "timeout": 5, "name": "the player had walked off the start; every trinket came back"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout ranger_nature/mid ok", "timeout": 5, "name": "the character still reads back as ranger_nature/mid"},
  {"do": "gl", "verb": "da-arena", "save_as": "after",
   "expect": {"ok": true, "floor": 13, "seed": 4242, "rlPending": false, "rlDist": {"between": [0, 4]}, "preset": "ranger_nature/mid",
              "golem.profile": "footman elite", "golem.ngp": 1, "golem.pool": 4000000}, "name": "same floor and seed, same spot, golem settings"},
  {"do": "gl", "verb": "da-tune", "args": ["nature_entangle", "binds.area-unit"], "save_as": "tunedAfter",
   "expect": {"ok": true, "versions": 1, "live": 1, "slot": "B", "a": 0, "b": 1, "needsRelaunch": false, "values.0": "players/ranger/units/entangle_area_poison.unit"}, "name": "A/B slots: v1 live in B"},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "open": true, "tab": "golem"}, "name": "the dock reopened on the Golem tab"},
  {"do": "shot", "name": "hp5-relaunched"},
  {"do": "log_lacks", "pattern": "\\[HWP:devarena\\].*\\b(error|ERR|apply failed|rejected|relaunch failed)\\b", "name": "no devarena errors"}
 ]
}
