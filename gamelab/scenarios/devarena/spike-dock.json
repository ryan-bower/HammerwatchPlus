{
 "name": "spike-dock",
 "about": "SUPERSEDED by tuner-dock (fixed window px from before the dock layout and dock-id clicks; kept as the spike record, expected to fail now). Spike 4 (docs/devarena/SPEC.md build order): the non-pausing dock with mouse capture. F1 (posted key) opens the immediate-mode dock on a mission floor; the game keeps running; with the pointer off the dock, keys still move the player and skills still cast; with the pointer on it, the module holds input focus (PLAYERMENU, as an open window does) so a skill press is held back; a click on the dock's button reaches the dock. Lab window 640x360 px = 768x432 UI (scale 0.833): the dock starts near px 416 (35% of the UI width, snapped to a pixel); its freeze button is the row under the title, px y ~18-28 for the hw8 font, clicked at (528, 23).",
 "fixture": "mission-ranger",
 "mods": ["hwplib", "devarena"],
 "timeout": 300,
 "steps": [
  {"do": "gl", "verb": "mission", "args": ["dark_citadel", 13, "seed=4242", "ngp=0"], "expect": {"ok": true}, "name": "setup: dark_citadel floor 13"},
  {"do": "wait_phase", "phase": "mission", "timeout": 120},
  {"do": "sleep", "seconds": 3},
  {"do": "gl", "verb": "cull", "args": ["all"], "expect": {"ok": true}, "name": "setup: clear the floor (cheat)"},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "open": false, "toggles": 0, "focus": 1}, "name": "before: dock closed, gameplay has focus"},
  {"do": "key", "key": "f1", "name": "F1"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "open": true, "toggles": 1, "paused": false, "drawn": {"between": [1, 100000]}, "dockPx": {"between": [405, 425]}}, "name": "F1 opened the dock, the game is not paused, the dock is drawn"},
  {"do": "shot", "name": "dock-open"},
  {"do": "hover", "x": 100, "y": 180, "verify": false, "name": "pointer off the dock"},
  {"do": "sleep", "seconds": 0.2},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "open": true, "hover": false, "focus": 1}, "name": "off the dock: gameplay keeps focus"},
  {"do": "gl", "verb": "state", "expect": {"ok": true}, "save_as": "p0", "name": "player position before moving"},
  {"do": "gl", "verb": "input", "args": [600, 1, 0], "expect": {"ok": true}, "name": "hold right 600 ms"},
  {"do": "sleep", "seconds": 1},
  {"do": "gl", "verb": "state", "expect": {"ok": true}, "save_as": "p1", "name": "player position after moving"},
  {"do": "compare", "a": "p0", "b": "p1", "differ": ["player.x"], "name": "keys still move the player with the dock open"},
  {"do": "hover", "x": 528, "y": 200, "verify": false, "name": "pointer on the dock (no button)"},
  {"do": "sleep", "seconds": 0.2},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "hover": true, "focus": 2, "blocked": {"between": [1, 100000]}}, "name": "on the dock: the dock holds input focus"},
  {"do": "gl", "verb": "input", "args": [300, 0, 0, 1, 0, "skill2"], "expect": {"ok": true}, "name": "press Skill2 (Entangle) with the pointer on the dock"},
  {"do": "sleep", "seconds": 1},
  {"do": "gl", "verb": "da-skill", "args": ["nature_entangle"], "expect": {"ok": true, "casts": 0}, "name": "the press over the dock did not cast"},
  {"do": "click", "x": 528, "y": 23, "verify": false, "click_anyway": true, "name": "click the dock's freeze button"},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "clicks": 1, "lastButton": "freeze"}, "name": "the click reached the dock's button"},
  {"do": "gl", "verb": "da-mobs", "expect": {"ok": true, "freeze": true}, "name": "the button did its job (freeze on)"},
  {"do": "hover", "x": 100, "y": 180, "verify": false, "name": "pointer off the dock again"},
  {"do": "sleep", "seconds": 0.2},
  {"do": "gl", "verb": "input", "args": [300, 0, 0, 1, 0, "skill2"], "expect": {"ok": true}, "name": "press Skill2 off the dock"},
  {"do": "sleep", "seconds": 1.5},
  {"do": "gl", "verb": "da-skill", "args": ["nature_entangle"], "expect": {"ok": true, "casts": 1}, "name": "off the dock the press casts"},
  {"do": "key", "key": "f1", "name": "F1 again"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "open": false, "toggles": 2, "focus": 1}, "name": "F1 closed the dock"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] dock open", "timeout": 5},
  {"do": "log_clean"}
 ]
}
