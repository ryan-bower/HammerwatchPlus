{
 "name": "loadout-dock",
 "about": "The Loadout tab as a player uses it (docs/devarena/SPEC.md, Loadout): F1, the Loadout tab (the dock widens to 45%), class and subclass chips, a click applies paladin_divine/early (a cross-class switch from the fixture's ranger), a star makes it a favorite, two compare ticks, a [+] on str is refused (no points), level [+] then str [+] are marked as a change from the preset, Save variant logs the build, Revert re-applies the preset, and the favorites row applies with one click. Buttons are aimed by id (gl da-dock).",
 "fixture": "mission-ranger",
 "mods": ["core", "devarena"],
 "timeout": 400,
 "steps": [
  {"do": "gl", "verb": "mission", "args": ["dark_citadel", 13, "seed=4242", "ngp=0"], "expect": {"ok": true}, "name": "setup: dark_citadel floor 13"},
  {"do": "wait_phase", "phase": "mission", "timeout": 120},
  {"do": "sleep", "seconds": 3},
  {"do": "gl", "verb": "cull", "args": ["all"], "expect": {"ok": true}, "name": "setup: clear the floor (cheat)"},

  {"do": "key", "key": "f1", "name": "F1"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "click", "dock": "tab-loadout", "verify": false, "name": "click the Loadout tab"},
  {"do": "gl", "verb": "da-dock", "args": ["lclass|"], "expect": {"ok": true, "open": true, "tab": "loadout"}, "name": "the Loadout tab is open"},
  {"do": "shot", "name": "loadout-tab"},
  {"do": "click", "dock": "lclass|paladin", "verify": false, "name": "click the paladin chip"},
  {"do": "click", "dock": "lsub|divine", "verify": false, "name": "click the divine chip"},
  {"do": "gl", "verb": "da-dock", "args": ["preset|paladin_divine"], "expect": {"ok": true, "lastButton": "lsub|divine"}, "name": "divine presets listed"},

  {"do": "mark", "name": "apply"},
  {"do": "click", "dock": "preset|paladin_divine/early", "verify": false, "name": "click paladin_divine/early"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout paladin_divine/early (ok|mismatch.*)", "since": "apply", "timeout": 10, "name": "the click applied the preset"},
  {"do": "gl", "verb": "da-loadout", "expect": {"ok": true, "preset": "paladin_divine/early", "bad": 0, "class": "paladin_divine", "level": 5}, "name": "paladin_divine/early reads back"},

  {"do": "click", "dock": "star|paladin_divine/early", "verify": false, "name": "star it"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout-favorites \\[\"paladin_divine/early\"\\]", "since": "apply", "timeout": 5, "name": "favorite logged"},
  {"do": "click", "dock": "cmp|paladin_divine/mid", "verify": false, "name": "tick mid"},
  {"do": "click", "dock": "cmp|paladin_divine/end", "verify": false, "name": "tick end"},
  {"do": "gl", "verb": "da-dock", "args": ["cmp|"], "expect": {"ok": true, "lastButton": "cmp|paladin_divine/end"}, "name": "two compare ticks"},

  {"do": "mark", "name": "edit"},
  {"do": "click", "dock": "lstat|str|+", "verify": false, "name": "str [+] with no points left"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout-edit stat str 1 refused: no stat points", "since": "edit", "timeout": 5, "name": "refused: the preset spent every point"},
  {"do": "click", "dock": "llevel|+", "verify": false, "name": "level [+]"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout-edit level\\s+1(?! refused)", "since": "edit", "timeout": 5, "name": "level raised by one"},
  {"do": "mark", "name": "edit2"},
  {"do": "click", "dock": "lstat|str|+", "verify": false, "name": "str [+]"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout-edit stat str 1(?! refused)", "since": "edit2", "timeout": 5, "name": "str raised by one"},
  {"do": "sleep", "seconds": 0.3},
  {"do": "shot", "name": "sheet-edited"},
  {"do": "gl", "verb": "da-loadout", "expect": {"ok": true, "edited": true, "level": 6}, "name": "the sheet is marked edited"},
  {"do": "click", "dock": "lsave", "verify": false, "name": "Save variant"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout-variant \\{\"id\":\"paladin_divine/early\\+e1\",\"from\":\"paladin_divine/early\",\"level\":6,\"rows\":\\[\\[\"stat\",\"str\",\"9\"\\]", "since": "edit", "timeout": 5, "name": "variant logged with str 9"},

  {"do": "mark", "name": "revert"},
  {"do": "click", "dock": "lrevert", "verify": false, "name": "Revert"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout paladin_divine/early ok", "since": "revert", "timeout": 10, "name": "Revert re-applied the preset"},
  {"do": "gl", "verb": "da-loadout", "expect": {"ok": true, "edited": false, "level": 5}, "name": "Revert cleared the edit"},

  {"do": "mark", "name": "fav"},
  {"do": "gl", "verb": "da-preset", "args": ["ranger_nature/mid"], "expect": {"ok": true}, "name": "setup: back to the ranger"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout ranger_nature/mid ok", "since": "fav", "timeout": 10, "name": "ranger applied"},
  {"do": "click", "dock": "fav|paladin_divine/early", "verify": false, "name": "click the favorite"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout paladin_divine/early ok", "since": "fav", "timeout": 10, "name": "the favorite applied in one click"},
  {"do": "sleep", "seconds": 0.3},
  {"do": "shot", "name": "favorite-applied"},
  {"do": "key", "key": "f1", "name": "F1 closes the dock"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "shot", "name": "mini-hud-preset"},
  {"do": "log_clean"}
 ]
}
