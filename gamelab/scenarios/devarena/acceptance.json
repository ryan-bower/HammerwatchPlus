{
 "name": "devarena-acceptance",
 "about": "Dev Arena acceptance (docs/devarena/SPEC.md, Definition of done 1-8), one run as a player would go: (1) ranger_nature/mid, F1 opens the dock without pausing. (5) Compose: Entangle's slot becomes Thorn Volley (projectile template, marked_arrow, fan + burst, fire, marked), Apply, cast it. (2) The clone: tools/devarena/clone_spec.py over this session's log at the composed version (gamelab/bots/devarena_clone.py, into the run folder) comes out file-for-file identical to mods/spec-ranger-test, so the relaunch below boots this session's spec. Compose Revert, then (3) the Tune tab: Entangle's damage curve (the L3 area-dmg cell, the level the preset gives) and castpoint typed in, applied live and read back on the live skill, plus a REFS edit (area-unit) that needs a relaunch. (4) F2 swaps A/B and both values take effect. (6) F4, golem footman elite (the spec's barracks elite, Decided in HP2) NG+3 with the vulnerability debuff, 5 pulls per variant, CSV rows carrying preset, variant, mode and spread. (7) The Loadout tab: ranger_nature/end, paladin_divine/early, every field read back; ranger_nature/mid again. (8) [Relaunch]: a cold boot back onto the floor, abandon to town, the guild hall to tier 3, the real Subclass Picker NPC (gamelab/bots/devarena_pick_spec.py), ranger_test taken, a mission floor, and the spec's composed Entangle cast with its tuned values. Buttons are aimed by id (gl da-dock); gl verbs are read-backs and setup.",
 "fixture": "mission-ranger",
 "mods": ["core", "devarena", "spec-ranger-test", "gamelab-it-campaign"],
 "timeout": 1500,
 "steps": [
  {"do": "gl", "verb": "mission", "args": ["dark_citadel", 13, "seed=4242", "ngp=0"], "expect": {"ok": true}, "name": "setup: dark_citadel floor 13"},
  {"do": "wait_phase", "phase": "mission", "timeout": 120},
  {"do": "sleep", "seconds": 3},
  {"do": "gl", "verb": "cull", "args": ["all"], "expect": {"ok": true}, "name": "setup: clear the floor (cheat)"},

  {"do": "mark", "name": "dod1"},
  {"do": "gl", "verb": "da-preset", "args": ["ranger_nature/mid"], "expect": {"ok": true}, "name": "DoD1 setup: ranger_nature/mid"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout ranger_nature/mid ok", "since": "dod1", "timeout": 15, "name": "DoD1: ranger_nature/mid applied and read back"},
  {"do": "gl", "verb": "da-loadout", "expect": {"ok": true, "preset": "ranger_nature/mid", "bad": 0, "class": "ranger_nature", "level": 12}, "name": "DoD1: the loadout reads back"},
  {"do": "key", "key": "f1", "name": "DoD1: F1"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-dock", "expect": {"ok": true, "open": true, "paused": false}, "name": "DoD1: the dock is open and the game is not paused"},
  {"do": "shot", "name": "dod1-dock"},

  {"do": "click", "dock": "tab-compose", "verify": false, "name": "DoD5: the Compose tab"},
  {"do": "click", "dock": "cmpslot|nature_entangle", "verify": false, "name": "DoD5: slot Entangle"},
  {"do": "click", "dock": "cmpt|projectile", "verify": false, "name": "DoD5: start from the projectile template"},
  {"do": "click", "dock": "cmpp|marked_arrow", "verify": false, "name": "DoD5: shoots marked_arrow"},
  {"do": "click", "dock": "cmpc|fan", "verify": false, "name": "DoD5: on cast fan"},
  {"do": "click", "dock": "cmpc|burst", "verify": false, "name": "DoD5: on cast burst"},
  {"do": "click", "dock": "cmpdt|fire", "verify": false, "name": "DoD5: damage fire"},
  {"do": "click", "dock": "cmpst|marked", "verify": false, "name": "DoD5: status marked"},
  {"do": "click", "dock": "cmpf|n", "verify": false, "name": "DoD5: the name field"},
  {"do": "text", "text": "Thorn Volley", "name": "DoD5: type Thorn Volley"},
  {"do": "key", "key": "enter", "name": "DoD5: Enter"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-compose", "expect": {"ok": true, "draft": "t=projectile;p=marked_arrow;c=fan,burst;s=;dt=fire;st=marked;n=Thorn Volley;src=;cp=;cd=;mc=;dmg=", "errors": []}, "name": "DoD5: the draft, CHECK clean"},
  {"do": "mark", "name": "apply"},
  {"do": "click", "dock": "cmp-apply", "verify": false, "name": "DoD5: Apply"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] live v1 ", "since": "apply", "timeout": 10, "name": "DoD5: v1 is live"},
  {"do": "gl", "verb": "da-compose", "expect": {"ok": true, "name": "Thorn Volley", "class": "Skills::PlayerSkillDirectional", "applied": 1}, "name": "DoD5: the live slot is Thorn Volley"},
  {"do": "gl", "verb": "pointer", "args": ["320", "130", "move"], "expect": {"ok": true}, "name": "setup: the mouse off the dock"},
  {"do": "gl", "verb": "input", "args": [300, 0, 0, 1, 0, "skill3"], "expect": {"ok": true}, "name": "DoD5: cast Thorn Volley (Skill3)"},
  {"do": "sleep", "seconds": 1.5},
  {"do": "gl", "verb": "da-skill", "args": ["nature_entangle"], "save_as": "thorn", "expect": {"ok": true, "casts": {"between": [1, 9]}}, "name": "DoD5: the composed skill cast"},
  {"do": "shot", "name": "dod5-cast"},

  {"do": "bot", "bot": "devarena_clone", "kwargs": {"src": "ranger_nature", "id": "ranger_test", "name": "Test Warden", "version": 1}, "save_as": "clone",
   "expect": {"terminal": "done", "code": 0, "identical": true, "files": 6}, "name": "DoD2: the clone of this session's v1 is mods/spec-ranger-test, file for file"},

  {"do": "mark", "name": "revert"},
  {"do": "click", "dock": "cmp-revert", "verify": false, "name": "Compose: Revert slot"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] live v2 \\(0 edits\\)", "since": "revert", "timeout": 10, "name": "the slot is vanilla again (v2, no edits)"},

  {"do": "click", "dock": "tab-tune", "verify": false, "name": "DoD3: the Tune tab"},
  {"do": "click", "dock": "skill|nature_entangle", "verify": false, "name": "DoD3: the Entangle chip"},
  {"do": "gl", "verb": "da-skill", "args": ["nature_entangle", "area-dmg"], "save_as": "vanilla", "expect": {"ok": true, "level": 3, "castpoint": 150}, "name": "DoD3 before: level 3, castpoint 150"},
  {"do": "click", "dock": "cell|binds.area-dmg|3", "verify": false, "name": "DoD3: the L3 area-dmg cell"},
  {"do": "text", "text": "99", "name": "DoD3: type 99"},
  {"do": "key", "key": "enter", "name": "DoD3: Enter"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "click", "dock": "feel|castpoint", "verify": false, "name": "DoD3: the castpoint field"},
  {"do": "text", "text": "100", "name": "DoD3: type 100"},
  {"do": "key", "key": "enter", "name": "DoD3: Enter"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-tune", "args": ["nature_entangle", "binds.area-dmg"], "expect": {"ok": true, "versions": 4, "live": 4, "a": 0, "b": 4, "slot": "B", "values.2": "99"}, "name": "DoD3: v4 live in B, the curve's L3 is 99"},
  {"do": "gl", "verb": "da-skill", "args": ["nature_entangle", "area-dmg"], "expect": {"ok": true, "castpoint": 100, "timeline.1": 100, "binds.area-dmg": "99"}, "name": "DoD3: the live skill reads area-dmg 99, castpoint 100, the cast event moved"},
  {"do": "click", "dock": "filter", "verify": false, "name": "the Tune filter (REFS sits below the fold, the dock stops above the HUD)"},
  {"do": "text", "text": "area-unit", "name": "filter area-unit"},
  {"do": "key", "key": "enter", "name": "Enter"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "click", "dock": "ref|binds.area-unit", "verify": false, "name": "the area-unit REFS field"},
  {"do": "text", "text": "players/ranger/units/entangle_area_poison.unit", "name": "type the poison area"},
  {"do": "key", "key": "enter", "name": "Enter"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-tune", "expect": {"ok": true, "b": 5, "needsRelaunch": true}, "name": "v5 in B, needs relaunch"},
  {"do": "shot", "name": "dod3-tuned"},

  {"do": "key", "key": "f2", "name": "DoD4: F2 to A"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-skill", "args": ["nature_entangle", "area-dmg"], "expect": {"ok": true, "castpoint": 150, "binds.area-dmg": {"not": "99"}}, "name": "DoD4: A is vanilla (castpoint 150, area-dmg back)"},
  {"do": "gl", "verb": "da-tune", "expect": {"ok": true, "slot": "A", "live": 0}, "name": "DoD4: slot A, v0 live"},
  {"do": "key", "key": "f2", "name": "DoD4: F2 to B"},
  {"do": "sleep", "seconds": 0.5},
  {"do": "gl", "verb": "da-skill", "args": ["nature_entangle", "area-dmg"], "expect": {"ok": true, "castpoint": 100, "binds.area-dmg": "99"}, "name": "DoD4: B again (castpoint 100, area-dmg 99)"},

  {"do": "mark", "name": "in"},
  {"do": "key", "key": "f4", "name": "DoD6: F4 into the room"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] golem room in", "since": "in", "timeout": 5, "name": "DoD6: in the room"},
  {"do": "click", "dock": "tab-golem", "verify": false, "name": "DoD6: the Golem tab"},
  {"do": "click", "dock": "gprof|footman elite", "verify": false, "name": "DoD6: profile footman elite"},
  {"do": "click", "dock": "gngp|+", "verify": false, "name": "DoD6: NG+ 1"},
  {"do": "click", "dock": "gngp|+", "verify": false, "name": "DoD6: NG+ 2"},
  {"do": "click", "dock": "gngp|+", "verify": false, "name": "DoD6: NG+ 3"},
  {"do": "click", "dock": "gpool|4M", "verify": false, "name": "DoD6: pool 4M"},
  {"do": "click", "dock": "gdebuff|vulnerability", "verify": false, "name": "DoD6: debuff vulnerability"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] golem debuff vulnerability on", "since": "in", "timeout": 5, "name": "DoD6: the debuff is on"},
  {"do": "gl", "verb": "da-arena", "expect": {"ok": true, "golem.profile": "footman elite", "golem.ngp": 3, "golem.pool": 4000000}, "name": "DoD6: golem settings"},
  {"do": "click", "dock": "tab-bench", "verify": false, "name": "DoD6: the Bench tab"},
  {"do": "click", "dock": "bsrc|versions", "verify": false, "name": "DoD6: vs versions"},
  {"do": "click", "dock": "bmode|bot", "verify": false, "name": "DoD6: driver bot"},
  {"do": "click", "dock": "bwhich|A+B", "verify": false, "name": "DoD6: slots A+B"},
  {"do": "click", "dock": "bpulls|5", "verify": false, "name": "DoD6: 5 pulls"},
  {"do": "click", "dock": "bsecs|10s", "verify": false, "name": "DoD6: 10 s"},
  {"do": "mark", "name": "bench"},
  {"do": "click", "dock": "bstart", "verify": false, "name": "DoD6: Start bench"},
  {"do": "gl", "verb": "pointer", "args": ["320", "130", "move"], "expect": {"ok": true}, "name": "setup: the mouse off the dock"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] bench 1 start bot 10 pulls of 10s, A v0, B v5", "since": "bench", "timeout": 5, "name": "DoD6: 10 pulls (5 per variant), A v0 vs B v5"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] bench-result \\{\"bench\":1,", "since": "bench", "timeout": 300, "name": "DoD6: the bench finished"},
  {"do": "log_has", "pattern": "bench-pull \\{\"bench\":1,\"variant\":\"B\",\"version\":5,.*\"preset\":\"ranger_nature/mid\".*\"debuffs\":\"[^\"]*vulnerability.*\"dps\":[1-9]", "since": "bench", "timeout": 5, "name": "DoD6: a B pull on ranger_nature/mid with the debuff dealt damage"},
  {"do": "bench_csv", "since": "bench", "min_rows": 10, "name": "DoD6: CSV 10 rows (preset, variant, mode, spread), the game's stats agree with bench.py"},
  {"do": "shot", "name": "dod6-verdict"},
  {"do": "mark", "name": "out"},
  {"do": "key", "key": "f4", "name": "F4 out of the room"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] golem room out", "since": "out", "timeout": 5, "name": "out of the room"},

  {"do": "click", "dock": "tab-loadout", "verify": false, "name": "DoD7: the Loadout tab"},
  {"do": "click", "dock": "lclass|ranger", "verify": false, "name": "DoD7: ranger"},
  {"do": "click", "dock": "lsub|nature", "verify": false, "name": "DoD7: nature"},
  {"do": "mark", "name": "end"},
  {"do": "click", "dock": "preset|ranger_nature/end", "verify": false, "name": "DoD7: apply ranger_nature/end"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout ranger_nature/end ok", "since": "end", "timeout": 10, "name": "DoD7: ranger_nature/end read back ok"},
  {"do": "gl", "verb": "da-loadout", "expect": {"ok": true, "preset": "ranger_nature/end", "bad": 0, "class": "ranger_nature", "level": 20}, "name": "DoD7: ranger_nature/end, every field"},
  {"do": "click", "dock": "lclass|paladin", "verify": false, "name": "DoD7: paladin"},
  {"do": "click", "dock": "lsub|divine", "verify": false, "name": "DoD7: divine"},
  {"do": "mark", "name": "pal"},
  {"do": "click", "dock": "preset|paladin_divine/early", "verify": false, "name": "DoD7: apply paladin_divine/early (cross-class)"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout paladin_divine/early ok", "since": "pal", "timeout": 10, "name": "DoD7: paladin_divine/early read back ok"},
  {"do": "gl", "verb": "da-loadout", "expect": {"ok": true, "preset": "paladin_divine/early", "bad": 0, "class": "paladin_divine"}, "name": "DoD7: paladin_divine/early, every field"},
  {"do": "shot", "name": "dod7-paladin"},
  {"do": "click", "dock": "lclass|ranger", "verify": false, "name": "ranger"},
  {"do": "click", "dock": "lsub|nature", "verify": false, "name": "nature"},
  {"do": "mark", "name": "mid"},
  {"do": "click", "dock": "preset|ranger_nature/mid", "verify": false, "name": "ranger_nature/mid again"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] loadout ranger_nature/mid ok", "since": "mid", "timeout": 10, "name": "ranger_nature/mid again, read back ok"},
  {"do": "gl", "verb": "da-skill", "args": ["nature_entangle", "area-dmg"], "expect": {"ok": true, "castpoint": 100, "binds.area-dmg": "99"}, "name": "the tuned Entangle is still live in B"},

  {"do": "gl", "verb": "da-dock", "args": ["relaunch"], "expect": {"ok": true, "open": true, "buttons.relaunch.0": {"between": [1, 99999]}}, "name": "DoD8: [Relaunch] is in the footer"},
  {"do": "mark", "name": "press"},
  {"do": "click", "dock": "relaunch", "verify": false, "name": "DoD8: [Relaunch]"},
  {"do": "relaunch", "since": "press", "timeout": 15, "name": "DoD8: relaunch requested"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] override file: 5 versions, live v5, A v0, B v5, slot B", "timeout": 60, "name": "DoD8: the cold boot read the override file: v5 in B"},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] relaunch entering levels/\\S+ floor 13 seed 4242", "timeout": 90, "name": "DoD8: the mod re-enters floor 13, seed 4242"},
  {"do": "wait_phase", "phase": "mission", "timeout": 120},
  {"do": "log_has", "pattern": "\\[HWP:devarena\\] relaunch restored \\{\"preset\":\"ranger_nature/mid\"", "timeout": 60, "name": "DoD8: restored ranger_nature/mid"},
  {"do": "sleep", "seconds": 2},
  {"do": "gl", "verb": "da-tune", "args": ["nature_entangle", "binds.area-unit"], "expect": {"ok": true, "b": 5, "slot": "B", "needsRelaunch": false, "values.0": "players/ranger/units/entangle_area_poison.unit"}, "name": "DoD8: after the cold boot the area-unit edit is live"},

  {"do": "gl", "verb": "itc-abandon", "expect": {"ok": true}, "name": "setup: abandon the run (the pause menu's Abandon -> yes path)"},
  {"do": "wait_phase", "phase": "town", "timeout": 120},
  {"do": "sleep", "seconds": 2.0},
  {"do": "bot", "bot": "it_harvest_endmenu", "expect": {"terminal": "done"}, "name": "close the mission-end screen"},
  {"do": "gl", "verb": "build", "args": ["guild_hall"], "expect": {"ok": true}, "name": "setup: build the guild hall (cheat)"},
  {"do": "sleep", "seconds": 0.8},
  {"do": "gl", "verb": "da-tierup", "args": ["guild_hall"], "expect": {"ok": true, "before": 0, "after": 1}, "name": "setup: guild hall tier 2 (cheat)"},
  {"do": "sleep", "seconds": 0.8},
  {"do": "gl", "verb": "da-tierup", "args": ["guild_hall"], "expect": {"ok": true, "before": 1, "after": 2}, "name": "setup: guild hall tier 3 (cheat)"},
  {"do": "bot", "bot": "it_pets_wait", "kwargs": {"verb": "near", "args": [6000, "npc_subclass_picker"], "expect": {"count": 1}, "timeout": 8, "cinema": false}, "expect": {"terminal": "done"}, "name": "DoD8: the Subclass Picker stands in the guild hall"},
  {"do": "bot", "bot": "devarena_pick_spec", "kwargs": {"spec": "ranger_test"}, "save_as": "pick", "expect": {"terminal": "done", "picked": true, "shown.shows": "ranger_test"}, "name": "DoD8: ranger_test picked at the real Subclass Picker NPC"},
  {"do": "sleep", "seconds": 1},
  {"do": "gl", "verb": "state", "expect": {"player.class": "ranger_test"}, "name": "DoD8: the class is ranger_test"},
  {"do": "shot", "name": "dod8-town"},
  {"do": "gl", "verb": "mission", "args": ["dark_citadel", 13, "seed=4242", "ngp=0"], "expect": {"ok": true}, "name": "setup: dark_citadel floor 13"},
  {"do": "wait_phase", "phase": "mission", "timeout": 120},
  {"do": "sleep", "seconds": 3},
  {"do": "gl", "verb": "cull", "args": ["all"], "expect": {"ok": true}, "name": "setup: clear the floor (cheat)"},
  {"do": "gl", "verb": "state", "expect": {"player.class": "ranger_test"}, "name": "DoD8: the mastery carried into the mission"},
  {"do": "gl", "verb": "da-skill", "args": ["hwp_ranger_test_nature_entangle", "proj-dmg,burst-dmg,burst-radius"], "save_as": "spec", "expect": {"ok": true, "castpoint": 150, "cooldown": 3000}, "name": "DoD8: the spec's Entangle carries the composed values"},
  {"do": "gl", "verb": "input", "args": [300, 0, 0, 1, 0, "skill3"], "expect": {"ok": true}, "name": "DoD8: cast it (slot 2 is Skill3)"},
  {"do": "sleep", "seconds": 1.5},
  {"do": "gl", "verb": "da-skill", "args": ["hwp_ranger_test_nature_entangle"], "expect": {"ok": true, "casts": 1}, "name": "DoD8: played: it cast once"},
  {"do": "shot", "name": "dod8-cast"},
  {"do": "log_lacks", "pattern": "(?i)(spec_ranger_test|spec-ranger-test|hwp_ranger_test).*\\b(error|not found|missing|failed)\\b", "name": "no spec errors"},
  {"do": "log_lacks", "pattern": "\\[HWP:devarena\\].*\\b(error|ERR|apply failed|rejected|relaunch failed)\\b", "name": "no devarena errors"},
  {"do": "log_lacks", "pattern": "(?i)\\b(script error|compile error|null pointer)\\b", "name": "no script errors"}
 ]
}
