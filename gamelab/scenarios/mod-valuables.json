{
 "name": "mod-valuables",
 "about": "mods/valuables: valuables pay 1 + the run's NG+ level times their vanilla gold. A run at NG+2 shows 3x, a dropped vase is worth 450 instead of 150 and picking it up pays 630 (vanilla adds 20% gold per NG+ level on top: 450 x 1.4); after an abort a run at NG+0 is back to vanilla (150 -> 150), so it never compounds; README Test checklist.",
 "fixture": "town-paladin",
 "mods": [
  "core",
  "valuables"
 ],
 "timeout": 360,
 "steps": [
  {
   "do": "log_has",
   "pattern": "\\[HWP:valuables\\] self-check done: 26 valuables at \\d+x",
   "timeout": 20,
   "name": "all 26 valuables set at boot"
  },
  {
   "do": "gl",
   "verb": "mission",
   "args": [
    "bandit_keep",
    0,
    2
   ],
   "expect": {
    "ok": true
   }
  },
  {
   "do": "wait_phase",
   "phase": "mission",
   "timeout": 150
  },
  {
   "do": "sleep",
   "seconds": 3
  },
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "show_chat"
  },
  {
   "do": "console",
   "line": "hwp god"
  },
  {
   "do": "gl",
   "verb": "cull"
  },
  {
   "do": "console",
   "line": "hwp valuables"
  },
  {
   "do": "log_has",
   "pattern": "Valuables pay 3x their vanilla gold at NG\\+2 \\(26 valuables; .* 150 -> 450\\)",
   "timeout": 5,
   "name": "status at NG+2: vase 150 -> 450"
  },
  {
   "do": "gl",
   "verb": "inv",
   "save_as": "before",
   "expect": {
    "materials.gold": 0
   },
   "name": "no gold before the pickup"
  },
  {
   "do": "console",
   "line": "hwp valuables drop ceramic_vase"
  },
  {
   "do": "log_has",
   "pattern": "dropped ceramic_vase worth 450",
   "timeout": 5,
   "name": "vase drops worth 450"
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "gl",
   "verb": "items",
   "args": [
    "200"
   ],
   "save_as": "it"
  },
  {
   "do": "pilot",
   "call": "use",
   "args": [
    "{$it.items.0.unit}"
   ],
   "timeout": 15
  },
  {
   "do": "sleep",
   "seconds": 1.5
  },
  {
   "do": "gl",
   "verb": "inv",
   "save_as": "after",
   "expect": {
    "materials.gold": 630
   },
   "name": "picking up the vase paid 630 gold (450, then vanilla's +20% gold per NG+ level: x1.4)"
  },
  {
   "do": "shot",
   "name": "pickup"
  },
  {
   "do": "gl",
   "verb": "abort"
  },
  {
   "do": "wait_phase",
   "phase": "town",
   "timeout": 120
  },
  {
   "do": "gl",
   "verb": "mission",
   "args": [
    "bandit_keep",
    0,
    0
   ],
   "expect": {
    "ok": true
   }
  },
  {
   "do": "wait_phase",
   "phase": "mission",
   "timeout": 150
  },
  {
   "do": "sleep",
   "seconds": 3
  },
  {
   "do": "console",
   "line": "show_chat"
  },
  {
   "do": "console",
   "line": "hwp valuables"
  },
  {
   "do": "log_has",
   "pattern": "Valuables pay 1x their vanilla gold at NG\\+0 .* 150 -> 150\\)",
   "timeout": 5,
   "name": "NG+0: vanilla again, no compounding"
  },
  {
   "do": "log_clean"
  }
 ]
}