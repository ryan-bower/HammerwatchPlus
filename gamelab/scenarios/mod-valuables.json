{
 "name": "mod-valuables",
 "about": "mods/valuables: every valuable's gold doubled at boot, a dropped vase pays 300 instead of 150, the multiplier setting never compounds; README Test checklist.",
 "fixture": "town-paladin",
 "mods": [
  "core",
  "valuables"
 ],
 "timeout": 240,
 "steps": [
  {
   "do": "log_has",
   "pattern": "\\[HWP:valuables\\] self-check done: 26 valuables at 2x",
   "timeout": 20,
   "name": "all 26 valuables doubled at boot"
  },
  {
   "do": "gl",
   "verb": "mission",
   "args": [
    "bandit_keep",
    0
   ],
   "expect": {
    "ok": true
   }
  },
  {
   "do": "wait_phase",
   "phase": "mission",
   "timeout": 150
  },
  {
   "do": "sleep",
   "seconds": 3
  },
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "show_chat"
  },
  {
   "do": "console",
   "line": "hwp god"
  },
  {
   "do": "gl",
   "verb": "cull"
  },
  {
   "do": "console",
   "line": "hwp valuables"
  },
  {
   "do": "log_has",
   "pattern": "Valuables pay 2x their vanilla gold \\(26 valuables; .* 150 -> 300\\)",
   "timeout": 5,
   "name": "status: vase 150 -> 300"
  },
  {
   "do": "gl",
   "verb": "inv",
   "save_as": "before",
   "expect": {
    "materials.gold": 0
   },
   "name": "no gold before the pickup"
  },
  {
   "do": "console",
   "line": "hwp valuables drop ceramic_vase"
  },
  {
   "do": "log_has",
   "pattern": "dropped ceramic_vase worth 300",
   "timeout": 5,
   "name": "vase drops worth 300"
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "gl",
   "verb": "items",
   "args": [
    "200"
   ],
   "save_as": "it"
  },
  {
   "do": "pilot",
   "call": "use",
   "args": [
    "{$it.items.0.unit}"
   ],
   "timeout": 15
  },
  {
   "do": "sleep",
   "seconds": 1.5
  },
  {
   "do": "gl",
   "verb": "inv",
   "save_as": "after",
   "expect": {
    "materials.gold": 300
   },
   "name": "picking up the vase paid 300 gold"
  },
  {
   "do": "shot",
   "name": "pickup"
  },
  {
   "do": "console",
   "line": "hwp set valuables.gold_mult 1"
  },
  {
   "do": "console",
   "line": "hwp valuables"
  },
  {
   "do": "log_has",
   "pattern": "Valuables pay 1x .* 150 -> 150\\)",
   "timeout": 5,
   "name": "multiplier 1 restores vanilla, no compounding"
  },
  {
   "do": "console",
   "line": "hwp set valuables.gold_mult 2"
  },
  {
   "do": "console",
   "line": "hwp valuables"
  },
  {
   "do": "log_has",
   "pattern": "Valuables pay 2x .* 150 -> 300\\)",
   "timeout": 5,
   "name": "back to 2x"
  },
  {
   "do": "log_clean"
  }
 ]
}