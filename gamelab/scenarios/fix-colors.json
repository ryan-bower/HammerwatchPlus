{
 "name": "fix-colors",
 "about": "probe",
 "fixture": "town-paladin",
 "mods": [
  "hwplib",
  "hwplib-luck",
  "hwplib-classui",
  "colors"
 ],
 "timeout": 300,
 "steps": [
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "bot",
   "bot": "fix_colors",
   "kwargs": {
    "sections": "tint"
   },
   "name": "colors",
   "expect": {
    "col_char": true,
    "col_contrast_friendly_seen": true,
    "col_contrast_enemy_seen": true,
    "col_contrast_drawn": true,
    "col_deuteranopia_friendly_seen": true,
    "col_deuteranopia_enemy_seen": true,
    "col_deuteranopia_drawn": true,
    "col_default_friendly_seen": true,
    "col_default_enemy_seen": true,
    "col_default_drawn": true,
    "col_contrast_rings": true,
    "col_deuteranopia_rings": true,
    "col_default_no_rings": true
   }
  },
  {
   "do": "log_clean"
  }
 ]
}
