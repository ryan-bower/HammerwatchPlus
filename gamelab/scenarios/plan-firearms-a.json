{
 "name": "plan-firearms-a",
 "about": "Test plan through the plan_firearms bot: the Frag Grenade lands where aimed, the Subclass Picker offers the three specializations, and the Marksman: Snipe, Critical Aim's Focus, Piercing Bullet, Headshot.",
 "fixture": "town-paladin",
 "mods": [
   "core",
   "abyss",
   "architect",
   "bufftips",
   "campaign",
   "chatlinks",
   "classes",
   "colors",
   "deathrecap",
   "droptrade",
   "farming",
   "firearms",
   "fishing",
   "gambler",
   "groupcombo",
   "keys",
   "laststats",
   "legacy",
   "maps",
   "mercenary",
   "pets",
   "puzzles",
   "specs",
   "stash",
   "strongbox",
   "summons",
   "valuables",
   "wavemode",
   "weapons",
   "weaponswap"
 ],
 "timeout": 600,
 "steps": [
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "show_chat"
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "bot",
   "bot": "plan_firearms",
   "kwargs": {
    "sections": "firearms_frag"
   },
   "name": "frag grenade",
   "expect": {
    "frag_cursor_held": true,
    "frag_thrown": true,
    "frag_explodes": true,
    "frag_lands_where_aimed": true,
    "frag_damage_numbers": true,
    "frag_radius_64": true
   }
  },
  {
   "do": "bot",
   "bot": "plan_firearms",
   "kwargs": {
    "sections": "firearms_spec_pick"
   },
   "name": "spec pick",
   "expect": {
    "spec_pick_open": true,
    "spec_pick_four": true,
    "picker_skill_labels": true,
    "spec_pick_takes": true
   }
  },
  {
   "do": "bot",
   "bot": "plan_firearms",
   "kwargs": {
    "sections": "firearms_marksman"
   },
   "name": "firearms marksman",
   "expect": {
    "snipe_casts": true,
    "snipe_cost": true,
    "snipe_no_rounds": true,
    "focus_passive": true,
    "focus_gains": true,
    "focus_lost_on_miss": true,
    "snipe_pierce_both": true,
    "headshot_crits": true,
    "sniper_own_buttons": true
   }
  },
  {
   "do": "log_clean"
  }
 ]
}