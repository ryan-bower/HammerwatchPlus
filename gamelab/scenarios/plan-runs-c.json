   "maps",
   "mercenary",
   "pets",
   "puzzles",
   "specs",
   "stash",
   "strongbox",
   "summons",
   "valuables",
   "wavemode",
   "weapons",
   "weaponswap"
 ],
 "timeout": 600,
 "steps": [
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "show_chat"
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "bot",
   "bot": "plan_runs",
   "kwargs": {
    "sections": "boss_setup"
   },
   "name": "boss test character",
   "expect": {
    "boss_char": true
   }
  },
  {
   "do": "bot",
   "bot": "plan_runs",
   "kwargs": {
    "sections": "boss_councilors"
   },
   "name": "three councilors",
   "expect": {
    "council_floor": true,
    "council_three": true,
    "council_node_to_node": true,
    "council_untargetable_moving": true,
    "council_fight_together": true
   }
  },
  {
   "do": "shot",
   "name": "boss-councilors"
  },
  {
   "do": "bot",
   "bot": "plan_runs",
   "kwargs": {
    "sections": "boss_watcher"
   },
   "name": "watcher wisps",
   "expect": {
    "watcher_floor": true,
    "watcher_spawned": true,
    "watcher_wisps_circle": true,
    "watcher_wisps_at_player_distance": true
   }
  },
  {
   "do": "shot",
   "name": "boss-watcher"
  },
  {
   "do": "log_clean"
  }
 ]
