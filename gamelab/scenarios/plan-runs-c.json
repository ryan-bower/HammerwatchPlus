 "fixture": "town-paladin",
 "mods": [
   "core",
   "abyss",
   "architect",
   "bufftips",
   "campaign",
   "chatlinks",
   "classes",
   "colors",
   "deathrecap",
   "droptrade",
   "farming",
   "firearms",
   "fishing",
   "gambler",
