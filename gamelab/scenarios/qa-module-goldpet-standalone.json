{
  "name": "qa-module-goldpet-standalone",
  "about": "Standalone functional subset with only required modules. Native gold collector vendor price/refusal/Lodge gates, actual gold pickup and floor carry. Every declared success flag, missing flag and extra failure/crash is checked; original source assertions unchanged.",
  "fixture": "town-paladin",
  "mods": [
    "core",
    "pets",
    "goldpet"
  ],
  "timeout": 600,
  "steps": [
    {
      "do": "console",
      "line": "e_cheats 1"
    },
    {
      "do": "console",
      "line": "show_chat"
    },
    {
      "do": "bot",
      "bot": "qa_modules_checks",
      "kwargs": {
        "sections": "goldpet,goldpet_run",
        "required_flags": [
          "vendor_spawned",
          "goldpet_poor_refused",
          "goldpet_bought",
          "goldpet_tier2_gated",
          "goldpet_in_run",
          "goldpet_picks_gold",
          "goldpet_after_floor_change"
        ]
      },
      "expect": {
        "ok": true
      }
    },
    {
      "do": "log_clean"
    }
  ]
}
