{
 "name": "mod-options-tab",
 "about": "The player menu's Plus tab (core HWPOptionsTab, gui/hwp/options.gui): the hook adds it to the open PlayerMenu, the colors row cycles presets on click, and the weaponswap row rebinds the swap key to the next key pressed (posted R). The swap key does nothing while the Plus tab is up, and Esc during a capture closes only the capture window (the menu stays, the key is kept). The search field filters rows as you type (posted chars) and Esc clears it without closing the menu.",
 "fixture": "town-paladin",
 "mods": [
  "hwplib",
  "hwplib-luck",
  "hwplib-classui",
  "colors",
  "weaponswap"
 ],
 "timeout": 150,
 "steps": [
  {
   "do": "gl",
   "verb": "state",
   "expect": {
    "phase": "town"
   }
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "character"
   ]
  },
  {
   "do": "sleep",
   "seconds": 0.5
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-colors"
   ],
   "save_as": "colors0",
   "expect": {
    "tab": "HWPOptionsTab",
    "shown": true,
    "texts": "Projectile colors | Default"
   }
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-swapkey"
   ],
   "expect": {
    "shown": true,
    "texts": "Swap weapons | X"
   }
  },
  {
   "do": "sleep",
   "seconds": 0.3
  },
  {
   "do": "shot",
   "name": "plus_tab"
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-colors",
    "hwp-opt",
    "colors"
   ]
  },
  {
   "do": "sleep",
   "seconds": 0.2
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-colors"
   ],
   "expect": {
    "texts": "Projectile colors | High contrast"
   }
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:options\\] colors -> High contrast",
   "timeout": 5
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-swapkey",
    "hwp-opt",
    "swapkey"
   ]
  },
  {
   "do": "sleep",
   "seconds": 0.3
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-swapkey"
   ],
   "expect": {
    "texts": "Swap weapons | press a key..."
   }
  },
  {
   "do": "shot",
   "name": "capture"
  },
  {
   "do": "key",
   "key": "r",
   "hold": 0.2
  },
  {
   "do": "sleep",
   "seconds": 0.3
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:options\\] swapkey key set to 21 \\(R\\)",
   "timeout": 5
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:options\\] swapkey naming key 21",
   "timeout": 5,
   "name": "R types a character: the capture asks for a second press to name it"
  },
  {
   "do": "key",
   "key": "escape",
   "hold": 0.1
  },
  {
   "do": "sleep",
   "seconds": 0.3
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:options\\] swapkey key 21 keeps its name R",
   "timeout": 5,
   "name": "Esc while naming keeps the US name"
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-swapkey"
   ],
   "expect": {
    "texts": "Swap weapons | R"
   }
  },
  {
   "do": "key",
   "key": "r",
   "hold": 0.2
  },
  {
   "do": "sleep",
   "seconds": 0.5
  },
  {
   "do": "log_lacks",
   "pattern": "\\[HWP:weaponswap\\] (set \\d in hand|swap channel started)",
   "name": "the swap key does nothing on the Plus tab"
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-swapkey",
    "hwp-opt",
    "swapkey"
   ]
  },
  {
   "do": "sleep",
   "seconds": 0.3
  },
  {
   "do": "key",
   "key": "escape",
   "hold": 0.1
  },
  {
   "do": "sleep",
   "seconds": 0.3
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:options\\] swapkey key capture cancelled",
   "timeout": 5
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-swapkey"
   ],
   "name": "Esc closed only the capture: the menu is still on the Plus tab, key kept",
   "expect": {
    "tab": "HWPOptionsTab",
    "shown": true,
    "texts": "Swap weapons | R"
   }
  },
  {
   "do": "key",
   "key": "escape",
   "hold": 0.1
  },
  {
   "do": "sleep",
   "seconds": 0.6
  },
  {
   "do": "key",
   "key": "r",
   "hold": 0.2
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:weaponswap\\] set \\d in hand",
   "timeout": 5,
   "name": "control: with the menu closed the new key swaps"
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "character"
   ]
  },
  {
   "do": "sleep",
   "seconds": 0.5
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "search",
    "!click"
   ],
   "expect": {
    "ok": true
   },
   "name": "press the search field"
  },
  {
   "do": "sleep",
   "seconds": 0.8
  },
  {
   "do": "type",
   "text": "swap"
  },
  {
   "do": "sleep",
   "seconds": 0.4
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "search"
   ],
   "name": "the field holds what was typed",
   "expect": {
    "input": "swap"
   }
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-colors"
   ],
   "name": "search 'swap' hides the colors row",
   "expect": {
    "shown": false,
    "tab": "HWPOptionsTab"
   }
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-swapkey"
   ],
   "name": "search 'swap' keeps the swap key row",
   "expect": {
    "shown": true
   }
  },
  {
   "do": "shot",
   "name": "search"
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "search",
    "!click"
   ],
   "expect": {
    "ok": true
   },
   "name": "press the search field again (a no-op while it still has the keyboard)"
  },
  {
   "do": "sleep",
   "seconds": 0.8
  },
  {
   "do": "key",
   "key": "escape",
   "hold": 0.1
  },
  {
   "do": "sleep",
   "seconds": 0.4
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-colors"
   ],
   "name": "Esc in the search clears it: rows back, menu still open",
   "expect": {
    "shown": true,
    "tab": "HWPOptionsTab"
   }
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "search",
    "!click"
   ],
   "expect": {
    "ok": true
   },
   "name": "press the search field again (a no-op while it still has the keyboard)"
  },
  {
   "do": "sleep",
   "seconds": 0.8
  },
  {
   "do": "type",
   "text": "qxz",
   "gap": 0.12
  },
  {
   "do": "sleep",
   "seconds": 0.4
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hint"
   ],
   "name": "no match: the hint says so",
   "expect": {
    "texts": "No settings match \"qxz\"."
   }
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "hwp-opt-swapkey"
   ],
   "name": "no match: rows hidden",
   "expect": {
    "shown": false
   }
  },
  {
   "do": "gl",
   "verb": "menu",
   "args": [
    "hwp_options",
    "-",
    "search",
    "!click"
   ],
   "expect": {
    "ok": true
   },
   "name": "press the search field again (a no-op while it still has the keyboard)"
  },
  {
   "do": "sleep",
   "seconds": 0.8
  },
  {
   "do": "key",
   "key": "escape",
   "hold": 0.1
  },
  {
   "do": "sleep",
   "seconds": 0.4
  },
  {
   "do": "console",
   "line": "hwp colors"
  },
  {
   "do": "log_has",
   "pattern": "preset contrast",
   "timeout": 5
  },
  {
   "do": "log_clean"
  }
 ]
}
