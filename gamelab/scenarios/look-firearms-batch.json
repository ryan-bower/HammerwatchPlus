{
 "name": "look-firearms-batch",
 "about": "Measurement for the 2026-10-19 batch: dual pistols' shot gaps on a held trigger (hwp firearms shots, even at 300 ms); Ordinance Hoarder's icon counting every use ready and the skill slot's ring banking the next charge with the icon bright (ChargeHUD.as, frames); the demo's endless orb (two picks from one sphere); a spawned Skill Trainer with every tier open (shoplevel 4). Uses givestacks and skillpoints cheats: not evidence of play.",
 "fixture": "town-paladin",
 "mods": ["hwplib", "hwplib-luck", "hwplib-classui", "firearms"],
 "timeout": 240,
 "steps": [
  {"do": "gl", "verb": "char", "args": ["hwp_firearms", "Look"]},
  {"do": "wait_phase", "phase": "town", "timeout": 60},
  {"do": "sleep", "seconds": 2},

  {"do": "gl", "verb": "equip", "args": ["hwp_glock_mh_01", "common"]},
  {"do": "gl", "verb": "equip", "args": ["hwp_glock_oh_01", "common"]},
  {"do": "sleep", "seconds": 2},
  {"do": "gl", "verb": "givestacks", "args": ["players/hwp/firearms/stacks_firearms.sval:clip", "999"]},
  {"do": "gl", "verb": "input", "args": ["3200", "0", "0", "1", "0", "main"]},
  {"do": "sleep", "seconds": 4},
  {"do": "console", "line": "hwp firearms shots"},
  {"do": "log_capture", "pattern": "shots: (?P<n>\\d+) rounds, gaps (?P<gaps>[0-9 ]+)", "save_as": "pistol_gaps", "timeout": 5},

  {"do": "gl", "verb": "equip", "args": ["hwp_rifle_01", "common"]},
  {"do": "console", "line": "e_cheats 1"},
  {"do": "console", "line": "hwp levelup 20"},
  {"do": "sleep", "seconds": 1},
  {"do": "gl", "verb": "subclass", "args": ["hwp_firearms_demolitions"]},
  {"do": "console", "line": "hwp skillpoints 40"},
  {"do": "sleep", "seconds": 1},
  {"do": "gl", "verb": "skill", "args": ["hwp_fs_rpg", "1"], "expect": {"level": 1}},
  {"do": "sleep", "seconds": 1},
  {"do": "gl", "verb": "skill", "args": ["hwp_fs_hoarder", "1"], "expect": {"level": 1}},
  {"do": "sleep", "seconds": 8},
  {"do": "gl", "verb": "givestacks", "args": ["players/hwp/firearms/stacks_firearms.sval:rocket_charges", "0"], "expect": {"stacks": 1}, "name": "one charge banked while ready"},
  {"do": "gl", "verb": "givestacks", "args": ["players/hwp/firearms/stacks_firearms.sval:rocket_charges_shown", "0"], "expect": {"stacks": 2}, "name": "icon 2: stored + ready"},
  {"do": "shot", "name": "ring_full"},
  {"do": "console", "line": "cht_give_mana 999"},
  {"do": "gl", "verb": "castat", "args": ["hwp_fs_rpg", "80", "0"]},
  {"do": "log_has", "pattern": "hoarder: spent a charge of [^,]*rocket_charges, 0 left", "timeout": 5},
  {"do": "gl", "verb": "givestacks", "args": ["players/hwp/firearms/stacks_firearms.sval:rocket_charges_shown", "0"], "expect": {"stacks": 1}, "name": "icon 1: the skill ready again, none stored"},
  {"do": "log_has", "pattern": "hoarder: slot ring shows a charge banking", "timeout": 3},
  {"do": "shot", "name": "ring_banking"},

  {"do": "gl", "verb": "spawn", "args": ["gamelab/skill_sphere_endless.unit", "0", "0"]},
  {"do": "sleep", "seconds": 1},
  {"do": "gl", "verb": "use", "args": ["GameLabEndless"], "expect": {"window": "GiveSkillSphereMenu"}},
  {"do": "sleep", "seconds": 1},
  {"do": "gl", "verb": "func", "args": ["pick", "1"]},
  {"do": "log_has", "pattern": "endless orb: picked", "timeout": 5},
  {"do": "sleep", "seconds": 1},
  {"do": "gl", "verb": "use", "args": ["GameLabEndless"], "expect": {"window": "GiveSkillSphereMenu"}, "name": "the orb opens again after a pick"},
  {"do": "sleep", "seconds": 1},
  {"do": "shot", "name": "orb_second"},
  {"do": "gl", "verb": "func", "args": ["pick", "1"]},
  {"do": "sleep", "seconds": 1},

  {"do": "gl", "verb": "spawn", "args": ["actors/npcs/town/npc_skill_trainer.unit", "0", "30"]},
  {"do": "sleep", "seconds": 1},
  {"do": "gl", "verb": "shoplevel", "args": ["npc_skill_trainer", "4"], "expect": {"n": 1, "level": 4}},
  {"do": "gl", "verb": "use", "args": ["npc_skill_trainer"]},
  {"do": "sleep", "seconds": 1},
  {"do": "shot", "name": "trainer"},
  {"do": "log_clean"}
 ]
}
