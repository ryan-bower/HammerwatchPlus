    "bandit_keep",
    0
   ],
   "expect": {
    "ok": true
   }
  },
  {
   "do": "wait_phase",
   "phase": "mission",
   "timeout": 150
  },
  {
   "do": "sleep",
   "seconds": 3
  },
  {
   "do": "gl",
   "verb": "querycmp",
   "args": [
    100,
    "items/dyes/dye_bucket_cloth_common.unit"
