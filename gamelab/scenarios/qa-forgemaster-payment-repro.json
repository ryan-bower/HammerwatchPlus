{
  "name": "qa-forgemaster-payment-repro",
  "about": "Original-product controlled native payment consumer rows; preserve every row, original failure, exact source and teardown. Requires current cursor projection/native contracts and generated family before root execution.",
  "fixture": "town-paladin",
  "mods": [
    "hwplib",
    "hwplib-luck",
    "hwplib-classui",
    "classes",
    "specs"
  ],
  "timeout": 300,
  "steps": [
    {
      "do": "log_has",
      "pattern": "\\[HWP:specs\\] 8 of 8 subclasses registered",
      "timeout": 30
    },
    {
      "do": "console",
      "line": "e_cheats 1"
    },
    {
      "do": "console",
      "line": "show_chat"
    },
    {
      "do": "sleep",
      "seconds": 1
    },
    {
      "do": "bot",
      "bot": "qa_forgemaster_channel_repro",
      "name": "payment",
      "kwargs": {
        "mode": "payment"
      },
      "expect": {
        "P0_contract": true,
        "P0_healthy": true,
        "P1_contract": true,
        "P1_healthy": true,
        "P2_contract": true,
        "P2_healthy": true,
        "P3_contract": true,
        "P3_healthy": true,
        "all_rows": true
      }
    },
    {
      "do": "log_clean"
    }
  ]
}
