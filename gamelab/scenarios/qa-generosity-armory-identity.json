{
    "name":  "qa-generosity-armory-identity",
    "needs_hoh1":  true,
 "about": "One controlled armory-only reproduction on the real HoH1 arena with scythe, mage and staff. Exact requested/predicted-pick/held/log IDs, nonempty exact roster, nonpassive pre-cast state and actual-held motion. Pre-active then later suppressed is sampled state only; no causal interruption credit. Preserve historical 223px/237px failures and all internal bounded attempt rows.",
    "fixture":  "town-paladin",
    "mods":  [
                 "hwplib",
                 "hwplib-luck",
                 "hwplib-classui",
                 "classes",
                 "specs",
                 "campaign",
                 "gamelab-it-campaign"
             ],
    "timeout":  600,
    "steps":  [
                  {
                      "do":  "console",
                      "line":  "hwp set hoh1.content true",
                      "expect":  "hoh1\\.content = true",
                      "name":  "hoh1.content on (off by default; saved with the town)"
                  },
                  {
                      "do":  "restart"
                  },
                  {
                      "do":  "log_has",
                      "pattern":  "\\[HWP:specs\\] 8 of 8 subclasses registered",
                      "timeout":  30
                  },
                  {
                      "do":  "console",
                      "line":  "e_cheats 1"
                  },
                  {
                      "do":  "console",
                      "line":  "show_chat"
                  },
                  {
                      "do":  "sleep",
                      "seconds":  1
                  },
                  {
                      "do":  "bot",
                      "bot":  "plan_generosity",
                      "kwargs":  {
                                     "sections":  "hoh1",
                                     "only":  "boss_armory"
                                 },
                      "name":  "armory exact Fury identity",
                      "expect":  {
                                     "h1_char":  true,
                                     "h1_learned":  true,
                                     "hoh1_floors":  true,
                                     "hoh1_roster":  true,
                                     "hoh1_target_identity":  true,
                                     "hoh1_precast_active":  true,
                                     "hoh1_motion_observed":  true,
                                     "hoh1_spawned":  true,
                                     "hoh1_held_most":  true,
                                     "hoh1_refused_by_design":  true,
                                     "hoh1_refusal_keeps":  true,
                                     "hoh1_pre_active_then_suppressed":  true,
                                     "hoh1_stays":  true,
                                     "hoh1_cooldown_60":  true,
                                     "hoh1_spent":  true,
                                     "hoh1_armor_0":  true,
                                     "hoh1_beams":  true,
                                     "hoh1_no_errors":  true
                                 }
                  },
                  {
                      "do":  "log_clean"
                  }
              ]
}
