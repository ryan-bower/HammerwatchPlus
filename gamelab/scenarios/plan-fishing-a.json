{
 "name": "plan-fishing-a",
 "about": "Test plan through the plan_fishing bot, in town: fishing s5 (fish as bag items: stars, quality, town ilvl; wielded with the longsword swing; the equipped fish's tooltip), fishing s6 (an uncommon fish at the enchanter: Upgrade, Enchant with the town's blueprints (cht_add_all_blueprints) and a new modifier, the same modifier pool as a vanilla longsword, the worked fish no ware and kept by Sell; Enchant on fresh uncommon / rare fish), fishing s13 (the rod slot and its tooltip; shot rod-slot: the character screen with the rod icon bottom left of the gear grid).",
 "fixture": "town-paladin",
 "mods": [
   "hwplib",
   "hwplib-luck",
   "hwplib-classui",
   "abyss",
   "architect",
   "bufftips",
   "campaign",
   "chatlinks",
   "classes",
   "colors",
   "deathrecap",
   "droptrade",
   "farming",
   "firearms",
   "fishing",
   "gambler",
   "groupcombo",
   "keys",
   "laststats",
   "legacy",
   "maps",
   "mercenary",
   "pets",
   "puzzles",
   "specs",
   "stash",
   "strongbox",
   "summons",
   "valuables",
   "wavemode",
   "weapons",
   "weaponswap"
 ],
 "timeout": 600,
 "steps": [
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "show_chat"
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "bot",
   "bot": "plan_fishing",
   "kwargs": {
    "sections": "fish_sword"
   },
   "name": "fish as a sword",
   "expect": {
    "fish_caught": true,
    "fish_name_stars": true,
    "fish_quality_by_stars": true,
    "fish_town_ilvl": true,
    "fresh_fish_has_mods": true,
    "fish_wields": true,
    "fish_longsword_attack": true,
    "fish_tooltip_stars": true,
    "fish_tooltip_ilvl": true
   }
  },
  {
   "do": "bot",
   "bot": "plan_fishing",
   "kwargs": {
    "sections": "fish_enchant"
   },
   "name": "fish at the enchanter",
   "expect": {
    "enchanter_level": true,
    "enchanter_open": true,
    "fish_offers_both": true,
    "fish_upgrade_works": true,
    "fish_enchant_pool": true,
    "fish_enchant_view": true,
    "fish_enchant_works": true,
    "worked_not_ware": true,
    "worked_kept_on_sell": true,
    "fresh_mod_fish_sold": true,
    "fresh_uncommon_enchant": true,
    "fresh_rare_enchant": true,
    "fish_pool_like_longsword": true
   }
  },
  {
   "do": "bot",
   "bot": "plan_fishing",
   "kwargs": {
    "sections": "eat_fish"
   },
   "name": "eat fish",
   "expect": {
    "eat_hint": true,
    "eat_town_heals": true,
    "eat_run_heals": true
   }
  },
  {
   "do": "bot",
   "bot": "plan_fishing",
   "kwargs": {
    "sections": "rod_slot"
   },
   "name": "rod slot",
   "expect": {
    "rod_slot_empty": true,
    "rod_none_new_char": true,
    "rod_tip_none": true,
    "cast_needs_rod": true,
    "rod_slot_drawn": true,
    "rod_slot_bottom_left": true,
    "rod_tip_name": true,
    "rod_tip_bait": true,
    "rod_tip_upgraded": true
   }
  },
  {
   "do": "shot",
   "name": "rod-slot"
  },
  {
   "do": "log_clean"
  }
 ]
}
