{
 "name": "plan-t8",
 "about": "Test plan, arithmetic checks through the plan_checks bot: gambler reroll (gold, tokens, refusals, legendary), selling wares, the merchant's bag slot, pirate fish traps, a catch with a full bag, silver and ace chests with keys, the X weapon swap.",
 "fixture": "town-tavern",
 "mods": [
   "core",
   "abyss",
   "architect",
   "bufftips",
   "campaign",
   "chatlinks",
   "classes",
   "colors",
   "deathrecap",
   "droptrade",
   "farming",
   "firearms",
   "fishing",
   "gambler",
   "goldpet",
   "groupcombo",
   "keys",
   "laststats",
   "legacy",
   "maps",
   "mercenary",
   "pets",
   "puzzles",
   "specs",
   "stash",
   "strongbox",
   "summons",
   "valuables",
   "wavemode",
   "weapons",
   "weaponswap"
 ],
 "timeout": 900,
 "steps": [
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "show_chat"
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "bot",
   "bot": "plan_checks",
   "kwargs": {
    "sections": "gambler,sell,merchant,traps,full_bag"
   },
   "save_as": "town",
   "name": "town checks",
   "expect": {
    "rare_equipped": true,
    "gambler_open": true,
    "reroll_cost": true,
    "reroll_changed": true,
    "reroll_poor_refused": true,
    "reroll_poor_message": true,
    "reroll_message": true,
    "token_poor_message": true,
    "token_reroll": true,
    "token_poor_refused": true,
    "legendary_refused": true,
    "sell_message": true,
    "sell_fish_tokens": true,
    "sell_crops_gold": true,
    "sell_emptied": true,
    "bag_slot_bought": true,
    "bag_slot_paid": true,
    "bag_slot_price_rises": true,
    "traps_prices": true,
    "traps_fourth_refused": true,
    "traps_listed": true,
    "full_bag_feet": true,
    "full_bag_fish_on_ground": true,
    "bag_slot_full_greyed": true,
    "bag_slot_full_refused": true
   }
  },
  {
   "do": "bot",
   "bot": "plan_checks",
   "kwargs": {
    "sections": "mission,floor_chests,chests,swap,swap_sets"
   },
   "save_as": "run",
   "name": "run checks",
   "expect": {
    "mission_started": true,
    "silver_unlocked": true,
    "ace_legendary_unlocked": true,
    "ace_legendary_given": true,
    "ace_epic_unlocked": true,
    "ace_epic_no_legendary": true,
    "swap_channel_rooted": true,
    "swap_channel_waits": true,
    "swap_empty_hands": true,
    "swap_unrooted_after": true,
    "swap_cancel_key": true,
    "swap_cancel_dodge": true,
    "swap_back_once": true,
    "floor_all_locked": true,
    "floor_no_key_nothing": true,
    "floor_key_opens": true,
    "floor_loot_spawned": true,
    "sword_equipped": true,
    "s1_hands_empty": true,
    "s1_sword_stored": true,
    "s1_tip_shown": true,
    "s1_alt_slot_shows_sword": true,
    "bow_equipped": true,
    "s2_sword_back": true,
    "s2_bow_stored": true,
    "s5_twohander_both_slots": true,
    "s6_r_swaps": true,
    "s6_x_no_longer": true,
    "s6_swapdrop": true,
    "s6_alt_slots_empty": true
   }
  },
  {
   "do": "log_clean"
  }
 ]
}
