{
 "name": "plan-firearms-arm",
 "about": "Through the plan_firearms bot: the gun arm (rifle and pistols) stays raised after a shot and comes down 1 s after the last one, or on a dodge or a reload (Combat.as AimHold); frames of both poses.",
 "fixture": "town-paladin",
 "mods": [
   "core",
   "abyss",
   "architect",
   "bufftips",
   "campaign",
   "chatlinks",
   "classes",
   "colors",
   "deathrecap",
   "droptrade",
   "farming",
   "firearms",
   "fishing",
   "gambler",
   "groupcombo",
   "keys",
   "laststats",
   "legacy",
   "maps",
   "mercenary",
   "pets",
   "puzzles",
   "specs",
   "stash",
   "strongbox",
   "summons",
   "valuables",
   "wavemode",
   "weapons",
   "weaponswap"
 ],
 "timeout": 240,
 "steps": [
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "show_chat"
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "bot",
   "bot": "plan_firearms",
   "kwargs": {
    "sections": "firearms_pistol_arm"
   },
   "name": "gun arm",
   "expect": {
    "rifle_arm_held": true,
    "rifle_arm_lowers_after_1s": true,
    "rifle_arm_lowers_on_dodge": true,
    "rifle_arm_lowers_on_reload": true,
    "pistol_arm_held": true,
    "pistol_arm_lowers_after_1s": true,
    "pistol_arm_lowers_on_dodge": true,
    "pistol_arm_lowers_on_reload": true
   }
  },
  {
   "do": "log_clean"
  }
 ]
}
